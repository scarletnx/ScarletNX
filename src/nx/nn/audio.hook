# The native nn::audio (audio.c), for tools/hookgen, in the language of hle/hook/hooks.hook.
# The audio outs, with no audout:u session: OpenAudioOut and every function that asks the session of the AudioOut it
# opened. The SDK reads an out's rate, channels, sample format and name from the game's AudioOut itself
# (GetAudioOutSampleRate and the like, which stay its own code), so OpenAudioOut fills them: the same layout in every
# SDK read (0.12.16, 3.5.0, 4.4, 6.5.0, 8.2.1, 10.4.0, 13.3, 16.2, 18.3.2, 19.3.3, 20.5), by those accessors' code.
# The AudioOutBuffer's own functions (SetAudioOutBufferInfo, GetAudioOutBufferDataPointer...) need no session either.
# A 32-bit game: the 19 of these functions a 32-bit SDK (0.12.16) has, under the same symbols. The AudioOut's layout
# and the AudioOutBuffer's 0x28 bytes are the same there, so the ones that use the struct are declared again for a
# 32-bit game (a32 hook) and the others marked a32; a volume is a float in s0.
# Each is for that SDK alone (a32 @version), the one 32-bit SDK read: a 32-bit game of another has no hook here
family nn_audio_out
struct nn::audio::AudioOut { u32 sample_rate @0x0; u32 channel_count @0x4; u32 sample_format @0x8; u32 state @0xc; u8 name @0x10 } size 0x110
hook _ZN2nn5audio12OpenAudioOutEPNS0_8AudioOutEPKcRKNS0_17AudioOutParameterE(addr out, addr name, addr params) -> u32 = nnaudio_open_out uses nn::audio::AudioOut
@version(< 1.0.0) a32 hook _ZN2nn5audio12OpenAudioOutEPNS0_8AudioOutEPKcRKNS0_17AudioOutParameterE(addr out, addr name, addr params) -> u32 = nnaudio_open_out uses nn::audio::AudioOut
hook _ZN2nn5audio12OpenAudioOutEPNS0_8AudioOutEPNS_2os11SystemEventEPKcRKNS0_17AudioOutParameterE(addr out, addr event, addr name, addr params) -> u32 = nnaudio_open_out_event uses nn::audio::AudioOut
@version(< 1.0.0) a32 hook _ZN2nn5audio12OpenAudioOutEPNS0_8AudioOutEPNS_2os11SystemEventEPKcRKNS0_17AudioOutParameterE(addr out, addr event, addr name, addr params) -> u32 = nnaudio_open_out_event uses nn::audio::AudioOut
hook _ZN2nn5audio19OpenDefaultAudioOutEPNS0_8AudioOutERKNS0_17AudioOutParameterE(addr out, addr params) -> u32 = nnaudio_open_default_out uses nn::audio::AudioOut
@version(< 1.0.0) a32 hook _ZN2nn5audio19OpenDefaultAudioOutEPNS0_8AudioOutERKNS0_17AudioOutParameterE(addr out, addr params) -> u32 = nnaudio_open_default_out uses nn::audio::AudioOut
hook _ZN2nn5audio19OpenDefaultAudioOutEPNS0_8AudioOutEPNS_2os11SystemEventERKNS0_17AudioOutParameterE(addr out, addr event, addr params) -> u32 = nnaudio_open_default_out_event uses nn::audio::AudioOut
@version(< 1.0.0) a32 hook _ZN2nn5audio19OpenDefaultAudioOutEPNS0_8AudioOutEPNS_2os11SystemEventERKNS0_17AudioOutParameterE(addr out, addr event, addr params) -> u32 = nnaudio_open_default_out_event uses nn::audio::AudioOut
hook _ZN2nn5audio19RegisterBufferEventEPNS0_8AudioOutEPNS_2os11SystemEventE(addr out, addr event) = nnaudio_register_buffer_event a32 @version(< 1.0.0)
hook _ZN2nn5audio13CloseAudioOutEPNS0_8AudioOutE(addr out) = nnaudio_close_out uses nn::audio::AudioOut
@version(< 1.0.0) a32 hook _ZN2nn5audio13CloseAudioOutEPNS0_8AudioOutE(addr out) = nnaudio_close_out uses nn::audio::AudioOut
hook _ZN2nn5audio16GetAudioOutStateEPKNS0_8AudioOutE(addr out) -> u32 = nnaudio_get_out_state uses nn::audio::AudioOut
@version(< 1.0.0) a32 hook _ZN2nn5audio16GetAudioOutStateEPKNS0_8AudioOutE(addr out) -> u32 = nnaudio_get_out_state uses nn::audio::AudioOut
hook _ZN2nn5audio13StartAudioOutEPNS0_8AudioOutE(addr out) -> u32 = nnaudio_start_out a32 @version(< 1.0.0)
hook _ZN2nn5audio12StopAudioOutEPNS0_8AudioOutE(addr out) = nnaudio_stop_out a32 @version(< 1.0.0)
hook _ZN2nn5audio20AppendAudioOutBufferEPNS0_8AudioOutEPNS0_14AudioOutBufferE(addr out, addr buffer) -> bool = nnaudio_append_out_buffer a32 @version(< 1.0.0)
hook _ZN2nn5audio25GetReleasedAudioOutBufferEPNS0_8AudioOutE(addr out) -> addr = nnaudio_get_released_out_buffer a32 @version(< 1.0.0)
hook _ZN2nn5audio22ContainsAudioOutBufferEPKNS0_8AudioOutEPKNS0_14AudioOutBufferE(addr out, addr buffer) -> bool = nnaudio_contains_out_buffer a32 @version(< 1.0.0)
hook _ZN2nn5audio22GetAudioOutBufferCountEPKNS0_8AudioOutE(addr out) -> i32 = nnaudio_get_out_buffer_count
hook _ZN2nn5audio28GetAudioOutPlayedSampleCountEPKNS0_8AudioOutE(addr out) -> i64 = nnaudio_get_out_played_sample_count
hook _ZN2nn5audio20FlushAudioOutBuffersEPNS0_8AudioOutE(addr out) -> bool = nnaudio_flush_out_buffers
hook _ZN2nn5audio17SetAudioOutVolumeEPNS0_8AudioOutEf(addr out, f32 volume) = nnaudio_set_out_volume
hook _ZN2nn5audio17GetAudioOutVolumeEPKNS0_8AudioOutE(addr out) -> f32 = nnaudio_get_out_volume
hook _ZN2nn5audio13ListAudioOutsEPNS0_12AudioOutInfoEi(addr infos, i32 count) -> i32 = nnaudio_list_outs a32 @version(< 1.0.0)

# The audio device, with no IAudioDevice session (audren:u's GetAudioDeviceService): one output device, its volume
# and the events a game acquires for a change of device. Every function is the same call in every SDK read; which
# session command it sends differs (AcquireAudioDeviceNotificationForOutput asks for the system event in SDK 3.5 and
# for the output event from 6.5), and each is an event signaled when the game gets it. The last four are the Ounce
# SDK's
family nn_audio_device
hook _ZN2nn5audio19ListAudioDeviceNameEPNS0_15AudioDeviceNameEi(addr names, i32 count) -> i32 = nnaudio_list_device_names a32 @version(< 1.0.0)
hook _ZN2nn5audio25ListAudioOutputDeviceNameEPNS0_15AudioDeviceNameEi(addr names, i32 count) -> i32 = nnaudio_list_device_names
hook _ZN2nn5audio24GetActiveAudioDeviceNameEPNS0_15AudioDeviceNameE(addr name) = nnaudio_get_active_device_name a32 @version(< 1.0.0)
hook _ZN2nn5audio30GetActiveAudioOutputDeviceNameEPNS0_15AudioDeviceNameE(addr name) = nnaudio_get_active_device_name
hook _ZN2nn5audio41GetActiveAudioDeviceChannelCountForOutputEv() -> i32 = nnaudio_get_active_device_channel_count
# its name up to SDK 10
hook _ZN2nn5audio21GetActiveChannelCountEv() -> i32 = nnaudio_get_active_device_channel_count a32 @version(< 1.0.0)
hook _ZN2nn5audio26SetAudioDeviceOutputVolumeEPKNS0_15AudioDeviceNameEf(addr name, f32 volume) = nnaudio_set_device_output_volume a32 @version(< 1.0.0)
hook _ZN2nn5audio26GetAudioDeviceOutputVolumeEPKNS0_15AudioDeviceNameE(addr name) -> f32 = nnaudio_get_device_output_volume a32 @version(< 1.0.0)
hook _ZN2nn5audio39AcquireAudioDeviceNotificationForOutputEPNS_2os11SystemEventE(addr event) = nnaudio_acquire_device_output_event
hook _ZN2nn5audio38AcquireAudioDeviceNotificationForInputEPNS_2os11SystemEventE(addr event) = nnaudio_acquire_device_input_event
hook _ZN2nn5audio36AcquireAudioDeviceSwitchNotificationEPNS_2os11SystemEventE(addr event) = nnaudio_acquire_device_switch_event a32 @version(< 1.0.0)
hook _ZN2nn5audio40SetDeviceOutputVolumeAutoTuneModeEnabledEb(bool enabled) = nnaudio_set_device_auto_tune
hook _ZN2nn5audio39IsDeviceOutputVolumeAutoTuneModeEnabledEv() -> bool = nnaudio_is_device_auto_tune
hook _ZN2nn5audio36AcquireAudioOutputDeviceNotificationEPNS_2os11SystemEventE(addr event) = nnaudio_acquire_device_notification
hook _ZN2nn5audio35AcquireAudioInputDeviceNotificationEPNS_2os11SystemEventE(addr event) = nnaudio_acquire_device_notification
hook _ZN2nn5audio36ReleaseAudioOutputDeviceNotificationEPNS_2os11SystemEventE(addr event) = nnaudio_release_device_notification
hook _ZN2nn5audio35ReleaseAudioInputDeviceNotificationEPNS_2os11SystemEventE(addr event) = nnaudio_release_device_notification

# What the system asks nn::audio of a game's sound, with no session: the applet manager's calls by a process's
# AppletResourceUserId (audout:a, audin:a, audren:a and aud:a: registering it, suspending and resuming its sound with
# a fade, its volumes) and the debugger's (audout:d, audin:d, audren:d, aud:d, and the DSP's load from auddev). A game
# has no access to those services and calls none of them: each answers success with nothing done, a volume reads 1,
# the DSP's load 0. The names changed at SDK 4 (the suspends lose their SystemEvent), 11 (one call for outs, ins and
# renderers) and 17 (the DSP's statistics); exported by an SDK of every major version read, 1 to 20
family nn_audio_applet
hook _ZN2nn5audio26RequestResumeAudioForDebugENS_6applet20AppletResourceUserIdE(u64 user) -> u32 = nnaudio_applet_user
hook _ZN2nn5audio27RequestSuspendAudioForDebugENS_6applet20AppletResourceUserIdE(u64 user) -> u32 = nnaudio_applet_user
hook _ZN2nn5audio28RegisterAppletResourceUserIdENS_6applet20AppletResourceUserIdE(u64 user) -> u32 = nnaudio_applet_user
hook _ZN2nn5audio29RequestResumeAudioInsForDebugENS_6applet20AppletResourceUserIdE(u64 user) -> u32 = nnaudio_applet_user
hook _ZN2nn5audio30RequestResumeAudioOutsForDebugENS_6applet20AppletResourceUserIdE(u64 user) -> u32 = nnaudio_applet_user
hook _ZN2nn5audio30RequestSuspendAudioInsForDebugENS_6applet20AppletResourceUserIdE(u64 user) -> u32 = nnaudio_applet_user
hook _ZN2nn5audio30UnregisterAppletResourceUserIdENS_6applet20AppletResourceUserIdE(u64 user) -> u32 = nnaudio_applet_user
hook _ZN2nn5audio31RequestSuspendAudioOutsForDebugENS_6applet20AppletResourceUserIdE(u64 user) -> u32 = nnaudio_applet_user
hook _ZN2nn5audio35RequestResumeAudioRenderersForDebugENS_6applet20AppletResourceUserIdE(u64 user) -> u32 = nnaudio_applet_user
hook _ZN2nn5audio36RequestSuspendAudioRenderersForDebugENS_6applet20AppletResourceUserIdE(u64 user) -> u32 = nnaudio_applet_user
hook _ZN2nn5audio18RequestResumeAudioENS_6applet20AppletResourceUserIdENS_8TimeSpanE(u64 user, i64 fade) -> u32 = nnaudio_applet_fade
hook _ZN2nn5audio19RequestSuspendAudioENS_6applet20AppletResourceUserIdENS_8TimeSpanE(u64 user, i64 fade) -> u32 = nnaudio_applet_fade
hook _ZN2nn5audio21RequestResumeAudioInsENS_6applet20AppletResourceUserIdENS_8TimeSpanE(u64 user, i64 fade) -> u32 = nnaudio_applet_fade
hook _ZN2nn5audio22RequestResumeAudioOutsENS_6applet20AppletResourceUserIdENS_8TimeSpanE(u64 user, i64 fade) -> u32 = nnaudio_applet_fade
hook _ZN2nn5audio22RequestSuspendAudioInsENS_6applet20AppletResourceUserIdENS_8TimeSpanE(u64 user, i64 fade) -> u32 = nnaudio_applet_fade
hook _ZN2nn5audio23RequestSuspendAudioOutsENS_6applet20AppletResourceUserIdENS_8TimeSpanE(u64 user, i64 fade) -> u32 = nnaudio_applet_fade
hook _ZN2nn5audio27RequestResumeAudioRenderersENS_6applet20AppletResourceUserIdENS_8TimeSpanE(u64 user, i64 fade) -> u32 = nnaudio_applet_fade
hook _ZN2nn5audio28RequestSuspendAudioRenderersENS_6applet20AppletResourceUserIdENS_8TimeSpanE(u64 user, i64 fade) -> u32 = nnaudio_applet_fade
hook _ZN2nn5audio21RequestResumeAudioInsENS_6applet20AppletResourceUserIdENS_8TimeSpanEPNS_2os15SystemEventTypeE(u64 user, i64 fade, addr event) -> u32 = nnaudio_applet_fade_event
hook _ZN2nn5audio22RequestResumeAudioOutsENS_6applet20AppletResourceUserIdENS_8TimeSpanEPNS_2os15SystemEventTypeE(u64 user, i64 fade, addr event) -> u32 = nnaudio_applet_fade_event
hook _ZN2nn5audio22RequestSuspendAudioInsENS_6applet20AppletResourceUserIdENS_8TimeSpanEPNS_2os15SystemEventTypeE(u64 user, i64 fade, addr event) -> u32 = nnaudio_applet_fade_event
hook _ZN2nn5audio23RequestSuspendAudioOutsENS_6applet20AppletResourceUserIdENS_8TimeSpanEPNS_2os15SystemEventTypeE(u64 user, i64 fade, addr event) -> u32 = nnaudio_applet_fade_event
hook _ZN2nn5audio27RequestResumeAudioRenderersENS_6applet20AppletResourceUserIdENS_8TimeSpanEPNS_2os15SystemEventTypeE(u64 user, i64 fade, addr event) -> u32 = nnaudio_applet_fade_event
hook _ZN2nn5audio28RequestSuspendAudioRenderersENS_6applet20AppletResourceUserIdENS_8TimeSpanEPNS_2os15SystemEventTypeE(u64 user, i64 fade, addr event) -> u32 = nnaudio_applet_fade_event
hook _ZN2nn5audio30GetAudioInsProcessMasterVolumeEPfNS_6applet20AppletResourceUserIdE(addr volume, u64 user) -> u32 = nnaudio_applet_get_volume
hook _ZN2nn5audio31GetAudioOutsProcessMasterVolumeEPfNS_6applet20AppletResourceUserIdE(addr volume, u64 user) -> u32 = nnaudio_applet_get_volume
hook _ZN2nn5audio31GetAudioOutsProcessRecordVolumeEPfNS_6applet20AppletResourceUserIdE(addr volume, u64 user) -> u32 = nnaudio_applet_get_volume
hook _ZN2nn5audio32GetAudioInputProcessMasterVolumeEPfNS_6applet20AppletResourceUserIdE(addr volume, u64 user) -> u32 = nnaudio_applet_get_volume
hook _ZN2nn5audio33GetAudioOutputProcessMasterVolumeEPfNS_6applet20AppletResourceUserIdE(addr volume, u64 user) -> u32 = nnaudio_applet_get_volume
hook _ZN2nn5audio33GetAudioOutputProcessRecordVolumeEPfNS_6applet20AppletResourceUserIdE(addr volume, u64 user) -> u32 = nnaudio_applet_get_volume
hook _ZN2nn5audio36GetAudioRenderersProcessMasterVolumeEPfNS_6applet20AppletResourceUserIdE(addr volume, u64 user) -> u32 = nnaudio_applet_get_volume
hook _ZN2nn5audio36GetAudioRenderersProcessRecordVolumeEPfNS_6applet20AppletResourceUserIdE(addr volume, u64 user) -> u32 = nnaudio_applet_get_volume
hook _ZN2nn5audio30SetAudioInsProcessMasterVolumeENS_6applet20AppletResourceUserIdEfNS_8TimeSpanE(u64 user, f32 volume, i64 fade) -> u32 = nnaudio_applet_set_volume
hook _ZN2nn5audio31SetAudioOutsProcessMasterVolumeENS_6applet20AppletResourceUserIdEfNS_8TimeSpanE(u64 user, f32 volume, i64 fade) -> u32 = nnaudio_applet_set_volume
hook _ZN2nn5audio31SetAudioOutsProcessRecordVolumeENS_6applet20AppletResourceUserIdEfNS_8TimeSpanE(u64 user, f32 volume, i64 fade) -> u32 = nnaudio_applet_set_volume
hook _ZN2nn5audio32SetAudioInputProcessMasterVolumeENS_6applet20AppletResourceUserIdEfNS_8TimeSpanE(u64 user, f32 volume, i64 fade) -> u32 = nnaudio_applet_set_volume
hook _ZN2nn5audio33SetAudioOutputProcessMasterVolumeENS_6applet20AppletResourceUserIdEfNS_8TimeSpanE(u64 user, f32 volume, i64 fade) -> u32 = nnaudio_applet_set_volume
hook _ZN2nn5audio33SetAudioOutputProcessRecordVolumeENS_6applet20AppletResourceUserIdEfNS_8TimeSpanE(u64 user, f32 volume, i64 fade) -> u32 = nnaudio_applet_set_volume
hook _ZN2nn5audio36SetAudioRenderersProcessMasterVolumeENS_6applet20AppletResourceUserIdEfNS_8TimeSpanE(u64 user, f32 volume, i64 fade) -> u32 = nnaudio_applet_set_volume
