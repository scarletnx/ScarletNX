hook _ZN2nn5audio11GetDspUsageEv() -> u32 = nnaudio_get_dsp_usage
hook _ZN2nn5audio16GetDspStatisticsEPNS0_13DspStatisticsE(addr statistics) -> u32 = nnaudio_get_dsp_statistics
hook _ZN2nn5audio23GetAppletStateSummariesEPNS0_18AppletStateSummaryEi(addr summaries, i32 count) -> i32 = nnaudio_get_applet_state_summaries
