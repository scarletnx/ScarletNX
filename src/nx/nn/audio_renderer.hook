#
# The native nn::audio renderer (audio_renderer.c), for tools/hookgen, in the language of hle/hook/hooks.hook.
# The audio renderer, with no audren:u session (audio_renderer.c): OpenAudioRenderer and every function that takes
# the handle it fills. RequestUpdateAudioRenderer runs the SDK's own managers on the game's AudioRendererConfig, whose
# buffers sit at an offset that differs between SDKs, as RequestUpdateAudioRenderer's code reads them. Read in an SDK
# of every major version from 0 to 20 but 2: 0.12.14; 1.3.1; 3.5.0; 4.4.0, 4.4.1, 4.5.0 and 5.4.180; 6.5.0, 7.3.2,
# 8.2.0 and 8.2.1; and 9.3.0 to 20.5.17, which share one. From SDK 6 the config also holds, at 0x40, where the
# rendered frames' count goes. The revision is the AudioRendererParameter's last word, after one more word in SDK 6
# to 8. Before SDK 2 the parameter is the session's own struct, the handle is one word (so an argument after it comes
# one register earlier) and the voices' two sections each have a method; SDK 0 has no splitters. SDK 2 was not read:
# it has no hook, and keeps its own code
family nn_audio_renderer
struct nn::audio::AudioRendererParameter @version(< 2.0.0) { u32 revision @0x30 } size 0x34
struct nn::audio::AudioRendererParameter @version(>= 3.0.0, < 6.0.0) { u32 revision @0x34 } size 0x38
struct nn::audio::AudioRendererParameter @version(>= 6.0.0, < 9.0.0) { u32 revision @0x38 } size 0x3c
struct nn::audio::AudioRendererParameter @version(>= 9.0.0) { u32 revision @0x34 } size 0x38
struct nn::audio::AudioRendererConfig @version(< 1.0.0) { addr in @0x48; u64 in_size @0x50; addr out @0x58; u64 out_size @0x60 } size 0x68
struct nn::audio::AudioRendererConfig @version(>= 1.0.0, < 2.0.0) { addr in @0x50; u64 in_size @0x58; addr out @0x60; u64 out_size @0x68 } size 0x70
struct nn::audio::AudioRendererConfig @version(>= 3.0.0, < 4.0.0) { addr in @0x50; u64 in_size @0x58; addr out @0x60; u64 out_size @0x68 } size 0x70
struct nn::audio::AudioRendererConfig @version(>= 4.0.0, < 6.0.0) { addr in @0x40; u64 in_size @0x48; addr out @0x50; u64 out_size @0x58 } size 0x60
struct nn::audio::AudioRendererConfig @version(>= 6.0.0, < 9.0.0) { addr in @0x50; u64 in_size @0x58; addr out @0x60; u64 out_size @0x68 } size 0x70
struct nn::audio::AudioRendererConfig @version(>= 9.0.0) { addr in @0x48; u64 in_size @0x50; addr out @0x58; u64 out_size @0x60 } size 0x68
@version(< 2.0.0) hook _ZN2nn5audio30GetAudioRendererWorkBufferSizeERKNS0_22AudioRendererParameterE(addr param) -> u64 = nnaudio_get_renderer_work_buffer_size uses nn::audio::AudioRendererParameter
@version(< 2.0.0) hook _ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleERKNS0_22AudioRendererParameterEPvm(addr handle, addr param, addr work, u64 size) -> u32 = nnaudio_open_renderer_word uses nn::audio::AudioRendererParameter
@version(< 2.0.0) hook _ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleEPNS_2os11SystemEventERKNS0_22AudioRendererParameterEPvm(addr handle, addr event, addr param, addr work, u64 size) -> u32 = nnaudio_open_renderer_event_word uses nn::audio::AudioRendererParameter
@version(>= 3.0.0, < 6.0.0) hook _ZN2nn5audio30GetAudioRendererWorkBufferSizeERKNS0_22AudioRendererParameterE(addr param) -> u64 = nnaudio_get_renderer_work_buffer_size uses nn::audio::AudioRendererParameter
@version(>= 3.0.0, < 6.0.0) hook _ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleERKNS0_22AudioRendererParameterEPvm(addr handle, addr param, addr work, u64 size) -> u32 = nnaudio_open_renderer uses nn::audio::AudioRendererParameter
@version(>= 3.0.0, < 6.0.0) hook _ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleEPNS_2os11SystemEventERKNS0_22AudioRendererParameterEPvm(addr handle, addr event, addr param, addr work, u64 size) -> u32 = nnaudio_open_renderer_event uses nn::audio::AudioRendererParameter
@version(>= 6.0.0, < 9.0.0) hook _ZN2nn5audio30GetAudioRendererWorkBufferSizeERKNS0_22AudioRendererParameterE(addr param) -> u64 = nnaudio_get_renderer_work_buffer_size uses nn::audio::AudioRendererParameter
@version(>= 6.0.0, < 9.0.0) hook _ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleERKNS0_22AudioRendererParameterEPvm(addr handle, addr param, addr work, u64 size) -> u32 = nnaudio_open_renderer uses nn::audio::AudioRendererParameter
@version(>= 6.0.0, < 9.0.0) hook _ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleEPNS_2os11SystemEventERKNS0_22AudioRendererParameterEPvm(addr handle, addr event, addr param, addr work, u64 size) -> u32 = nnaudio_open_renderer_event uses nn::audio::AudioRendererParameter
@version(>= 9.0.0) hook _ZN2nn5audio30GetAudioRendererWorkBufferSizeERKNS0_22AudioRendererParameterE(addr param) -> u64 = nnaudio_get_renderer_work_buffer_size uses nn::audio::AudioRendererParameter
@version(>= 9.0.0) hook _ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleERKNS0_22AudioRendererParameterEPvm(addr handle, addr param, addr work, u64 size) -> u32 = nnaudio_open_renderer uses nn::audio::AudioRendererParameter
@version(>= 9.0.0) hook _ZN2nn5audio17OpenAudioRendererEPNS0_19AudioRendererHandleEPNS_2os11SystemEventERKNS0_22AudioRendererParameterEPvm(addr handle, addr event, addr param, addr work, u64 size) -> u32 = nnaudio_open_renderer_event uses nn::audio::AudioRendererParameter
@version(< 1.0.0) hook _ZN2nn5audio26RequestUpdateAudioRendererENS0_19AudioRendererHandleEPKNS0_19AudioRendererConfigE(addr renderer, addr config) -> u32 = nnaudio_request_update_first uses nn::audio::AudioRendererConfig
@version(>= 1.0.0, < 2.0.0) hook _ZN2nn5audio26RequestUpdateAudioRendererENS0_19AudioRendererHandleEPKNS0_19AudioRendererConfigE(addr renderer, addr config) -> u32 = nnaudio_request_update_word uses nn::audio::AudioRendererConfig
@version(>= 3.0.0, < 4.0.0) hook _ZN2nn5audio26RequestUpdateAudioRendererENS0_19AudioRendererHandleEPKNS0_19AudioRendererConfigE(addr renderer, addr context, addr config) -> u32 = nnaudio_request_update uses nn::audio::AudioRendererConfig
@version(>= 4.0.0, < 6.0.0) hook _ZN2nn5audio26RequestUpdateAudioRendererENS0_19AudioRendererHandleEPKNS0_19AudioRendererConfigE(addr renderer, addr context, addr config) -> u32 = nnaudio_request_update uses nn::audio::AudioRendererConfig
@version(>= 6.0.0, < 9.0.0) hook _ZN2nn5audio26RequestUpdateAudioRendererENS0_19AudioRendererHandleEPKNS0_19AudioRendererConfigE(addr renderer, addr context, addr config) -> u32 = nnaudio_request_update_frames uses nn::audio::AudioRendererConfig
@version(>= 9.0.0) hook _ZN2nn5audio26RequestUpdateAudioRendererENS0_19AudioRendererHandleEPKNS0_19AudioRendererConfigE(addr renderer, addr context, addr config) -> u32 = nnaudio_request_update_frames uses nn::audio::AudioRendererConfig
@version(< 2.0.0) hook _ZN2nn5audio34SetAudioRendererRenderingTimeLimitENS0_19AudioRendererHandleEi(addr renderer, i32 percent) = nnaudio_set_renderer_time_limit_word
@version(>= 3.0.0) hook _ZN2nn5audio34SetAudioRendererRenderingTimeLimitENS0_19AudioRendererHandleEi(addr renderer, addr context, i32 percent) = nnaudio_set_renderer_time_limit
