hook _ZN2nn5audio34GetAudioRendererVoiceDropParameterENS0_19AudioRendererHandleE(addr renderer, addr context) -> f32 = nnaudio_get_renderer_voice_drop
hook _ZN2nn5audio29GetAudioRendererExecutionModeENS0_19AudioRendererHandleE(addr renderer, addr context) -> i32 = nnaudio_get_renderer_execution_mode
hook _ZN2nn5audio31GetAudioRendererRenderingDeviceENS0_19AudioRendererHandleE(addr renderer, addr context) -> i32 = nnaudio_get_renderer_rendering_device
