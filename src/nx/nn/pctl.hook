# The native nn::pctl (pctl.c), for tools/hookgen, in the language of hle/hook/hooks.hook.
# nn::pctl: the parental controls of a console with none set, with no pctl session. Initialize is here, so the
# SDK's start makes no session, with every function whose answer is known for no restriction. They hold for a
# 32-bit game too (a32), but the one that fills a struct, whose 32-bit layout was not read: in SDK 0.12.16, the one
# 32-bit SDK read, so for it alone (a32 @version). A 32-bit game of another has no hook here
family nn_pctl
hook _ZN2nn4pctl10InitializeEv() -> u32 = nnpctl_initialize a32 @version(< 1.0.0)
hook _ZN2nn4pctl32CheckFreeCommunicationPermissionEb(bool show_error) -> bool = nnpctl_permitted a32 @version(< 1.0.0)
hook _ZN2nn4pctl25TryBeginFreeCommunicationEb(bool show_error) -> bool = nnpctl_permitted a32 @version(< 1.0.0)
hook _ZN2nn4pctl27CheckStereoVisionPermissionEb(bool show_error) -> bool = nnpctl_permitted a32 @version(< 1.0.0)
hook _ZN2nn4pctl28IsFreeCommunicationAvailableEv() -> bool = nnpctl_yes a32 @version(< 1.0.0)
hook _ZN2nn4pctl23IsStereoVisionPermittedEv() -> bool = nnpctl_yes a32 @version(< 1.0.0)
hook _ZN2nn4pctl20EndFreeCommunicationEv() -> u32 = nnpctl_success a32 @version(< 1.0.0)
hook _ZN2nn4pctl24ConfirmSnsPostPermissionEv() -> u32 = nnpctl_success a32 @version(< 1.0.0)
hook _ZN2nn4pctl20IsRestrictionEnabledEv() -> bool = nnpctl_no a32 @version(< 1.0.0)
hook _ZN2nn4pctl30IsRestrictionTemporaryUnlockedEv() -> bool = nnpctl_no a32 @version(< 1.0.0)
hook _ZN2nn4pctl33IsRestrictedSystemSettingsEnteredEv() -> bool = nnpctl_no a32 @version(< 1.0.0)
hook _ZN2nn4pctl26GetStereoVisionRestrictionEv() -> bool = nnpctl_no a32 @version(< 1.0.0)
hook _ZN2nn4pctl15IsPairingActiveEv() -> bool = nnpctl_no a32 @version(< 1.0.0)
hook _ZN2nn4pctl18IsPlayTimerEnabledEv() -> bool = nnpctl_no a32 @version(< 1.0.0)
hook _ZN2nn4pctl23IsRestrictedByPlayTimerEv() -> bool = nnpctl_no a32 @version(< 1.0.0)
hook _ZN2nn4pctl14GetSafetyLevelEv() -> u32 = nnpctl_none a32 @version(< 1.0.0)
hook _ZN2nn4pctl21GetRestrictedFeaturesEv() -> u32 = nnpctl_none a32 @version(< 1.0.0)
hook _ZN2nn4pctl40GetFreeCommunicationApplicationListCountEv() -> u32 = nnpctl_none a32 @version(< 1.0.0)
hook _ZN2nn4pctl25GetPlayTimerRemainingTimeEv() -> i64 = nnpctl_no_time a32 @version(< 1.0.0)
hook _ZN2nn4pctl36GetPlayTimerRemainingTimeDisplayInfoEPNS0_33PlayTimerRemainingTimeDisplayInfoE(addr info) = nnpctl_play_timer_display_info
