#
# The native nn::pl (pl.c), for tools/hookgen, in the language of nn/hooks.hook.
# nn::pl: the shared fonts, with no pl:u session. These are every function that reaches pl:u but the built-in font
# functions of the first console's types. IsRunningOnOunce is a constant of the SDK's, and the system functions use
# other services.
# A 32-bit game: the functions the 32-bit SDKs read have, the five of 0.12.16 and GetSharedFont too in 4.4.0, read
# there. Four are the same (a32); the list's pointers and sizes are 4 bytes each, and its language code, 8 characters
# by value, is two words of the stack (GetSharedFont's: r3 and one of the stack), and a SharedFontData 12 bytes. Each
# is for the SDKs read alone (a32 @version, a group each): a 32-bit game of another has no hook here
family nn_pl
hook _ZN2nn2pl21RequestSharedFontLoadENS0_14SharedFontTypeE(i32 type) = nnpl_request_shared_font_load a32 @version(< 1.0.0) @version(== 4.4.0)
hook _ZN2nn2pl22GetSharedFontLoadStateENS0_14SharedFontTypeE(i32 type) -> i32 = nnpl_get_shared_font_load_state a32 @version(< 1.0.0) @version(== 4.4.0)
hook _ZN2nn2pl17GetSharedFontSizeENS0_14SharedFontTypeE(i32 type) -> usize = nnpl_get_shared_font_size a32 @version(< 1.0.0) @version(== 4.4.0)
hook _ZN2nn2pl20GetSharedFontAddressENS0_14SharedFontTypeE(i32 type) -> addr = nnpl_get_shared_font_address a32 @version(< 1.0.0) @version(== 4.4.0)
@version(< 1.0.0) @version(== 4.4.0) a32 hook _ZN2nn2pl30GetSharedFontInOrderOfPriorityEPiPNS0_14SharedFontTypeEPPKvPjiNS_8settings12LanguageCodeE(addr count, addr types, addr addresses, addr sizes, i32 max, u32 language, u32 language_end) -> bool = nnpl_get_shared_font_in_order_of_priority_a32
hook _ZN2nn2pl30GetSharedFontInOrderOfPriorityEPiPNS0_14SharedFontTypeEPPKvPmiNS_8settings12LanguageCodeE(addr count, addr types, addr addresses, addr sizes, i32 max, u64 language) -> bool = nnpl_get_shared_font_in_order_of_priority
hook _ZN2nn2pl39GetSharedFontInOrderOfPriorityForSystemEPiPNS0_23SharedFontTypeForSystemEPPKvPmiNS_8settings12LanguageCodeE(addr count, addr types, addr addresses, addr sizes, i32 max, u64 language) -> bool = nnpl_get_shared_font_in_order_of_priority_for_system
hook _ZN2nn2pl13GetSharedFontEPiPNS0_14SharedFontDataEiNS_8settings12LanguageCodeE(addr count, addr data, i32 max, u64 language) -> bool = nnpl_get_shared_font
@version(== 4.4.0) a32 hook _ZN2nn2pl13GetSharedFontEPiPNS0_14SharedFontDataEiNS_8settings12LanguageCodeE(addr count, addr data, i32 max, u32 language, u32 language_end) -> bool = nnpl_get_shared_font_a32
# the Ounce SDK's built-in fonts, which are the shared fonts: one font's flags, address and size, and the same for
# each of a list of types (both read in SDK 19.3)
hook _ZN2nn2pl18GetBuiltInFontDataEPNS0_20BuiltInFontDataOunceENS0_20BuiltInFontTypeOunceEb(addr font, u8 type, bool flag) -> bool = nnpl_get_built_in_font_data
hook _ZN2nn2pl21GetBuiltInFontDataSetEPiPNS0_20BuiltInFontDataOunceEPKNS0_20BuiltInFontTypeOunceEiNS_8settings12LanguageCodeEb(addr count, addr fonts, addr types, i32 n, u64 language, bool flag) -> bool = nnpl_get_built_in_font_data_set
