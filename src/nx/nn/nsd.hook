# The native nn::nsd (nsd.c), for tools/hookgen, in the language of hle/hook/hooks.hook.
# nn::nsd: the names of Nintendo's servers, with no nsd:u session. Resolve and ResolveEx are what games call, and
# nn::oe::GetServerEnvironmentType calls GetApplicationServerEnvironmentType
family nn_nsd
hook _ZN2nn3nsd7ResolveEPNS0_4FqdnERKS1_(addr out, addr in) -> u32 = nnnsd_resolve
hook _ZN2nn3nsd9ResolveExEPNS0_4FqdnERKS1_(addr out, addr in) -> u32 = nnnsd_resolve_ex
hook _ZN2nn3nsd35GetApplicationServerEnvironmentTypeEv() -> u32 = nnnsd_server_environment_type
