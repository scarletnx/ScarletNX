# The native nn::fs (fs.c), for tools/hookgen, in the language of hle/hook/hooks.hook.
# nn::fs: the file system API of the SDK, run natively on the runtime's own back end, with no fsp-srv
# session. A mount that the native layer made answers natively. Every other mount name and every handle that the SDK
# made run the function's own code, so the mount kinds move over one at a time. The functions that take a path or a
# handle are all here, the ones the game does not import too, because a native mount name or handle must never reach
# the SDK's own code.
# A 32-bit game: the 41 of these that a 32-bit SDK (0.12.16) has, each read there, with the same handlers. 22 have the
# same symbol and are marked a32 (a FileHandle or a DirectoryHandle is one pointer, an addr). 19 have a size_t (j) or
# an int64_t (x) in their name, so another symbol, and an a32 hook of their own with a usize where the size_t is.
# Each is for that SDK alone (a32 @version), the one 32-bit SDK read: a 32-bit game of another has no hook here
family nn_fs
hook _ZN2nn2fs8MountRomEPKcPvm(const char* name, addr cache, u64 cache_size) -> u32 = nnfs_mount_rom
@version(< 1.0.0) a32 hook _ZN2nn2fs8MountRomEPKcPvj(const char* name, addr cache, usize cache_size) -> u32 = nnfs_mount_rom
hook _ZN2nn2fs8MountRomEPKc(const char* name) -> u32 = nnfs_mount_rom_name
hook _ZN2nn2fs22QueryMountRomCacheSizeEPm(u64* size) -> u32 = nnfs_query_mount_rom_cache_size
@version(< 1.0.0) a32 hook _ZN2nn2fs22QueryMountRomCacheSizeEPj(u32* size) -> u32 = nnfs_query_mount_rom_cache_size
# the two above for the program of the application at an index, from SDK 8 (read in 8.2 and 19.3, where they run the
# same code as those, with the index given)
hook _ZN2nn2fs8MountRomEPKciPvm(const char* name, i32 program, addr cache, u64 cache_size) -> u32 = nnfs_mount_rom_program
hook _ZN2nn2fs22QueryMountRomCacheSizeEPmi(u64* size, i32 program) -> u32 = nnfs_query_mount_rom_cache_size_program
hook _ZN2nn2fs13MountSaveDataEPKcRKNS_7account3UidE(const char* name, addr uid) -> u32 = nnfs_mount_save_data a32 @version(< 1.0.0)
hook _ZN2nn2fs19MountDeviceSaveDataEPKc(const char* name) -> u32 = nnfs_mount_device_save_data a32 @version(< 1.0.0)
hook _ZN2nn2fs21MountSaveDataReadOnlyEPKcNS_13ApplicationIdERKNS_7account3UidE(const char* name, u64 application, addr uid) -> u32 = nnfs_mount_save_data_read_only
hook _ZN2nn2fs21MountSaveDataReadOnlyEPKcNS_3ncm13ApplicationIdENS0_6UserIdE(const char* name, u64 application, u64 uid_lo, u64 uid_hi) -> u32 = nnfs_mount_save_data_read_only_user
hook _ZN2nn2fs18IsSaveDataExistingENS_13ApplicationIdERKNS_7account3UidE(u64 application, addr uid) -> bool = nnfs_is_save_data_existing
hook _ZN2nn2fs18IsSaveDataExistingERKNS_7account3UidE(addr uid) -> bool = nnfs_is_own_save_data_existing a32 @version(< 1.0.0)
hook _ZN2nn2fs18IsSaveDataExistingEPbNS_13ApplicationIdERKNS_7account3UidE(addr out, u64 application, addr uid) -> u32 = nnfs_is_save_data_existing_result
hook _ZN2nn2fs18IsSaveDataExistingEPbRKNS_7account3UidE(addr out, addr uid) -> u32 = nnfs_is_own_save_data_existing_result
hook _ZN2nn2fs17MountCacheStorageEPKc(const char* name) -> u32 = nnfs_mount_cache_storage
hook _ZN2nn2fs17MountCacheStorageEPKci(const char* name, i32 index) -> u32 = nnfs_mount_cache_storage_index
hook _ZN2nn2fs21MountTemporaryStorageEPKc(const char* name) -> u32 = nnfs_mount_temporary_storage
hook _ZN2nn2fs7UnmountEPKc(const char* name) = nnfs_unmount a32 @version(< 1.0.0)
hook _ZN2nn2fs9IsMountedEPKc(const char* name) -> bool = nnfs_is_mounted
hook _ZN2nn2fs8OpenFileEPNS0_10FileHandleEPKci(addr handle, const char* path, i32 mode) -> u32 = nnfs_open_file a32 @version(< 1.0.0)
hook _ZN2nn2fs9CloseFileENS0_10FileHandleE(addr h) = nnfs_close_file a32 @version(< 1.0.0)
hook _ZN2nn2fs8ReadFileEPmNS0_10FileHandleElPvm(u64* read, u64 h, i64 offset, addr buffer, u64 size) -> u32 = nnfs_read_file
@version(< 1.0.0) a32 hook _ZN2nn2fs8ReadFileEPjNS0_10FileHandleExPvj(u32* read, addr h, i64 offset, addr buffer, usize size) -> u32 = nnfs_read_file
hook _ZN2nn2fs8ReadFileEPmNS0_10FileHandleElPvmRKNS0_10ReadOptionE(u64* read, u64 h, i64 offset, addr buffer, u64 size, addr option) -> u32 = nnfs_read_file_option
@version(< 1.0.0) a32 hook _ZN2nn2fs8ReadFileEPjNS0_10FileHandleExPvjRKNS0_10ReadOptionE(u32* read, addr h, i64 offset, addr buffer, usize size, addr option) -> u32 = nnfs_read_file_option
hook _ZN2nn2fs8ReadFileENS0_10FileHandleElPvm(u64 h, i64 offset, addr buffer, u64 size) -> u32 = nnfs_read_file_exact
@version(< 1.0.0) a32 hook _ZN2nn2fs8ReadFileENS0_10FileHandleExPvj(addr h, i64 offset, addr buffer, usize size) -> u32 = nnfs_read_file_exact
hook _ZN2nn2fs8ReadFileENS0_10FileHandleElPvmRKNS0_10ReadOptionE(u64 h, i64 offset, addr buffer, u64 size, addr option) -> u32 = nnfs_read_file_exact_option
@version(< 1.0.0) a32 hook _ZN2nn2fs8ReadFileENS0_10FileHandleExPvjRKNS0_10ReadOptionE(addr h, i64 offset, addr buffer, usize size, addr option) -> u32 = nnfs_read_file_exact_option
hook _ZN2nn2fs9WriteFileENS0_10FileHandleElPKvmRKNS0_11WriteOptionE(u64 h, i64 offset, addr buffer, u64 size, addr option) -> u32 = nnfs_write_file
@version(< 1.0.0) a32 hook _ZN2nn2fs9WriteFileENS0_10FileHandleExPKvjRKNS0_11WriteOptionE(addr h, i64 offset, addr buffer, usize size, addr option) -> u32 = nnfs_write_file
hook _ZN2nn2fs9FlushFileENS0_10FileHandleE(addr h) -> u32 = nnfs_flush_file a32 @version(< 1.0.0)
hook _ZN2nn2fs11SetFileSizeENS0_10FileHandleEl(u64 h, i64 size) -> u32 = nnfs_set_file_size
@version(< 1.0.0) a32 hook _ZN2nn2fs11SetFileSizeENS0_10FileHandleEx(addr h, i64 size) -> u32 = nnfs_set_file_size
hook _ZN2nn2fs11GetFileSizeEPlNS0_10FileHandleE(i64* size, u64 h) -> u32 = nnfs_get_file_size
@version(< 1.0.0) a32 hook _ZN2nn2fs11GetFileSizeEPxNS0_10FileHandleE(i64* size, addr h) -> u32 = nnfs_get_file_size
hook _ZN2nn2fs15GetFileOpenModeENS0_10FileHandleE(addr h) -> i32 = nnfs_get_file_open_mode a32 @version(< 1.0.0)
hook _ZN2nn2fs10QueryRangeEPNS0_14QueryRangeInfoENS0_10FileHandleEll(addr info, u64 h, i64 offset, i64 size) -> u32 = nnfs_query_range
hook _ZN2nn2fs15InvalidateCacheENS0_10FileHandleE(u64 h) -> u32 = nnfs_invalidate_cache
hook _ZN2nn2fs14MountRomOnFileEPKcNS0_10FileHandleEPvm(const char* name, u64 h, addr cache, u64 cache_size) -> u32 = nnfs_mount_rom_on_file
hook _ZN2nn2fs28QueryMountRomOnFileCacheSizeEPmNS0_10FileHandleE(u64* size, u64 h) -> u32 = nnfs_query_mount_rom_on_file_cache_size
hook _ZN2nn2fs20QueryUnpreparedRangeEPNS0_5RangeENS0_10FileHandleE(addr range, u64 h) -> u32 = nnfs_query_unprepared_range
hook _ZN2nn2fs26QueryUnpreparedRangeDetailEPNS0_19UnpreparedRangeInfoENS0_10FileHandleE(addr info, u64 h) -> u32 = nnfs_query_unprepared_range_detail
hook _ZN2nn2fs27QueryLazyLoadCompletionRateEPiNS0_10FileHandleEi(i32* rate, u64 h, i32 unknown) -> u32 = nnfs_query_lazy_load_completion_rate
hook _ZN2nn2fs33ReadyLazyLoadFileForciblyForDebugENS0_10FileHandleEll(u64 h, i64 offset, i64 size) -> u32 = nnfs_ready_lazy_load_file
hook _ZN2nn2fs13OpenDirectoryEPNS0_15DirectoryHandleEPKci(addr handle, const char* path, i32 mode) -> u32 = nnfs_open_directory a32 @version(< 1.0.0)
hook _ZN2nn2fs13ReadDirectoryEPlPNS0_14DirectoryEntryENS0_15DirectoryHandleEl(i64* count, addr entries, u64 h, i64 max) -> u32 = nnfs_read_directory
@version(< 1.0.0) a32 hook _ZN2nn2fs13ReadDirectoryEPxPNS0_14DirectoryEntryENS0_15DirectoryHandleEx(i64* count, addr entries, addr h, i64 max) -> u32 = nnfs_read_directory
hook _ZN2nn2fs22GetDirectoryEntryCountEPlNS0_15DirectoryHandleE(i64* count, u64 h) -> u32 = nnfs_get_directory_entry_count
@version(< 1.0.0) a32 hook _ZN2nn2fs22GetDirectoryEntryCountEPxNS0_15DirectoryHandleE(i64* count, addr h) -> u32 = nnfs_get_directory_entry_count
hook _ZN2nn2fs14CloseDirectoryENS0_15DirectoryHandleE(addr h) = nnfs_close_directory a32 @version(< 1.0.0)
hook _ZN2nn2fs12GetEntryTypeEPNS0_18DirectoryEntryTypeEPKc(addr type, const char* path) -> u32 = nnfs_get_entry_type a32 @version(< 1.0.0)
hook _ZN2nn2fs10CreateFileEPKcl(const char* path, i64 size) -> u32 = nnfs_create_file
@version(< 1.0.0) a32 hook _ZN2nn2fs10CreateFileEPKcx(const char* path, i64 size) -> u32 = nnfs_create_file
hook _ZN2nn2fs10CreateFileEPKcli(const char* path, i64 size, i32 option) -> u32 = nnfs_create_file_option
@version(< 1.0.0) a32 hook _ZN2nn2fs10CreateFileEPKcxi(const char* path, i64 size, i32 option) -> u32 = nnfs_create_file_option
hook _ZN2nn2fs10DeleteFileEPKc(const char* path) -> u32 = nnfs_delete_file a32 @version(< 1.0.0)
hook _ZN2nn2fs15CreateDirectoryEPKc(const char* path) -> u32 = nnfs_create_directory a32 @version(< 1.0.0)
hook _ZN2nn2fs15DeleteDirectoryEPKc(const char* path) -> u32 = nnfs_delete_directory a32 @version(< 1.0.0)
hook _ZN2nn2fs26DeleteDirectoryRecursivelyEPKc(const char* path) -> u32 = nnfs_delete_directory_recursively a32 @version(< 1.0.0)
hook _ZN2nn2fs25CleanDirectoryRecursivelyEPKc(const char* path) -> u32 = nnfs_clean_directory_recursively
