hook _ZN2nn2fs15RenameDirectoryEPKcS2_(const char* from, const char* to) -> u32 = nnfs_rename_directory a32 @version(< 1.0.0)
hook _ZN2nn2fs16GetFreeSpaceSizeEPlPKc(i64* size, const char* path) -> u32 = nnfs_get_free_space_size
@version(< 1.0.0) a32 hook _ZN2nn2fs16GetFreeSpaceSizeEPxPKc(i64* size, const char* path) -> u32 = nnfs_get_free_space_size
hook _ZN2nn2fs17GetTotalSpaceSizeEPlPKc(i64* size, const char* path) -> u32 = nnfs_get_total_space_size
@version(< 1.0.0) a32 hook _ZN2nn2fs17GetTotalSpaceSizeEPxPKc(i64* size, const char* path) -> u32 = nnfs_get_total_space_size
# a file's time stamps, which take a path: a native mount's must not reach the SDK's code, whose table has no such
# mount. No 32-bit SDK read has them
hook _ZN2nn2fs24GetFileTimeStampForDebugEPNS0_13FileTimeStampEPKc(addr stamp, const char* path) -> u32 = nnfs_get_file_time_stamp
hook _ZN2nn2fs27GetFileTimeStampRawForDebugEPNS0_16FileTimeStampRawEPKc(addr stamp, const char* path) -> u32 = nnfs_get_file_time_stamp_raw
# a file's data cache, which takes a path (SDK 6 on; read in 6.5, 7.3, 11.4, 16.2 and 20.5). No 32-bit SDK has it
hook _ZN2nn2fs29EnableIndividualFileDataCacheEPKcPvm(const char* path, addr buffer, u64 size) -> u32 = nnfs_enable_individual_file_data_cache
hook _ZN2nn2fs30DisableIndividualFileDataCacheEPKc(const char* path) = nnfs_disable_individual_file_data_cache
# what the SDK's C library asks of a path before it opens it (SDK 16 on; read in 16.2, 18.3, 19.3 and 20.5)
hook _ZN2nn2fs13IsPathMountedEPKc(const char* path) -> bool = nnfs_is_path_mounted
hook _ZN2nn2fs16GetPathLengthMaxEPmPKc(u64* out, const char* path) -> u32 = nnfs_get_path_length_max
hook _ZN2nn2fs21GetEntryNameLengthMaxEPmPKc(u64* out, const char* path) -> u32 = nnfs_get_entry_name_length_max
hook _ZN2nn2fs21GetUtf16PathLengthMaxEPbPmPKc(bool* has, u64* out, const char* path) -> u32 = nnfs_get_utf16_path_length_max
hook _ZN2nn2fs26GetUtf16EntryNameLengthMaxEPbPmPKc(bool* has, u64* out, const char* path) -> u32 = nnfs_get_utf16_entry_name_length_max
hook _ZN2nn2fs6CommitEPKc(const char* name) -> u32 = nnfs_commit
hook _ZN2nn2fs6CommitEPKcRKNS0_12CommitOptionE(const char* name, addr option) -> u32 = nnfs_commit_option
# several mounts at once, from SDK 6 (read in 13.3 and 20.5)
hook _ZN2nn2fs6CommitEPKPKci(addr names, i32 count) -> u32 = nnfs_commit_names
hook _ZN2nn2fs14CommitSaveDataEPKc(const char* name) -> u32 = nnfs_commit_save_data a32 @version(< 1.0.0)
hook _ZN2nn2fs17MountAddOnContentEPKciPvm(const char* name, i32 index, addr cache, u64 cache_size) -> u32 = nnfs_mount_add_on_content
@version(< 1.0.0) a32 hook _ZN2nn2fs17MountAddOnContentEPKciPvj(const char* name, i32 index, addr cache, usize cache_size) -> u32 = nnfs_mount_add_on_content
hook _ZN2nn2fs31QueryMountAddOnContentCacheSizeEPmi(u64* size, i32 index) -> u32 = nnfs_query_mount_add_on_content_cache_size
@version(< 1.0.0) a32 hook _ZN2nn2fs31QueryMountAddOnContentCacheSizeEPji(u32* size, i32 index) -> u32 = nnfs_query_mount_add_on_content_cache_size
hook _ZN2nn2fs15MountSystemDataEPKcNS_3ncm12SystemDataIdEPvm(const char* name, u64 id, addr cache, u64 cache_size) -> u32 = nnfs_mount_system_data
@version(< 1.0.0) a32 hook _ZN2nn2fs15MountSystemDataEPKcNS_3ncm12SystemDataIdEPvj(const char* name, u64 id, addr cache, usize cache_size) -> u32 = nnfs_mount_system_data
hook _ZN2nn2fs29QueryMountSystemDataCacheSizeEPmNS_3ncm12SystemDataIdE(u64* size, u64 id) -> u32 = nnfs_query_mount_system_data_cache_size
@version(< 1.0.0) a32 hook _ZN2nn2fs29QueryMountSystemDataCacheSizeEPjNS_3ncm12SystemDataIdE(u32* size, u64 id) -> u32 = nnfs_query_mount_system_data_cache_size
hook _ZN2nn2fs14EnsureSaveDataERKNS_7account3UidE(addr uid) -> u32 = nnfs_ensure_save_data a32 @version(< 1.0.0)
hook _ZN2nn2fs14ExtendSaveDataERKNS_7account3UidEll(addr uid, i64 size, i64 journal_size) -> u32 = nnfs_extend_save_data
hook _ZN2nn2fs15GetSaveDataSizeEPlS1_RKNS_7account3UidE(i64* size, i64* journal_size, addr uid) -> u32 = nnfs_get_save_data_size
# a mounted save's Restore flag, which takes a mount name (SDK 10.4 on; read in 10.4, 15.3 and 20.5). No 32-bit SDK read has it
hook _ZN2nn2fs22GetSaveDataRestoreFlagEPbPKc(bool* out, const char* name) -> u32 = nnfs_get_save_data_restore_flag
hook _ZN2nn2fs18CreateCacheStorageEill(i32 index, i64 size, i64 journal_size) -> u32 = nnfs_create_cache_storage
hook _ZN2nn2fs18DeleteCacheStorageEi(i32 index) -> u32 = nnfs_delete_cache_storage
hook _ZN2nn2fs19GetCacheStorageSizeEPlS1_i(i64* size, i64* journal_size, i32 index) -> u32 = nnfs_get_cache_storage_size
hook _ZN2nn2fs20OpenCacheStorageListEPNS0_22CacheStorageListHandleE(addr handle) -> u32 = nnfs_open_cache_storage_list
hook _ZN2nn2fs20ReadCacheStorageListEPiPNS0_16CacheStorageInfoENS0_22CacheStorageListHandleEi(i32* count, addr infos, u64 h, i32 max) -> u32 = nnfs_read_cache_storage_list
hook _ZN2nn2fs21CloseCacheStorageListENS0_22CacheStorageListHandleE(u64 h) = nnfs_close_cache_storage_list
hook _ZN2nn2fs6detail18IsEnabledAccessLogEv() -> bool = nnfs_is_enabled_access_log a32 @version(< 1.0.0)
hook _ZN2nn2fs6detail18IsEnabledAccessLogEj(u32 mask) -> bool = nnfs_is_enabled_access_log_mask
hook _ZN2nn2fs16IsSdCardInsertedEv() -> bool = nnfs_is_sd_card_inserted a32 @version(< 1.0.0)
hook _ZN2nn2fs11MountSdCardEPKc(const char* name) -> u32 = nnfs_mount_sd_card a32 @version(< 1.0.0)
hook _ZN2nn2fs13MountHostRootEv() -> u32 = nnfs_mount_host_root a32 @version(< 1.0.0)
hook _ZN2nn2fs13MountHostRootERKNS0_15MountHostOptionE(addr option) -> u32 = nnfs_mount_host_root_option
# MountHost opens a folder of the host PC, through the same service command as the root: refused the same way. The
# form with an option is in the SDKs from 10.4 and the system's from 18.3, of the ones read. UnmountHostRoot needs no
# hook: it ends in Unmount, here or in the SDK's own table, where no native mount has its name. Nor do
# SetLocalAccessLog and SetResultHandledByApplication, each one byte stored in a global of the SDK's (read in SDK
# 0.12.16, 3.5, 10.4 and 20.5)
hook _ZN2nn2fs9MountHostEPKcS2_(const char* name, const char* path) -> u32 = nnfs_mount_host a32 @version(< 1.0.0)
hook _ZN2nn2fs9MountHostEPKcS2_RKNS0_15MountHostOptionE(const char* name, const char* path, addr option) -> u32 = nnfs_mount_host_option
hook _ZN2nn2fs18MountHostForSystemEPKcS2_(const char* name, const char* path) -> u32 = nnfs_mount_host
