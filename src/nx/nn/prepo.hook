#
# The native nn::prepo (prepo.c), for tools/hookgen, in the language of hle/hook/hooks.hook.
# nn::prepo: the play reports, with no prepo:u session. The report is built in the game's buffer by the SDK's own
# code. Save, Send, AddSessionId, RequestImmediateTransmission and GetTransmissionStatus are what a game has reach the
# service. The report's layout and Save's limit are those of the SDKs read: no limit in 3.5.0 to 8.2.1, the limit from
# 9.3.1, the buffer at 0x20 through 14.3.0 and at 0x28 from 15.3.2. Read in 3.5, 4.4, 6.5, 7.7, 8.2, 9.3, 10.4, 12.3,
# 13.3, 14.3, 15.3, 16.2, 18.3, 19.3 and 20.5: Save is the same code from 9.3 on, 14.3's as 12.3's and 15.3's as 16.2's
family nn_prepo
struct nn::prepo::PlayReport @version(< 15.0.0) { addr buffer @0x20; u64 capacity @0x28; u64 used @0x30 } size 0x38
struct nn::prepo::PlayReport @version(>= 15.0.0) { addr buffer @0x28; u64 capacity @0x30; u64 used @0x38 } size 0x40
@version(< 9.0.0) hook _ZN2nn5prepo10PlayReport4SaveEv(addr report) -> u32 = nnprepo_save_unlimited uses nn::prepo::PlayReport
@version(>= 9.0.0) hook _ZN2nn5prepo10PlayReport4SaveEv(addr report) -> u32 = nnprepo_save uses nn::prepo::PlayReport
@version(< 9.0.0) hook _ZN2nn5prepo10PlayReport4SaveERKNS_7account3UidE(addr report, addr uid) -> u32 = nnprepo_save_user_unlimited uses nn::prepo::PlayReport
@version(>= 9.0.0) hook _ZN2nn5prepo10PlayReport4SaveERKNS_7account3UidE(addr report, addr uid) -> u32 = nnprepo_save_user uses nn::prepo::PlayReport
# Send, the report sent at once, which the SDK has from 16: its AsyncContext, which the caller passes in x8, is the
# SDK's own finished one. Read in SDK 16.2, 18.3, 19.3 and 20.5; no older SDK of the dumps here exports it
struct nn::prepo::AsyncContext @version(>= 16.0.0) { addr object @0x0; u32 result @0x8 } size 0x10
@version(>= 16.0.0) hook _ZN2nn5prepo10PlayReport4SendERKNS_7account3UidE(addr report, addr uid) = nnprepo_send uses nn::prepo::PlayReport, nn::prepo::AsyncContext
# AddSessionId, which asks the session for the system's session id and adds the report's own id under the key. Read in
# SDK 10.4, 12.3, 13.3, 14.3, 16.2, 18.3, 19.3 and 20.5, each alike; no older SDK of the dumps here exports it
@version(>= 10.0.0) hook _ZN2nn5prepo12AddSessionIdEPNS0_10PlayReportEPKc(addr report, addr key) -> u32 = nnprepo_add_session_id
hook _ZN2nn5prepo28RequestImmediateTransmissionEv() -> u32 = nnprepo_request_immediate_transmission a32 @version(< 1.0.0)
hook _ZN2nn5prepo21GetTransmissionStatusEPNS0_18TransmissionStatusE(addr status) -> u32 = nnprepo_get_transmission_status a32 @version(< 1.0.0)
# what nn::prepo::Initialize and the library's first use end in: the session's start, and its end
hook _ZN2nn5prepo6detail3ipc10InitializeEv() = nnprepo_ipc_initialize a32 @version(< 1.0.0)
hook _ZN2nn5prepo6detail3ipc8FinalizeEv() = nnprepo_ipc_finalize a32 @version(< 1.0.0)
# A 32-bit game: its SDK's report has the same fields, 4 bytes each, and Save has no limit there. Read in SDK
# 0.12.16, the one 32-bit SDK of the dumps here, so every declaration is for that SDK alone: a game of another has
# no hook, and stops in sm with prepo:u's name
struct nn::prepo::PlayReport32 @version(< 1.0.0) { u32 buffer @0x20; u32 capacity @0x24; u32 used @0x28 } size 0x2c
@version(< 1.0.0) a32 hook _ZN2nn5prepo10PlayReport4SaveEv(addr report) -> u32 = nnprepo_save32 uses nn::prepo::PlayReport32
@version(< 1.0.0) a32 hook _ZN2nn5prepo10PlayReport4SaveERKNS_7account3UidE(addr report, addr uid) -> u32 = nnprepo_save_user32 uses nn::prepo::PlayReport32
