#
# The NVN functions the runtime implements under nvn_direct (gpu/nvn/nvn_direct.c), for tools/hookgen with
# --prefix nvn: hooks.hook's grammar, each function by the name the game resolves it by (nvnBootstrapLoader and
# nvnDeviceGetProcAddress), with its arguments as src/nx/gpu/nvn/nvn.h declares them (a pointer is an addr, an enum
# an i32, an NVNboolean a bool) and its handler: the function's name with a '_' after nvn (nvn_DeviceFinalize) unless
# '= HANDLER' names another. A family per NVN object. A function the game resolves that isn't here stops the game with
# its name when it is called. The handlers: gpu/nvn/nvn_object.c (device, pools, buffers, textures, samplers,
# programs, syncs, state objects), nvn_cmd.c (command buffers) and nvn_queue.c (queue, window).

# The resolvers, which nvn_direct.c and nvn_trace.c wrap with C of their own: the recompiler calls them through their
# dispatch slots, as it calls a hooked function (hookgen's route lines)
route nvnBootstrapLoader
route nvnDeviceGetProcAddress

