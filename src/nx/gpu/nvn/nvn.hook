# The NVN functions the runtime implements under nvn_direct (gpu/nvn/nvn_direct.c), for tools/hookgen with
# --prefix nvn: hooks.hook's grammar, each function by the name the game resolves it by (nvnBootstrapLoader and
# nvnDeviceGetProcAddress), with its arguments as src/nx/gpu/nvn/nvn.h declares them (a pointer is an addr, an enum
# an i32, an NVNboolean a bool) and its handler. A family per NVN object. A function the game resolves that isn't
# here stops the game with its name when it is called. The handlers: gpu/nvn/nvn_object.c (device, pools, buffers,
# textures, samplers, programs, syncs, state objects), nvn_cmd.c (command buffers) and nvn_queue.c (queue, window).

family device
hook nvnDeviceBuilderSetDefaults(addr b) = nvn_DeviceBuilderSetDefaults
hook nvnDeviceBuilderSetFlags(addr b, i32 flags) = nvn_DeviceBuilderSetFlags
hook nvnDeviceGetImageHandle(addr d, i32 id) -> u64 = nvn_DeviceGetImageHandle
hook nvnDeviceGetInteger(addr d, i32 what, addr out) = nvn_DeviceGetInteger
hook nvnDeviceGetSeparateSamplerHandle(addr d, i32 id) -> u64 = nvn_DeviceGetSeparateSamplerHandle
hook nvnDeviceGetTextureHandle(addr d, i32 texture, i32 sampler) -> u64 = nvn_DeviceGetTextureHandle
hook nvnDeviceGetTimestampInNanoseconds(addr d, addr counter) -> u64 = nvn_DeviceGetTimestampInNanoseconds
hook nvnDeviceInitialize(addr d, addr b) -> bool = nvn_DeviceInitialize
hook nvnDeviceRegisterFastClearColor(addr d, addr color, i32 format) -> bool = nvn_DeviceRegisterFastClearColor
hook nvnDeviceRegisterFastClearDepth(addr d, f32 depth) -> bool = nvn_DeviceRegisterFastClearDepth
hook nvnDeviceSetDepthMode(addr d, i32 mode) = nvn_DeviceSetDepthMode
hook nvnDeviceSetWindowOriginMode(addr d, i32 mode) = nvn_DeviceSetWindowOriginMode

family memory_pool
hook nvnMemoryPoolBuilderSetDefaults(addr b) = nvn_MemoryPoolBuilderSetDefaults
hook nvnMemoryPoolBuilderSetDevice(addr b, addr d) = nvn_MemoryPoolBuilderSetDevice
hook nvnMemoryPoolBuilderSetFlags(addr b, i32 flags) = nvn_MemoryPoolBuilderSetFlags
hook nvnMemoryPoolBuilderSetStorage(addr b, addr memory, u64 size) = nvn_MemoryPoolBuilderSetStorage
hook nvnMemoryPoolFinalize(addr p) = nvn_MemoryPoolFinalize
hook nvnMemoryPoolFlushMappedRange(addr p, i64 offset, u64 size) = nvn_MemoryPoolFlushMappedRange
hook nvnMemoryPoolGetBufferAddress(addr p) -> u64 = nvn_MemoryPoolGetBufferAddress
hook nvnMemoryPoolGetFlags(addr p) -> i32 = nvn_MemoryPoolGetFlags
hook nvnMemoryPoolGetSize(addr p) -> u64 = nvn_MemoryPoolGetSize
hook nvnMemoryPoolInitialize(addr p, addr b) -> bool = nvn_MemoryPoolInitialize
hook nvnMemoryPoolMap(addr p) -> addr = nvn_MemoryPoolMap

family buffer
hook nvnBufferBuilderSetDefaults(addr b) = nvn_BufferBuilderSetDefaults
hook nvnBufferBuilderSetDevice(addr b, addr d) = nvn_BufferBuilderSetDevice
hook nvnBufferBuilderSetStorage(addr b, addr pool, i64 offset, u64 size) = nvn_BufferBuilderSetStorage
hook nvnBufferFinalize(addr buf) = nvn_BufferFinalize
hook nvnBufferFlushMappedRange(addr buf, i64 offset, u64 size) = nvn_BufferFlushMappedRange
hook nvnBufferGetAddress(addr buf) -> u64 = nvn_BufferGetAddress
hook nvnBufferGetMemoryOffset(addr buf) -> i64 = nvn_BufferGetMemoryOffset
hook nvnBufferGetMemoryPool(addr buf) -> addr = nvn_BufferGetMemoryPool
hook nvnBufferGetSize(addr buf) -> u64 = nvn_BufferGetSize
hook nvnBufferInitialize(addr buf, addr b) -> bool = nvn_BufferInitialize
hook nvnBufferMap(addr buf) -> addr = nvn_BufferMap

