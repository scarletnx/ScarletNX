#
# The NVN functions of NVN2, the Switch 2 SDK's NVN (gpu/nvn/nvn_loader.c), for tools/hookgen with --prefix nvn2.
# A second spec beside gpu/nvn/nvn.hook's, and separate from it for a reason: nvn.hook's declarations were measured
# against seven games' NVN drivers of SDK 5.4 to 20.5, whose API versions the nvn version key holds (53.5, 53.13,
# 53.105, 53.209, 53.311 to 53.314, 55.8 to 55.15). A Switch 2 title resolves NVN API 231.16, a generation the
# runtime has measured nothing for, and the functions it resolves that Switch 1's driver has no name for are NVN2's
# own: they belong here, where a declaration can't be selected by a 53.x game's version at all (a game's driver
# never resolves a name it doesn't have). A function whose layout NVN2 shares with Switch 1's stays in nvn.hook,
# whose @version(nvn ...) ranges the runtime extends as it measures it. The handlers are the same C files as
# nvn.hook's (gpu/nvn/nvn_object.c, nvn_cmd.c, nvn_queue.c): only the declarations are separate.
include "nx/gpu/nvn/nvn.h"

family queue
hook nvnQueueBuilderSetPrimaryQueue(NVNqueueBuilder* b, NVNqueue* q)

family command_buffer

family device
hook nvnDeviceGetFlags(const NVNdevice* d) -> u32

hook nvnQueueBuilderGetPrimaryQueue(const NVNqueueBuilder* b) -> NVNqueue*
hook nvnQueueBuilderSetRayTracingMemorySize(NVNqueueBuilder* b, usize size)
hook nvnQueueBuilderGetRayTracingMemorySize(const NVNqueueBuilder* b) -> usize
hook nvnQueueGetTotalRayTracingMemoryUsed(const NVNqueue* q) -> usize

family program_builder
hook nvnProgramBuilderGetRayTracingModuleCount(const NVNprogramBuilder* b) -> i32
hook nvnProgramBuilderGetRayTracingModuleData(const NVNprogramBuilder* b, void* data) -> usize

hook nvnCommandBufferEnableExclusiveScissor(NVNcommandBuffer* cb, i32 index)
hook nvnCommandBufferSetExclusiveScissor(NVNcommandBuffer* cb, i32 index, i32 x, i32 y, i32 w, i32 h)
hook nvnCommandBufferSetExclusiveScissors(NVNcommandBuffer* cb, i32 first, i32 n, const NVNrectangle* rects)
hook nvnCommandBufferSetRepresentativeFragmentTest(NVNcommandBuffer* cb, i32 mode)
hook nvnCommandBufferSetFloatBlendClamp(NVNcommandBuffer* cb, f32 clamp)
hook nvnCommandBufferSetConservativeRasterMode(NVNcommandBuffer* cb, i32 mode)
hook nvnCommandBufferSetResourceOccupancy(NVNcommandBuffer* cb, i32 mode)
hook nvnCommandBufferSetGraphicsWorkloadPriority(NVNcommandBuffer* cb, i32 priority)
hook nvnCommandBufferSetComputeWorkloadPriority(NVNcommandBuffer* cb, i32 priority)
hook nvnCommandBufferSetComputeEnable(NVNcommandBuffer* cb, i32 enable)
hook nvnCommandBufferSetCopyEnable(NVNcommandBuffer* cb, i32 enable)
