/* ASTC decoding as a compute shader, one invocation per 128 bit block. Eden's decoder reads the blocks in
   block-linear order and stores floats into an image; here texture.c has already deswizzled them into rows of
   blocks, and the texels go out as packed RGBA8 words (R in the low byte) in rows of width words, which
   vk/astc.c copies into a UNORM or SRGB image. The byte conversions are integer arithmetic so that the CPU
   reference (astc.c) produces the same bytes. */

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint width;   /* texels in a row of the output */
    uint height;  /* rows of texels in this strip */
    uvec2 block_dims;
    uint srgb;    /* nonzero: the specification's sRGB decode mode for R, G and B, for SRGB images */
};

layout(binding = 0, std430) readonly restrict buffer InputBlocks {
    uvec4 astc_data[];
};

layout(binding = 1, std430) writeonly restrict buffer OutputTexels {
    uint texels[];
};

const uint JUST_BITS = 0u;
const uint QUINT = 1u;
const uint TRIT = 2u;

/* the integer sequence encodings, in ascending order of their bit length (GetBitLength) */
const uint encoding_values[22] = uint[](
    (JUST_BITS), (JUST_BITS | (1u << 8u)), (TRIT), (JUST_BITS | (2u << 8u)),
    (QUINT), (TRIT | (1u << 8u)), (JUST_BITS | (3u << 8u)), (QUINT | (1u << 8u)),
    (TRIT | (2u << 8u)), (JUST_BITS | (4u << 8u)), (QUINT | (2u << 8u)), (TRIT | (3u << 8u)),
    (JUST_BITS | (5u << 8u)), (QUINT | (3u << 8u)), (TRIT | (4u << 8u)), (JUST_BITS | (6u << 8u)),
    (QUINT | (4u << 8u)), (TRIT | (5u << 8u)), (JUST_BITS | (7u << 8u)), (QUINT | (5u << 8u)),
    (TRIT | (6u << 8u)), (JUST_BITS | (8u << 8u)));

/* the block and the read position in it */
int total_bitsread = 0;
uvec4 local_buff;

/* the color endpoint bits, then the bit-reversed weight bits, and the read position in them */
uvec4 color_endpoint_data = uvec4(0);
int color_bitsread = 0;

#define MAX_WEIGHT_VALUES 64
/* integer sequence values: encoding (bits 0-7), bit count (8-15), bits (16-23), trit or quint (24-31) */
uint result_vector[MAX_WEIGHT_VALUES];
int result_index = 0;
uint result_vector_max_index;
bool result_limit_reached = false;

uint Encoding(uint val) {
    return bitfieldExtract(val, 0, 8);
}
uint NumBits(uint val) {
    return bitfieldExtract(val, 8, 8);
}
uint BitValue(uint val) {
    return bitfieldExtract(val, 16, 8);
}
uint QuintTritValue(uint val) {
    return bitfieldExtract(val, 24, 8);
}

uint CreateEncodingData(uint encoding, uint num_bits, uint bit_val, uint quint_trit_val) {
    return encoding | (num_bits << 8u) | (bit_val << 16u) | (quint_trit_val << 24u);
}

void ResultEmplaceBack(uint val) {
    if (result_index >= result_vector_max_index) {
        /* the phase has all the values it needs */
        result_limit_reached = true;
        return;
    }
    result_vector[result_index] = val;
    ++result_index;
}

uint ReplicateBits(uint value, uint num_bits, uint to_bit) {
    if (value == 0 || num_bits == 0) {
        return 0;
    }
    if (num_bits >= to_bit) {
        return value;
    }
    const uint v = value & uint((1 << num_bits) - 1);
    uint res = v;
    uint reslen = num_bits;
    while (reslen < to_bit) {
        const uint num_dst_bits_to_shift_up = min(num_bits, to_bit - reslen);
        const uint num_src_bits_to_shift_down = num_bits - num_dst_bits_to_shift_up;
        res <<= num_dst_bits_to_shift_up;
        res |= (v >> num_src_bits_to_shift_down);
        reslen += num_bits;
    }
    return res;
}

uint Div3Ceil(uint v) {
    return ((v + 2) * 0x5556) >> 16;
}

uint Div5Ceil(uint v) {
    return ((v + 4) * 0x3334) >> 16;
}

uint Hash52(uint p) {
    p ^= p >> 15;
    p -= p << 17;
    p += p << 7;
    p += p << 4;
    p ^= p >> 5;
    p += p << 16;
    p ^= p >> 7;
    p ^= p >> 3;
    p ^= p << 6;
    p ^= p >> 17;
    return p;
}

uint Select2DPartition(uint seed, uint x, uint y, uint partition_count) {
    if ((block_dims.y * block_dims.x) < 32) {
        x <<= 1;
        y <<= 1;
    }
    seed += (partition_count - 1) * 1024;
    const uint rnum = Hash52(seed);
    uint seed1 = rnum & 0xF;
    uint seed2 = (rnum >> 4) & 0xF;
    uint seed3 = (rnum >> 8) & 0xF;
    uint seed4 = (rnum >> 12) & 0xF;
    uint seed5 = (rnum >> 16) & 0xF;
    uint seed6 = (rnum >> 20) & 0xF;
    uint seed7 = (rnum >> 24) & 0xF;
    uint seed8 = (rnum >> 28) & 0xF;
    seed1 *= seed1;
    seed2 *= seed2;
    seed3 *= seed3;
    seed4 *= seed4;
    seed5 *= seed5;
    seed6 *= seed6;
    seed7 *= seed7;
    seed8 *= seed8;
    uint sh1, sh2;
    if ((seed & 1) > 0) {
        sh1 = (seed & 2) > 0 ? 4 : 5;
        sh2 = (partition_count == 3) ? 6 : 5;
    } else {
        sh1 = (partition_count == 3) ? 6 : 5;
        sh2 = (seed & 2) > 0 ? 4 : 5;
    }
    seed1 >>= sh1;
    seed2 >>= sh2;
    seed3 >>= sh1;
    seed4 >>= sh2;
    seed5 >>= sh1;
    seed6 >>= sh2;
    seed7 >>= sh1;
    seed8 >>= sh2;
    uint a = (seed1 * x + seed2 * y + (rnum >> 14)) & 0x3F;
    uint b = (seed3 * x + seed4 * y + (rnum >> 10)) & 0x3F;
    uint c = (seed5 * x + seed6 * y + (rnum >> 6)) & 0x3F;
    uint d = (seed7 * x + seed8 * y + (rnum >> 2)) & 0x3F;
    if (partition_count < 4) {
        d = 0;
    }
    if (partition_count < 3) {
        c = 0;
    }
    if (a >= b && a >= c && a >= d) {
        return 0;
    } else if (b >= c && b >= d) {
        return 1;
    } else if (c >= d) {
        return 2;
    }
    return 3;
}

/* bits past the end of the 128 bits read as zero, as the CPU reference's bit stream does */
uint ExtractBits(uvec4 payload, int offset, int bits) {
    if (bits <= 0 || bits > 32 || offset >= 128) {
        return 0;
    }
    const int last_offset = offset + bits - 1;
    const int shifted_offset = offset >> 5;
    if ((last_offset >> 5) == shifted_offset) {
        return bitfieldExtract(payload[shifted_offset], offset & 31, bits);
    }
    const int first_bits = 32 - (offset & 31);
    const uint result_first = bitfieldExtract(payload[shifted_offset], offset & 31, first_bits);
    if (shifted_offset == 3) {
        return result_first;
    }
    const uint result_second = bitfieldExtract(payload[shifted_offset + 1], 0, bits - first_bits);
    return result_first | (result_second << first_bits);
}

uint StreamBits(uint num_bits) {
    const uint ret = ExtractBits(local_buff, total_bitsread, int(num_bits));
    total_bitsread += int(num_bits);
    return ret;
}

uint StreamColorBits(uint num_bits) {
    const uint ret = ExtractBits(color_endpoint_data, color_bitsread, int(num_bits));
    color_bitsread += int(num_bits);
    return ret;
}

/* the number of bits that n_vals values of an encoding take */
uint GetBitLength(uint n_vals, uint encoding_index) {
    const uint encoding_value = encoding_values[encoding_index];
    const uint encoding = Encoding(encoding_value);
    uint total_bits = NumBits(encoding_value) * n_vals;
    if (encoding == TRIT) {
        total_bits += Div5Ceil(n_vals * 8);
    } else if (encoding == QUINT) {
        total_bits += Div3Ceil(n_vals * 7);
    }
    return total_bits;
}

uint GetNumWeightValues(uvec2 size, bool dual_plane) {
    return size.x * size.y * (dual_plane ? 2 : 1);
}

uint BitsBracket(uint bits, uint pos) {
    return (bits >> pos) & 1;
}

uint BitsOp(uint bits, uint start, uint end) {
    const uint mask = (1 << (end - start + 1)) - 1;
    return (bits >> start) & mask;
}

void DecodeQuintBlock(uint num_bits) {
    uvec3 m;
    uvec4 qQ;
    m[0] = StreamColorBits(num_bits);
    qQ.w = StreamColorBits(3);
    m[1] = StreamColorBits(num_bits);
    qQ.w |= StreamColorBits(2) << 3;
    m[2] = StreamColorBits(num_bits);
    qQ.w |= StreamColorBits(2) << 5;
    if (BitsOp(qQ.w, 1, 2) == 3 && BitsOp(qQ.w, 5, 6) == 0) {
        qQ.x = 4;
        qQ.y = 4;
        qQ.z = (BitsBracket(qQ.w, 0) << 2) | ((BitsBracket(qQ.w, 4) & ~BitsBracket(qQ.w, 0)) << 1) |
               (BitsBracket(qQ.w, 3) & ~BitsBracket(qQ.w, 0));
    } else {
        uint C = 0;
        if (BitsOp(qQ.w, 1, 2) == 3) {
            qQ.z = 4;
            C = (BitsOp(qQ.w, 3, 4) << 3) | ((~BitsOp(qQ.w, 5, 6) & 3) << 1) | BitsBracket(qQ.w, 0);
        } else {
            qQ.z = BitsOp(qQ.w, 5, 6);
            C = BitsOp(qQ.w, 0, 4);
        }
        if (BitsOp(C, 0, 2) == 5) {
            qQ.y = 4;
            qQ.x = BitsOp(C, 3, 4);
        } else {
            qQ.y = BitsOp(C, 3, 4);
            qQ.x = BitsOp(C, 0, 2);
        }
    }
    for (uint i = 0; i < 3; i++) {
        ResultEmplaceBack(CreateEncodingData(QUINT, num_bits, m[i], qQ[i]));
    }
}

void DecodeTritBlock(uint num_bits) {
    uvec4 m;
    uvec4 t;
    uvec3 Tm5t5;
    m[0] = StreamColorBits(num_bits);
    Tm5t5.x = StreamColorBits(2);
    m[1] = StreamColorBits(num_bits);
    Tm5t5.x |= StreamColorBits(2) << 2;
    m[2] = StreamColorBits(num_bits);
    Tm5t5.x |= StreamColorBits(1) << 4;
    m[3] = StreamColorBits(num_bits);
    Tm5t5.x |= StreamColorBits(2) << 5;
    Tm5t5.y = StreamColorBits(num_bits);
    Tm5t5.x |= StreamColorBits(1) << 7;
    uint C = 0;
    if (BitsOp(Tm5t5.x, 2, 4) == 7) {
        C = (BitsOp(Tm5t5.x, 5, 7) << 2) | BitsOp(Tm5t5.x, 0, 1);
        Tm5t5.z = 2;
        t[3] = 2;
    } else {
        C = BitsOp(Tm5t5.x, 0, 4);
        if (BitsOp(Tm5t5.x, 5, 6) == 3) {
            Tm5t5.z = 2;
            t[3] = BitsBracket(Tm5t5.x, 7);
        } else {
            Tm5t5.z = BitsBracket(Tm5t5.x, 7);
            t[3] = BitsOp(Tm5t5.x, 5, 6);
        }
    }
    if (BitsOp(C, 0, 1) == 3) {
        t[2] = 2;
        t[1] = BitsBracket(C, 4);
        t[0] = (BitsBracket(C, 3) << 1) | (BitsBracket(C, 2) & ~BitsBracket(C, 3));
    } else if (BitsOp(C, 2, 3) == 3) {
        t[2] = 2;
        t[1] = 2;
        t[0] = BitsOp(C, 0, 1);
    } else {
        t[2] = BitsBracket(C, 4);
        t[1] = BitsOp(C, 2, 3);
        t[0] = (BitsBracket(C, 1) << 1) | (BitsBracket(C, 0) & ~BitsBracket(C, 1));
    }
    for (uint i = 0; i < 4; i++) {
        ResultEmplaceBack(CreateEncodingData(TRIT, num_bits, m[i], t[i]));
    }
    ResultEmplaceBack(CreateEncodingData(TRIT, num_bits, Tm5t5.y, Tm5t5.z));
}

void DecodeIntegerSequence(uint max_range, uint num_values) {
    const uint val = encoding_values[max_range];
    const uint encoding = Encoding(val);
    const uint num_bits = NumBits(val);
    uint vals_decoded = 0;
    while (vals_decoded < num_values && !result_limit_reached) {
        switch (encoding) {
        case QUINT:
            DecodeQuintBlock(num_bits);
            vals_decoded += 3;
            break;
        case TRIT:
            DecodeTritBlock(num_bits);
            vals_decoded += 5;
            break;
        case JUST_BITS:
            ResultEmplaceBack(bitfieldInsert(val, StreamColorBits(num_bits), 16, 8));
            vals_decoded++;
            break;
        }
    }
}

void DecodeColorValues(uvec4 modes, uint num_partitions, uint color_data_bits, out uint color_values[32]) {
    uint num_values = 0;
    for (uint i = 0; i < num_partitions; i++) {
        num_values += ((modes[i] >> 2) + 1) << 1;
    }
    /* the largest encoding whose values fit in color_data_bits */
    int range = 0;
    while (++range < encoding_values.length()) {
        if (GetBitLength(num_values, range) > color_data_bits) {
            break;
        }
    }
    /* bits past the sequence's length read as zero (the encoder may leave anything there): Eden decodes the
       last trit or quint block's spare values from them, which can change the values that are used */
    const uint sequence_bits = GetBitLength(num_values, range - 1);
    for (uint i = 0; i < 4; i++) {
        if (sequence_bits <= i * 32) {
            color_endpoint_data[i] = 0;
        } else if (sequence_bits < i * 32 + 32) {
            color_endpoint_data[i] &= (1u << (sequence_bits - i * 32)) - 1u;
        }
    }
    DecodeIntegerSequence(range - 1, num_values);
    uint out_index = 0;
    for (int itr = 0; itr < result_index; ++itr) {
        if (out_index >= num_values) {
            break;
        }
        const uint val = result_vector[itr];
        const uint encoding = Encoding(val);
        const uint bitlen = NumBits(val);
        const uint bitval = BitValue(val);
        uint A = 0, B = 0, C = 0, D = 0;
        A = (bitval & 1) * 511;
        switch (encoding) {
        case JUST_BITS:
            color_values[out_index++] = ReplicateBits(bitval, bitlen, 8);
            break;
        case TRIT: {
            D = QuintTritValue(val);
            switch (bitlen) {
            case 1:
                C = 204;
                break;
            case 2: {
                C = 93;
                const uint b = (bitval >> 1) & 1;
                B = (b << 8) | (b << 4) | (b << 2) | (b << 1);
                break;
            }
            case 3: {
                C = 44;
                const uint cb = (bitval >> 1) & 3;
                B = (cb << 7) | (cb << 2) | cb;
                break;
            }
            case 4: {
                C = 22;
                const uint dcb = (bitval >> 1) & 7;
                B = (dcb << 6) | dcb;
                break;
            }
            case 5: {
                C = 11;
                const uint edcb = (bitval >> 1) & 0xF;
                B = (edcb << 5) | (edcb >> 2);
                break;
            }
            case 6: {
                C = 5;
                const uint fedcb = (bitval >> 1) & 0x1F;
                B = (fedcb << 4) | (fedcb >> 4);
                break;
            }
            }
            break;
        }
        case QUINT: {
            D = QuintTritValue(val);
            switch (bitlen) {
            case 1:
                C = 113;
                break;
            case 2: {
                C = 54;
                const uint b = (bitval >> 1) & 1;
                B = (b << 8) | (b << 3) | (b << 2);
                break;
            }
            case 3: {
                C = 26;
                const uint cb = (bitval >> 1) & 3;
                B = (cb << 7) | (cb << 1) | (cb >> 1);
                break;
            }
            case 4: {
                C = 13;
                const uint dcb = (bitval >> 1) & 7;
                B = (dcb << 6) | (dcb >> 1);
                break;
            }
            case 5: {
                C = 6;
                const uint edcb = (bitval >> 1) & 0xF;
                B = (edcb << 5) | (edcb >> 3);
                break;
            }
            }
            break;
        }
        }
        if (encoding != JUST_BITS) {
            uint T = (D * C) + B;
            T ^= A;
            T = (A & 0x80) | (T >> 2);
            color_values[out_index++] = T;
        }
    }
}

ivec2 BitTransferSigned(int a, int b) {
    ivec2 transferred;
    transferred.y = b >> 1;
    transferred.y |= a & 0x80;
    transferred.x = a >> 1;
    transferred.x &= 0x3F;
    if ((transferred.x & 0x20) > 0) {
        transferred.x -= 0x40;
    }
    return transferred;
}

uvec4 ClampByte(ivec4 color) {
    return uvec4(clamp(color, 0, 255));
}

ivec4 BlueContract(int a, int r, int g, int b) {
    return ivec4(a, (r + b) >> 1, (g + b) >> 1, b);
}

bool IsHDRColorEndpointMode(uint cem) {
    return cem == 2u || cem == 3u || cem == 7u || cem == 11u || cem == 14u || cem == 15u;
}

/* the low nbits of value as a signed number: Eden keeps the bits above them, which mode 11 shares with x2 to x5 */
int SignExtend(int value, uint nbits) {
    int sign_bit = 1 << (nbits - 1u);
    return ((value & ((1 << nbits) - 1)) ^ sign_bit) - sign_bit;
}

void DecodeHDREndpointMode7(uint v0, uint v1, uint v2, uint v3, out ivec3 e0, out ivec3 e1) {
    uint modeval = ((v0 & 0xC0u) >> 6u) | ((v1 & 0x80u) >> 5u) | ((v2 & 0x80u) >> 4u);
    uint majcomp;
    uint mode;
    if ((modeval & 0xCu) != 0xCu) {
        majcomp = modeval >> 2u;
        mode = modeval & 3u;
    } else if (modeval != 0xFu) {
        majcomp = modeval & 3u;
        mode = 4u;
    } else {
        majcomp = 0u;
        mode = 5u;
    }
    int red = int(v0 & 0x3Fu);
    int green = int(v1 & 0x1Fu);
    int blue = int(v2 & 0x1Fu);
    int scale = int(v3 & 0x1Fu);
    uint x0 = (v1 >> 6u) & 1u;
    uint x1 = (v1 >> 5u) & 1u;
    uint x2 = (v2 >> 6u) & 1u;
    uint x3 = (v2 >> 5u) & 1u;
    uint x4 = (v3 >> 7u) & 1u;
    uint x5 = (v3 >> 6u) & 1u;
    uint x6 = (v3 >> 5u) & 1u;
    uint ohm = 1u << mode;
    if ((ohm & 0x30u) != 0u) green |= int(x0 << 6u);
    if ((ohm & 0x3Au) != 0u) green |= int(x1 << 5u);
    if ((ohm & 0x30u) != 0u) blue |= int(x2 << 6u);
    if ((ohm & 0x3Au) != 0u) blue |= int(x3 << 5u);
    if ((ohm & 0x3Du) != 0u) scale |= int(x6 << 5u);
    if ((ohm & 0x2Du) != 0u) scale |= int(x5 << 6u);
    if ((ohm & 0x04u) != 0u) scale |= int(x4 << 7u);
    if ((ohm & 0x3Bu) != 0u) red |= int(x4 << 6u);
    if ((ohm & 0x04u) != 0u) red |= int(x3 << 6u);
    if ((ohm & 0x10u) != 0u) red |= int(x5 << 7u);
    if ((ohm & 0x0Fu) != 0u) red |= int(x2 << 7u);
    if ((ohm & 0x05u) != 0u) red |= int(x1 << 8u);
    if ((ohm & 0x0Au) != 0u) red |= int(x0 << 8u);
    if ((ohm & 0x05u) != 0u) red |= int(x0 << 9u);
    if ((ohm & 0x02u) != 0u) red |= int(x6 << 9u);
    if ((ohm & 0x01u) != 0u) red |= int(x3 << 10u);
    if ((ohm & 0x02u) != 0u) red |= int(x5 << 10u);
    const int shamts[6] = int[](1, 1, 2, 3, 4, 5);
    int shamt = shamts[mode];
    red <<= shamt;
    green <<= shamt;
    blue <<= shamt;
    scale <<= shamt;
    if (mode != 5u) {
        green = red - green;
        blue = red - blue;
    }
    if (majcomp == 1u) {
        int t = red;
        red = green;
        green = t;
    }
    if (majcomp == 2u) {
        int t = red;
        red = blue;
        blue = t;
    }
    e1 = ivec3(clamp(red, 0, 0xFFF), clamp(green, 0, 0xFFF), clamp(blue, 0, 0xFFF));
    e0 = ivec3(clamp(red - scale, 0, 0xFFF), clamp(green - scale, 0, 0xFFF), clamp(blue - scale, 0, 0xFFF));
}

void DecodeHDREndpointMode11(uint v0, uint v1, uint v2, uint v3, uint v4, uint v5, out ivec3 e0, out ivec3 e1) {
    uint majcomp = ((v4 & 0x80u) >> 7u) | ((v5 & 0x80u) >> 6u);
    if (majcomp == 3u) {
        e0 = ivec3(int(v0 << 4u), int(v2 << 4u), int((v4 & 0x7Fu) << 5u));
        e1 = ivec3(int(v1 << 4u), int(v3 << 4u), int((v5 & 0x7Fu) << 5u));
        return;
    }
    uint mode = ((v1 & 0x80u) >> 7u) | ((v2 & 0x80u) >> 6u) | ((v3 & 0x80u) >> 5u);
    int va = int(v0 | ((v1 & 0x40u) << 2u));
    int vb0 = int(v2 & 0x3Fu);
    int vb1 = int(v3 & 0x3Fu);
    int vc = int(v1 & 0x3Fu);
    int vd0 = int(v4 & 0x7Fu);
    int vd1 = int(v5 & 0x7Fu);
    const int dbitstab[8] = int[](7, 6, 7, 6, 5, 6, 5, 6);
    vd0 = SignExtend(vd0, uint(dbitstab[mode]));
    vd1 = SignExtend(vd1, uint(dbitstab[mode]));
    uint x0 = (v2 >> 6u) & 1u;
    uint x1 = (v3 >> 6u) & 1u;
    uint x2 = (v4 >> 6u) & 1u;
    uint x3 = (v5 >> 6u) & 1u;
    uint x4 = (v4 >> 5u) & 1u;
    uint x5 = (v5 >> 5u) & 1u;
    uint ohm = 1u << mode;
    if ((ohm & 0xA4u) != 0u) va |= int(x0 << 9u);
    if ((ohm & 0x08u) != 0u) va |= int(x2 << 9u);
    if ((ohm & 0x50u) != 0u) va |= int(x4 << 9u);
    if ((ohm & 0x50u) != 0u) va |= int(x5 << 10u);
    if ((ohm & 0xA0u) != 0u) va |= int(x1 << 10u);
    if ((ohm & 0xC0u) != 0u) va |= int(x2 << 11u);
    if ((ohm & 0x04u) != 0u) vc |= int(x1 << 6u);
    if ((ohm & 0xE8u) != 0u) vc |= int(x3 << 6u);
    if ((ohm & 0x20u) != 0u) vc |= int(x2 << 7u);
    if ((ohm & 0x5Bu) != 0u) vb0 |= int(x0 << 6u);
    if ((ohm & 0x5Bu) != 0u) vb1 |= int(x1 << 6u);
    if ((ohm & 0x12u) != 0u) vb0 |= int(x2 << 7u);
    if ((ohm & 0x12u) != 0u) vb1 |= int(x3 << 7u);
    int shamt = (int(mode) >> 1) ^ 3;
    va <<= shamt;
    vb0 <<= shamt;
    vb1 <<= shamt;
    vc <<= shamt;
    vd0 <<= shamt;
    vd1 <<= shamt;
    int r1 = clamp(va, 0, 0xFFF);
    int g1 = clamp(va - vb0, 0, 0xFFF);
    int b1 = clamp(va - vb1, 0, 0xFFF);
    int r0 = clamp(va - vc, 0, 0xFFF);
    int g0 = clamp(va - vb0 - vc - vd0, 0, 0xFFF);
    int b0 = clamp(va - vb1 - vc - vd1, 0, 0xFFF);
    if (majcomp == 1u) {
        int t;
        t = r0; r0 = g0; g0 = t;
        t = r1; r1 = g1; g1 = t;
    } else if (majcomp == 2u) {
        int t;
        t = r0; r0 = b0; b0 = t;
        t = r1; r1 = b1; b1 = t;
    }
    e0 = ivec3(r0, g0, b0);
    e1 = ivec3(r1, g1, b1);
}

/* the endpoints in A, R, G, B order: 8 bit for the LDR modes, 12 bit (or more for mode 15's alpha) for HDR */
void ComputeEndpoints(out uvec4 ep1, out uvec4 ep2, uint color_endpoint_mode, uint color_values[32],
                      inout uint colvals_index) {
#define READ_UINT_VALUES(N)                                \
    uvec4 V[2];                                            \
    for (uint i = 0; i < N; i++) {                         \
        V[i / 4][i % 4] = color_values[colvals_index++];   \
    }
#define READ_INT_VALUES(N)                                 \
    ivec4 V[2];                                            \
    for (uint i = 0; i < N; i++) {                         \
        V[i / 4][i % 4] = int(color_values[colvals_index++]); \
    }
    switch (color_endpoint_mode) {
    case 0: {
        READ_UINT_VALUES(2)
        ep1 = uvec4(0xFF, V[0].x, V[0].x, V[0].x);
        ep2 = uvec4(0xFF, V[0].y, V[0].y, V[0].y);
        break;
    }
    case 1: {
        READ_UINT_VALUES(2)
        const uint L0 = (V[0].x >> 2) | (V[0].y & 0xC0);
        const uint L1 = min(L0 + (V[0].y & 0x3F), 0xFFU);
        ep1 = uvec4(0xFF, L0, L0, L0);
        ep2 = uvec4(0xFF, L1, L1, L1);
        break;
    }
    case 4: {
        READ_UINT_VALUES(4)
        ep1 = uvec4(V[0].z, V[0].x, V[0].x, V[0].x);
        ep2 = uvec4(V[0].w, V[0].y, V[0].y, V[0].y);
        break;
    }
    case 5: {
        READ_INT_VALUES(4)
        ivec2 transferred = BitTransferSigned(V[0].y, V[0].x);
        V[0].y = transferred.x;
        V[0].x = transferred.y;
        transferred = BitTransferSigned(V[0].w, V[0].z);
        V[0].w = transferred.x;
        V[0].z = transferred.y;
        ep1 = ClampByte(ivec4(V[0].z, V[0].x, V[0].x, V[0].x));
        ep2 = ClampByte(ivec4(V[0].z + V[0].w, V[0].x + V[0].y, V[0].x + V[0].y, V[0].x + V[0].y));
        break;
    }
    case 6: {
        READ_UINT_VALUES(4)
        ep1 = uvec4(0xFF, (V[0].x * V[0].w) >> 8, (V[0].y * V[0].w) >> 8, (V[0].z * V[0].w) >> 8);
        ep2 = uvec4(0xFF, V[0].x, V[0].y, V[0].z);
        break;
    }
    case 8: {
        READ_UINT_VALUES(6)
        if ((V[0].y + V[0].w + V[1].y) >= (V[0].x + V[0].z + V[1].x)) {
            ep1 = uvec4(0xFF, V[0].x, V[0].z, V[1].x);
            ep2 = uvec4(0xFF, V[0].y, V[0].w, V[1].y);
        } else {
            ep1 = uvec4(BlueContract(0xFF, int(V[0].y), int(V[0].w), int(V[1].y)));
            ep2 = uvec4(BlueContract(0xFF, int(V[0].x), int(V[0].z), int(V[1].x)));
        }
        break;
    }
    case 9: {
        READ_INT_VALUES(6)
        ivec2 transferred = BitTransferSigned(V[0].y, V[0].x);
        V[0].y = transferred.x;
        V[0].x = transferred.y;
        transferred = BitTransferSigned(V[0].w, V[0].z);
        V[0].w = transferred.x;
        V[0].z = transferred.y;
        transferred = BitTransferSigned(V[1].y, V[1].x);
        V[1].y = transferred.x;
        V[1].x = transferred.y;
        if ((V[0].y + V[0].w + V[1].y) >= 0) {
            ep1 = ClampByte(ivec4(0xFF, V[0].x, V[0].z, V[1].x));
            ep2 = ClampByte(ivec4(0xFF, V[0].x + V[0].y, V[0].z + V[0].w, V[1].x + V[1].y));
        } else {
            ep1 = ClampByte(BlueContract(0xFF, V[0].x + V[0].y, V[0].z + V[0].w, V[1].x + V[1].y));
            ep2 = ClampByte(BlueContract(0xFF, V[0].x, V[0].z, V[1].x));
        }
        break;
    }
    case 10: {
        READ_UINT_VALUES(6)
        ep1 = uvec4(V[1].x, (V[0].x * V[0].w) >> 8, (V[0].y * V[0].w) >> 8, (V[0].z * V[0].w) >> 8);
        ep2 = uvec4(V[1].y, V[0].x, V[0].y, V[0].z);
        break;
    }
    case 12: {
        READ_UINT_VALUES(8)
        if ((V[0].y + V[0].w + V[1].y) >= (V[0].x + V[0].z + V[1].x)) {
            ep1 = uvec4(V[1].z, V[0].x, V[0].z, V[1].x);
            ep2 = uvec4(V[1].w, V[0].y, V[0].w, V[1].y);
        } else {
            ep1 = uvec4(BlueContract(int(V[1].w), int(V[0].y), int(V[0].w), int(V[1].y)));
            ep2 = uvec4(BlueContract(int(V[1].z), int(V[0].x), int(V[0].z), int(V[1].x)));
        }
        break;
    }
    case 13: {
        READ_INT_VALUES(8)
        ivec2 transferred = BitTransferSigned(V[0].y, V[0].x);
        V[0].y = transferred.x;
        V[0].x = transferred.y;
        transferred = BitTransferSigned(V[0].w, V[0].z);
        V[0].w = transferred.x;
        V[0].z = transferred.y;
        transferred = BitTransferSigned(V[1].y, V[1].x);
        V[1].y = transferred.x;
        V[1].x = transferred.y;
        transferred = BitTransferSigned(V[1].w, V[1].z);
        V[1].w = transferred.x;
        V[1].z = transferred.y;
        if ((V[0].y + V[0].w + V[1].y) >= 0) {
            ep1 = ClampByte(ivec4(V[1].z, V[0].x, V[0].z, V[1].x));
            ep2 = ClampByte(ivec4(V[1].w + V[1].z, V[0].x + V[0].y, V[0].z + V[0].w, V[1].x + V[1].y));
        } else {
            ep1 = ClampByte(BlueContract(V[1].z + V[1].w, V[0].x + V[0].y, V[0].z + V[0].w, V[1].x + V[1].y));
            ep2 = ClampByte(BlueContract(V[1].z, V[0].x, V[0].z, V[1].x));
        }
        break;
    }
    case 2: {
        READ_UINT_VALUES(2)
        uint y0, y1;
        if (V[0].y >= V[0].x) {
            y0 = V[0].x << 4u;
            y1 = V[0].y << 4u;
        } else {
            y0 = (V[0].y << 4u) + 8u;
            y1 = (V[0].x << 4u) - 8u;
        }
        ep1 = uvec4(0x780u, y0, y0, y0);
        ep2 = uvec4(0x780u, y1, y1, y1);
        break;
    }
    case 3: {
        READ_UINT_VALUES(2)
        uint y0, d;
        if ((V[0].x & 0x80u) != 0u) {
            y0 = ((V[0].y & 0xE0u) << 4u) | ((V[0].x & 0x7Fu) << 2u);
            d = (V[0].y & 0x1Fu) << 2u;
        } else {
            y0 = ((V[0].y & 0xF0u) << 4u) | ((V[0].x & 0x7Fu) << 1u);
            d = (V[0].y & 0x0Fu) << 1u;
        }
        const uint y1 = min(y0 + d, 0xFFFu);
        ep1 = uvec4(0x780u, y0, y0, y0);
        ep2 = uvec4(0x780u, y1, y1, y1);
        break;
    }
    case 7: {
        READ_UINT_VALUES(4)
        ivec3 e0, e1;
        DecodeHDREndpointMode7(V[0].x, V[0].y, V[0].z, V[0].w, e0, e1);
        ep1 = uvec4(0x780u, uvec3(e0));
        ep2 = uvec4(0x780u, uvec3(e1));
        break;
    }
    case 11: {
        READ_UINT_VALUES(6)
        ivec3 e0, e1;
        DecodeHDREndpointMode11(V[0].x, V[0].y, V[0].z, V[0].w, V[1].x, V[1].y, e0, e1);
        ep1 = uvec4(0x780u, uvec3(e0));
        ep2 = uvec4(0x780u, uvec3(e1));
        break;
    }
    case 14: {
        READ_UINT_VALUES(8)
        ivec3 e0, e1;
        DecodeHDREndpointMode11(V[0].x, V[0].y, V[0].z, V[0].w, V[1].x, V[1].y, e0, e1);
        ep1 = uvec4(V[1].z, uvec3(e0));
        ep2 = uvec4(V[1].w, uvec3(e1));
        break;
    }
    default: {
        READ_UINT_VALUES(8)
        ivec3 e0, e1;
        DecodeHDREndpointMode11(V[0].x, V[0].y, V[0].z, V[0].w, V[1].x, V[1].y, e0, e1);
        const uint mode = ((V[1].z >> 7u) & 1u) | ((V[1].w >> 6u) & 2u);
        int a6 = int(V[1].z & 0x7Fu);
        int a7 = int(V[1].w & 0x7Fu);
        int alpha0, alpha1;
        if (mode == 3u) {
            alpha0 = a6 << 5;
            alpha1 = a7 << 5;
        } else {
            a6 |= (a7 << int(mode + 1u)) & 0x780;
            a7 &= int(0x3Fu >> mode);
            a7 ^= int(0x20u >> mode);
            a7 -= int(0x20u >> mode);
            a6 <<= int(4u - mode);
            a7 <<= int(4u - mode);
            a7 += a6;
            alpha0 = a6;
            alpha1 = clamp(a7, 0, 0xFFF);
        }
        ep1 = uvec4(uint(alpha0), uvec3(e0));
        ep2 = uvec4(uint(alpha1), uvec3(e1));
        break;
    }
    }
#undef READ_UINT_VALUES
#undef READ_INT_VALUES
}

/* weights to [0, 64]: bits replicated to 6 bits, or the trit or quint unquantization, then values above 32 one
   higher (the ASTC specification's weight unquantization, which Eden's CPU decoder follows) */
uint UnquantizeTexelWeight(uint val) {
    const uint encoding = Encoding(val), bitlen = NumBits(val), bitval = BitValue(val);
    uint res;
    if (encoding == JUST_BITS) {
        res = ReplicateBits(bitval, bitlen, 6);
    } else {
        const uint D = QuintTritValue(val);
        const uint b_mask = (0x3100 >> (bitlen * 4)) & 0xf;
        const uint b = (bitval >> 1) & b_mask;
        uint B = 0, C = 0;
        if (encoding == TRIT) {
            switch (bitlen) {
            case 0: return D * 32;
            case 1: C = 50; break;
            case 2: C = 23; B = (b << 6) | (b << 2) | b; break;
            case 3: C = 11; B = (b << 5) | b; break;
            }
        } else {
            switch (bitlen) {
            case 0: return D * 16;
            case 1: C = 28; break;
            case 2: C = 13; B = (b << 6) | (b << 1); break;
            }
        }
        const uint A = (bitval & 1) * 127;
        res = (A & 0x20) | (((D * C + B) ^ A) >> 2);
    }
    return res + (res > 32 ? 1 : 0);
}

void UnquantizeTexelWeights(uvec2 size, bool is_dual_plane) {
    const uint loop_count = min(uint(result_index), GetNumWeightValues(size, is_dual_plane));
    for (uint itr = 0; itr < loop_count; ++itr) {
        result_vector[itr] = UnquantizeTexelWeight(result_vector[itr]);
    }
}

uint GetUnquantizedTexelWeight(uint offset_base, uint plane, bool is_dual_plane) {
    return result_vector[is_dual_plane ? 2 * offset_base + plane : offset_base];
}

/* the weight grid infilled at texel (s, t), per channel in A, R, G, B order */
uvec4 GetUnquantizedWeightVector(uint t, uint s, uvec2 size, uint plane_index, bool is_dual_plane) {
    const uint Ds = (1024 + block_dims.x / 2) / (block_dims.x - 1);
    const uint Dt = (1024 + block_dims.y / 2) / (block_dims.y - 1);
    const uint area = size.x * size.y;
    const uint cs = Ds * s;
    const uint ct = Dt * t;
    const uint gs = (cs * (size.x - 1) + 32) >> 6;
    const uint gt = (ct * (size.y - 1) + 32) >> 6;
    const uint js = gs >> 4;
    const uint fs = gs & 0xF;
    const uint jt = gt >> 4;
    const uint ft = gt & 0x0F;
    const uint w11 = (fs * ft + 8) >> 4;
    const uint w10 = ft - w11;
    const uint w01 = fs - w11;
    const uint w00 = 16 - fs - ft + w11;
    const uvec4 w = uvec4(w00, w01, w10, w11);
    const uint v0 = jt * size.x + js;
    uvec4 p0 = uvec4(0);
    uvec4 p1 = uvec4(0);
    if (v0 < area) {
        p0.x = GetUnquantizedTexelWeight(v0, 0, is_dual_plane);
        p1.x = GetUnquantizedTexelWeight(v0, 1, is_dual_plane);
    }
    if ((v0 + 1) < area) {
        p0.y = GetUnquantizedTexelWeight(v0 + 1, 0, is_dual_plane);
        p1.y = GetUnquantizedTexelWeight(v0 + 1, 1, is_dual_plane);
    }
    if ((v0 + size.x) < area) {
        p0.z = GetUnquantizedTexelWeight(v0 + size.x, 0, is_dual_plane);
        p1.z = GetUnquantizedTexelWeight(v0 + size.x, 1, is_dual_plane);
    }
    if ((v0 + size.x + 1) < area) {
        p0.w = GetUnquantizedTexelWeight(v0 + size.x + 1, 0, is_dual_plane);
        p1.w = GetUnquantizedTexelWeight(v0 + size.x + 1, 1, is_dual_plane);
    }
    const uint primary_weight = (p0.x * w.x + p0.y * w.y + p0.z * w.z + p0.w * w.w + 8) >> 4;
    uvec4 weight_vec = uvec4(primary_weight);
    if (is_dual_plane) {
        const uint secondary_weight = (p1.x * w.x + p1.y * w.y + p1.z * w.z + p1.w * w.w + 8) >> 4;
        for (uint c = 0; c < 4; c++) {
            const bool is_secondary = ((plane_index + 1u) & 3u) == c;
            weight_vec[c] = is_secondary ? secondary_weight : primary_weight;
        }
    }
    return weight_vec;
}

int FindLayout(uint mode) {
    if ((mode & 3) != 0) {
        if ((mode & 8) != 0) {
            if ((mode & 4) != 0) {
                if ((mode & 0x100) != 0) {
                    return 4;
                }
                return 3;
            }
            return 2;
        }
        if ((mode & 4) != 0) {
            return 1;
        }
        return 0;
    }
    if ((mode & 0x100) != 0) {
        if ((mode & 0x80) != 0) {
            if ((mode & 0x20) != 0) {
                return 8;
            }
            return 7;
        }
        return 9;
    }
    if ((mode & 0x80) != 0) {
        return 6;
    }
    return 5;
}

/* a UNORM16 value to 8 bits, rounded to nearest, as storing value / 65535 into an RGBA8 image does in Eden */
uint Unorm16To8(uint c) {
    return (c * 255u + 32767u) / 65535u;
}

/* a non-negative half below infinity, clamped to [0, 1], to 8 bits rounded to nearest (half up) */
uint HalfToByte(uint h) {
    if (h >= 0x3C00u) {
        return 255u;
    }
    const uint e = h >> 10u;
    const uint sig = e == 0u ? h : (h & 0x3FFu) | 0x400u;
    const uint shift = e == 0u ? 24u : 25u - e;
    return (sig * 255u + (1u << (shift - 1u))) >> shift;
}

void StoreTexel(uvec2 origin, uint i, uint j, uint rgba) {
    const uint x = origin.x + i, y = origin.y + j;
    if (x < width && y < height) {
        texels[y * width + x] = rgba;
    }
}

void FillBlock(uvec2 origin, uint rgba) {
    for (uint j = 0; j < block_dims.y; j++) {
        for (uint i = 0; i < block_dims.x; i++) {
            StoreTexel(origin, i, j, rgba);
        }
    }
}

/* the error color is transparent black, as in Eden */
void FillError(uvec2 origin) {
    FillBlock(origin, 0u);
}

void FillVoidExtentLDR(uvec2 origin) {
    /* the extent's coordinates are not needed, but unless they are all ones the specification requires each
       minimum below its maximum, which Eden does not check */
    const uint s_min = StreamBits(13), s_max = StreamBits(13), t_min = StreamBits(13), t_max = StreamBits(13);
    if ((s_min & s_max & t_min & t_max) != 0x1FFFu && (s_min >= s_max || t_min >= t_max)) {
        FillError(origin);
        return;
    }
    uint r = StreamBits(16);
    uint g = StreamBits(16);
    uint b = StreamBits(16);
    const uint a = Unorm16To8(StreamBits(16));
    if (srgb != 0u) {
        /* sRGB decode mode: the top 8 bits of the color */
        r >>= 8u;
        g >>= 8u;
        b >>= 8u;
    } else {
        r = Unorm16To8(r);
        g = Unorm16To8(g);
        b = Unorm16To8(b);
    }
    FillBlock(origin, r | (g << 8) | (b << 16) | (a << 24));
}

bool IsError(uint mode) {
    if ((mode & 0x1ff) == 0x1fc) {
        if ((mode & 0x200) != 0) {
            return true; /* HDR void extent */
        }
        return (mode & 0x400) == 0 || StreamBits(1) == 0;
    }
    if ((mode & 0xf) == 0) {
        return true;
    }
    return (mode & 3) == 0 && (mode & 0x1c0) == 0x1c0;
}

uvec2 DecodeBlockSize(uint mode) {
    const uint A = (mode >> 5) & 0x3;
    switch (FindLayout(mode)) {
    case 0:
        return uvec2(((mode >> 7) & 0x3) + 4, A + 2);
    case 1:
        return uvec2(((mode >> 7) & 0x3) + 8, A + 2);
    case 2:
        return uvec2(A + 2, ((mode >> 7) & 0x3) + 8);
    case 3:
        return uvec2(A + 2, ((mode >> 7) & 0x1) + 6);
    case 4:
        return uvec2(((mode >> 7) & 0x1) + 2, A + 2);
    case 5:
        return uvec2(12, A + 2);
    case 6:
        return uvec2(A + 2, 12);
    case 7:
        return uvec2(6, 10);
    case 8:
        return uvec2(10, 6);
    default:
        return uvec2(A + 6, ((mode >> 9) & 0x3) + 6);
    }
}

/* the index in encoding_values of the weights' range */
uint DecodeMaxWeight(uint mode) {
    const int mode_layout = FindLayout(mode);
    uint weight_index = (mode & 0x10) != 0 ? 1 : 0;
    if (mode_layout < 5) {
        weight_index |= (mode & 0x3) << 1;
    } else {
        weight_index |= (mode & 0xc) >> 1;
    }
    weight_index -= 2;
    if ((mode_layout != 9) && ((mode & 0x200) != 0)) {
        weight_index += 6;
    }
    return weight_index + 1;
}

void DecompressBlock(uvec2 origin) {
    const uint mode = StreamBits(11);
    if (IsError(mode)) {
        FillError(origin);
        return;
    }
    if ((mode & 0x1ff) == 0x1fc) {
        FillVoidExtentLDR(origin);
        return;
    }
    const uvec2 size_params = DecodeBlockSize(mode);
    if ((size_params.x > block_dims.x) || (size_params.y > block_dims.y)) {
        FillError(origin);
        return;
    }
    const uint num_partitions = StreamBits(2) + 1;
    const int mode_layout = FindLayout(mode);
    const bool dual_plane = (mode_layout != 9) && ((mode & 0x400) != 0);
    if (num_partitions == 4 && dual_plane) {
        FillError(origin);
        return;
    }
    if (GetNumWeightValues(size_params, dual_plane) > MAX_WEIGHT_VALUES) {
        FillError(origin);
        return;
    }
    uint partition_index = 0;
    uvec4 color_endpoint_mode = uvec4(0);
    uint base_cem = 0;
    if (num_partitions == 1) {
        color_endpoint_mode.x = StreamBits(4);
    } else {
        partition_index = StreamBits(10);
        base_cem = StreamBits(6);
    }
    const uint base_mode = base_cem & 3;
    const uint max_weight = DecodeMaxWeight(mode);
    const uint weight_bits = GetBitLength(GetNumWeightValues(size_params, dual_plane), max_weight);
    if (weight_bits < 24 || weight_bits > 96) {
        FillError(origin);
        return;
    }
    const uint extra_cem_bits = base_mode > 0 ? num_partitions * 3 - 4 : 0; /* 2, 5 or 8 */
    const uint plane_selector_bits = dual_plane ? 2 : 0;
    const int remaining = 128 - int(weight_bits) - total_bitsread - int(extra_cem_bits + plane_selector_bits);
    if (remaining < 0) {
        /* more weight and mode bits than the block holds */
        FillError(origin);
        return;
    }
    const uint color_data_bits = uint(remaining);
    uint remaining_bits = color_data_bits;
    uint ced_pointer = 0;
    while (remaining_bits > 0) {
        const uint nb = min(remaining_bits, 32u);
        color_endpoint_data[ced_pointer] = StreamBits(nb);
        ++ced_pointer;
        remaining_bits -= nb;
    }
    const uint plane_index = StreamBits(plane_selector_bits);
    if (base_mode > 0) {
        uint cem = ((StreamBits(extra_cem_bits) << 6) | base_cem) >> 2;
        uvec4 C = uvec4(0);
        for (uint i = 0; i < num_partitions; i++) {
            C[i] = cem & 1;
            cem >>= 1;
        }
        uvec4 M = uvec4(0);
        for (uint i = 0; i < num_partitions; i++) {
            M[i] = cem & 3;
            cem >>= 2;
        }
        for (uint i = 0; i < num_partitions; i++) {
            color_endpoint_mode[i] = (((base_mode - (C[i] == 0 ? 1 : 0)) << 2) | M[i]);
        }
    } else if (num_partitions > 1) {
        color_endpoint_mode = uvec4(base_cem >> 2);
    }

    /* the specification's illegal encodings that Eden decodes anyway: more than 18 color values, or too few bits
       for them to have at least 6 levels (encoding_values[5], trits of 1 bit) */
    uint num_values = 0;
    for (uint i = 0; i < num_partitions; i++) {
        num_values += ((color_endpoint_mode[i] >> 2) + 1) << 1;
    }
    if (num_values > 18 || GetBitLength(num_values, 5) > color_data_bits) {
        FillError(origin);
        return;
    }

    uvec4 endpoints0[4];
    uvec4 endpoints1[4];
    {
        /* at most 4 partitions of 8 values */
        result_vector_max_index = 32;
        uint color_values[32];
        uint colvals_index = 0;
        DecodeColorValues(color_endpoint_mode, num_partitions, color_data_bits, color_values);
        for (uint i = 0; i < num_partitions; i++) {
            ComputeEndpoints(endpoints0[i], endpoints1[i], color_endpoint_mode[i], color_values, colvals_index);
        }
    }

    /* the weights are stored from the top of the block down, bit-reversed; bits above them read as zero */
    color_endpoint_data = bitfieldReverse(local_buff).wzyx;
    const uint clear_byte_start = (weight_bits >> 3) + 1;
    const uint byte_insert =
        ExtractBits(color_endpoint_data, int(clear_byte_start - 1) * 8, 8) & uint((1 << (weight_bits % 8)) - 1);
    const uint vec_index = (clear_byte_start - 1) >> 2;
    color_endpoint_data[vec_index] =
        bitfieldInsert(color_endpoint_data[vec_index], byte_insert, int((clear_byte_start - 1) % 4) * 8, 8);
    for (uint i = clear_byte_start; i < 16; ++i) {
        const uint idx = i >> 2;
        color_endpoint_data[idx] = bitfieldInsert(color_endpoint_data[idx], 0, int(i % 4) * 8, 8);
    }

    result_index = 0;
    color_bitsread = 0;
    result_limit_reached = false;
    result_vector_max_index = GetNumWeightValues(size_params, dual_plane);
    DecodeIntegerSequence(max_weight, GetNumWeightValues(size_params, dual_plane));
    UnquantizeTexelWeights(size_params, dual_plane);

    for (uint j = 0; j < block_dims.y; j++) {
        for (uint i = 0; i < block_dims.x; i++) {
            uint local_partition = 0;
            if (num_partitions > 1) {
                local_partition = Select2DPartition(partition_index, i, j, num_partitions);
            }
            const uint local_cem = color_endpoint_mode[local_partition];
            const uvec4 weight_vec = GetUnquantizedWeightVector(j, i, size_params, plane_index, dual_plane);
            const uvec4 C0 = endpoints0[local_partition];
            const uvec4 C1 = endpoints1[local_partition];
            uvec4 p; /* A, R, G, B */
            for (uint c = 0; c < 4; c++) {
                const uint w = weight_vec[c];
                if (IsHDRColorEndpointMode(local_cem) && !(local_cem == 14u && c == 0)) {
                    const uint C = ((C0[c] << 4) * (64 - w) + (C1[c] << 4) * w + 32) / 64;
                    const uint E = (C & 0xF800u) >> 11u;
                    const uint M = C & 0x7FFu;
                    uint Mt;
                    if (M < 512u) {
                        Mt = 3u * M;
                    } else if (M >= 1536u) {
                        Mt = 5u * M - 2048u;
                    } else {
                        Mt = 4u * M - 512u;
                    }
                    p[c] = HalfToByte(min((E << 10u) + (Mt >> 3u), 0x7BFFu));
                } else if (srgb != 0u && c != 0) {
                    /* sRGB decode mode: R, G and B expand as (e << 8) | 0x80 and keep the top 8 bits */
                    p[c] = ((((C0[c] << 8) | 0x80u) * (64 - w) + ((C1[c] << 8) | 0x80u) * w + 32) / 64) >> 8;
                } else {
                    p[c] = Unorm16To8((C0[c] * 0x101 * (64 - w) + C1[c] * 0x101 * w + 32) / 64);
                }
            }
            StoreTexel(origin, i, j, p.y | (p.z << 8) | (p.w << 16) | (p.x << 24));
        }
    }
}

void main() {
    const uint blocks_x = (width + block_dims.x - 1) / block_dims.x;
    const uvec2 block = gl_GlobalInvocationID.xy;
    if (block.x >= blocks_x) {
        return;
    }
    local_buff = astc_data[block.y * blocks_x + block.x];
    DecompressBlock(block * block_dims);
}
