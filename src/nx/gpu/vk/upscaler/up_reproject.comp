// Motion vectors from depth (reproject.c): each render pixel's position this frame, its picture coordinates as -1 to 1
// (x right, y down) and its depth as stored, goes through the caller's matrix to where it was in the frame before, in
// the same terms, and the difference in picture coordinates (0 to 1, the frame before less this one) is stored. The
// camera's motion alone: whatever moves in the scene by itself gets the camera's motion at its pixel
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth;
layout(binding = 1) uniform writeonly image2D motion;
layout(push_constant, row_major) uniform Pass {
    mat4 reproject;
    uvec2 render;
} pass;
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, pass.render))) return;
    vec2 at = (vec2(p) + 0.5) / vec2(pass.render);
    float d = texelFetch(depth, ivec2(p), 0).r;
    vec4 before = pass.reproject * vec4(at * 2.0 - 1.0, d, 1.0);
    vec2 was = abs(before.w) > 1e-6 ? before.xy / before.w * 0.5 + 0.5 : at;
    imageStore(motion, ivec2(p), vec4(was - at, 0.0, 0.0));
}
