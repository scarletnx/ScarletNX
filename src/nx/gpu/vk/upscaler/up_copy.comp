// The upscalers' filtered copy (upscaler.h's SNX_UPSCALER_COPY): each output pixel samples the picture's rectangle
// (render, from the corner of an image of size) bilinearly at its centre, kept half a texel inside the rectangle so
// that nothing past it bleeds in
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D picture;
layout(binding = 1) uniform writeonly image2D result;
layout(push_constant) uniform Pass {
    uvec2 render, size, output_size;
    float sharpness, pad;
} pass;
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, pass.output_size))) return;
    vec2 at = (vec2(p) + 0.5) * vec2(pass.render) / vec2(pass.output_size);
    at = clamp(at, vec2(0.5), vec2(pass.render) - 0.5);
    imageStore(result, ivec2(p), textureLod(picture, at / vec2(pass.size), 0.0));
}
