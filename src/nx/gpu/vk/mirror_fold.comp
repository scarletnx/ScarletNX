/* A dispatch's write log (shader.h's SH_WLOG_*: a part of a flag for each 4 KiB window of a global buffer, then a bit
   for each of its bytes) into the GPU mirror's mask (vk/mirror.c), a bit for each byte of guest memory, where the
   buffer is in the mirror: the submit's harvest then lands the bytes the program wrote and no others. The part is
   left clear for the next dispatch that takes the log (vk/writelog.c): only the windows written are read and zeroed,
   where filling the whole log after each dispatch wrote 2 MiB a part.
   A thread a window's flag: the flagged ones of a workgroup's 128 are listed, and its threads then take each listed
   window a mask word each, zeroing it, its bits past the buffer's length dropped and the rest ORed into the mirror's
   mask at the buffer's place, shifted by its place in a mask word. Every window of the part is looked at, past the
   buffer's length too: a store there is logged (its window clamped to the last, shader/write_log.c) and has to be
   cleared. The part's coarse words (a word for each 64 windows, after its masks) are all zeroed, two a workgroup, as
   every flag of the part is. Two buffers of one dispatch can overlap, so the ORs are atomic. CMake compiles it into SPIR-V at build time
   (cmake/glsl.cmake). */
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer Log {
    uint log_words[]; /* the dispatch's whole log */
};
layout(std430, set = 0, binding = 1) buffer Mask {
    uint mask[]; /* the mirror's mask, from a word before the buffer's first byte */
};
layout(push_constant) uniform Params {
    uint flags; /* the part's window flags, in words of the log */
    uint masks; /* the part's mask words, 128 a window */
    uint base;  /* the mask word of the buffer's first byte */
    uint shift; /* that byte's bit in it */
    uint len;   /* the buffer's bytes */
};

shared uint written[128]; /* the workgroup's windows flagged */
shared uint nwritten;

void main() {
    uint t = gl_LocalInvocationID.x, j = gl_WorkGroupID.x * 128u + t;
    if (t == 0u) nwritten = 0u;
    memoryBarrierShared();
    barrier();
    if (t < 2u) log_words[masks + 4096u * 128u + gl_WorkGroupID.x * 2u + t] = 0u;
    if (log_words[flags + j] != 0u) {
        log_words[flags + j] = 0u;
        written[atomicAdd(nwritten, 1u)] = j;
    }
    memoryBarrierShared();
    barrier();
    uint n = nwritten;
    for (uint k = 0u; k < n; k++) {
        uint w = written[k], at = w * 4096u + t * 32u; /* the byte of bit 0 of this thread's word, in the buffer */
        uint m = log_words[masks + w * 128u + t];
        if (m == 0u) continue;
        log_words[masks + w * 128u + t] = 0u;
        if (at >= len) continue;
        if (len - at < 32u) m &= (1u << (len - at)) - 1u;
        if (m == 0u) continue;
        uint mw = base + w * 128u + t;
        atomicOr(mask[mw], m << shift);
        if (shift != 0u) {
            uint hi = m >> (32u - shift);
            if (hi != 0u) atomicOr(mask[mw + 1u], hi);
        }
    }
}
