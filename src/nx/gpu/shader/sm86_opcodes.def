   Encodings from Mesa's NAK (src/nouveau/compiler/nak/sm70_encode.rs), the encoder of SM70 to SM89:
   Copyright © 2022 Collabora, Ltd.
   SPDX-License-Identifier: MIT */
/* The SM86 (Volta to Ada, 128-bit) instruction encodings sm86_decode.c decodes, as an X-macro table:
     SM86_OP(NAME, code, kind, forms, "display name")
   kind SM86_K_ALU: an ALU instruction. code is its 9-bit opcode (bits 0-8), and bits 9-11 are the form, which places
     its sources (sm86.h). forms has a bit for each form the opcode takes.
   kind SM86_K_UALU: the same for the uniform datapath (bit 91 set, uniform registers).
   kind SM86_K_FIX: an instruction whose 12 bits 0-11 are the opcode, code. forms is 0.
   NAK's encoder gives every row but these, which the captured programs of an Ounce game use and NAK does not emit:
   FSEL (0x008), R2P (0x004), I2FP (0x045, SM86+), DEPBAR (0x91a) and the surface loads and stores that take their
   handle from a constant buffer (SULD.P 0xb97, SULD.D 0xb99, SUST.P 0xb9b, SUST.D 0xb9d: the bindless codes less one,
   as TEX's 0xb60 is to 0x361). CuAssembler's sm_86 encodings, which nvdisasm named, show all of them but SULD.P
   (github.com/cloudcores/CuAssembler, CuAsm/InsAsmRepos/DefaultInsAsmRepos.sm_86.txt), and I2FP only from sm_86 on.
   Keep the families together: the translator tests the names, not ranges. */
#define SM86_F_B   0x72u /* forms 1, 4, 5 and 6: the second source is b (register, immediate, cbuf, uniform) */
#define SM86_F_ALL 0xfeu /* forms 1 to 7: also a register b with c an immediate, cbuf or uniform register */
#define SM86_F_U   0x16u /* the uniform datapath's forms 1, 2 and 4 */

/* floating point */
SM86_OP(FADD, 0x021, SM86_K_ALU, SM86_F_ALL, "FADD")
SM86_OP(FMUL, 0x020, SM86_K_ALU, SM86_F_B, "FMUL")
SM86_OP(FFMA, 0x023, SM86_K_ALU, SM86_F_ALL, "FFMA")
SM86_OP(FMNMX, 0x009, SM86_K_ALU, SM86_F_B, "FMNMX")
SM86_OP(FSET, 0x00a, SM86_K_ALU, SM86_F_B, "FSET")
SM86_OP(FSETP, 0x00b, SM86_K_ALU, SM86_F_B, "FSETP")
SM86_OP(FSEL, 0x008, SM86_K_ALU, SM86_F_B, "FSEL")
SM86_OP(MUFU, 0x108, SM86_K_ALU, SM86_F_B, "MUFU")
SM86_OP(FSWZADD, 0x822, SM86_K_FIX, 0, "FSWZADD")
SM86_OP(DADD, 0x029, SM86_K_ALU, SM86_F_ALL, "DADD")
SM86_OP(DMUL, 0x028, SM86_K_ALU, SM86_F_B, "DMUL")
SM86_OP(DFMA, 0x02b, SM86_K_ALU, SM86_F_ALL, "DFMA")
SM86_OP(DSETP, 0x02a, SM86_K_ALU, SM86_F_B, "DSETP")
SM86_OP(HADD2, 0x030, SM86_K_ALU, SM86_F_ALL, "HADD2")
SM86_OP(HMUL2, 0x032, SM86_K_ALU, SM86_F_B, "HMUL2")
SM86_OP(HFMA2, 0x031, SM86_K_ALU, SM86_F_ALL, "HFMA2")
SM86_OP(HSET2, 0x033, SM86_K_ALU, SM86_F_B, "HSET2")
SM86_OP(HSETP2, 0x034, SM86_K_ALU, SM86_F_B, "HSETP2")
SM86_OP(HMNMX2, 0x040, SM86_K_ALU, SM86_F_B, "HMNMX2")
/* conversions */
SM86_OP(F2F, 0x104, SM86_K_ALU, SM86_F_B, "F2F")
SM86_OP(F2F64, 0x110, SM86_K_ALU, SM86_F_B, "F2F.F64")
SM86_OP(F2FP, 0x03e, SM86_K_ALU, SM86_F_ALL, "F2FP")
SM86_OP(F2I, 0x105, SM86_K_ALU, SM86_F_B, "F2I")
SM86_OP(F2I64, 0x111, SM86_K_ALU, SM86_F_B, "F2I.64")
SM86_OP(I2F, 0x106, SM86_K_ALU, SM86_F_B, "I2F")
SM86_OP(I2F64, 0x112, SM86_K_ALU, SM86_F_B, "I2F.64")
SM86_OP(I2FP, 0x045, SM86_K_ALU, SM86_F_B, "I2FP")
SM86_OP(FRND, 0x107, SM86_K_ALU, SM86_F_B, "FRND")
SM86_OP(FRND64, 0x113, SM86_K_ALU, SM86_F_B, "FRND.F64")
/* integer */
SM86_OP(IADD3, 0x010, SM86_K_ALU, SM86_F_ALL, "IADD3")
SM86_OP(IMAD, 0x024, SM86_K_ALU, SM86_F_ALL, "IMAD")
SM86_OP(IMAD_WIDE, 0x025, SM86_K_ALU, SM86_F_ALL, "IMAD.WIDE")
/* IMAD.HI (0x027): CuAssembler sm_86 (0x827 its immediate form) */
SM86_OP(IMAD_HI, 0x027, SM86_K_ALU, SM86_F_ALL, "IMAD.HI")
SM86_OP(IDP4, 0x026, SM86_K_ALU, SM86_F_ALL, "IDP4A")
SM86_OP(IMNMX, 0x017, SM86_K_ALU, SM86_F_B, "IMNMX")
SM86_OP(ISETP, 0x00c, SM86_K_ALU, SM86_F_B, "ISETP")
SM86_OP(IABS, 0x013, SM86_K_ALU, SM86_F_B, "IABS")
SM86_OP(LEA, 0x011, SM86_K_ALU, SM86_F_ALL, "LEA")
SM86_OP(LOP3, 0x012, SM86_K_ALU, SM86_F_ALL, "LOP3")
SM86_OP(SHF, 0x019, SM86_K_ALU, SM86_F_ALL, "SHF")
SM86_OP(PRMT, 0x016, SM86_K_ALU, SM86_F_ALL, "PRMT")
SM86_OP(SGXT, 0x01a, SM86_K_ALU, SM86_F_B, "SGXT")
SM86_OP(BMSK, 0x01b, SM86_K_ALU, SM86_F_B, "BMSK")
SM86_OP(BREV, 0x101, SM86_K_ALU, SM86_F_B, "BREV")
SM86_OP(FLO, 0x100, SM86_K_ALU, SM86_F_B, "FLO")
SM86_OP(POPC, 0x109, SM86_K_ALU, SM86_F_B, "POPC")
/* moves and predicates */
SM86_OP(MOV, 0x002, SM86_K_ALU, SM86_F_B, "MOV")
SM86_OP(SEL, 0x007, SM86_K_ALU, SM86_F_B, "SEL")
SM86_OP(R2P, 0x004, SM86_K_ALU, SM86_F_B, "R2P")
/* P2R (0x803) and its uniform UP2UR (0x883): CuAssembler's sm_86 and sm_80 encodings */
SM86_OP(P2R, 0x003, SM86_K_ALU, SM86_F_B, "P2R")
SM86_OP(UP2UR, 0x083, SM86_K_UALU, SM86_F_U, "UP2UR")
SM86_OP(PLOP3, 0x81c, SM86_K_FIX, 0, "PLOP3")
SM86_OP(UPLOP3, 0x89c, SM86_K_FIX, 0, "UPLOP3")
SM86_OP(CS2R, 0x805, SM86_K_FIX, 0, "CS2R")
SM86_OP(S2R, 0x919, SM86_K_FIX, 0, "S2R")
SM86_OP(S2UR, 0x9c3, SM86_K_FIX, 0, "S2UR")
SM86_OP(R2UR, 0x3c2, SM86_K_FIX, 0, "R2UR")
/* NAK encodes UMOV as a uniform ALU instruction: form 4 an immediate (0x882), form 6 a uniform register (0xc82) */
SM86_OP(UMOV, 0x082, SM86_K_UALU, 0x50u, "UMOV")
SM86_OP(REDUX, 0x3c4, SM86_K_FIX, 0, "REDUX")
SM86_OP(VOTE, 0x806, SM86_K_FIX, 0, "VOTE")
SM86_OP(UVOTE, 0x886, SM86_K_FIX, 0, "VOTEU")
SM86_OP(MATCH, 0x3a1, SM86_K_FIX, 0, "MATCH")
SM86_OP(SHFL_RR, 0x389, SM86_K_FIX, 0, "SHFL (reg, reg)")
SM86_OP(SHFL_RI, 0x589, SM86_K_FIX, 0, "SHFL (reg, imm)")
SM86_OP(SHFL_IR, 0x989, SM86_K_FIX, 0, "SHFL (imm, reg)")
SM86_OP(SHFL_II, 0xf89, SM86_K_FIX, 0, "SHFL (imm, imm)")
/* the uniform datapath */
SM86_OP(UIADD3, 0x090, SM86_K_UALU, SM86_F_U, "UIADD3")
SM86_OP(UIMAD, 0x0a4, SM86_K_UALU, SM86_F_U, "UIMAD")
SM86_OP(UIMAD_WIDE, 0x0a5, SM86_K_UALU, SM86_F_U, "UIMAD.WIDE")
SM86_OP(ULEA, 0x091, SM86_K_UALU, SM86_F_U, "ULEA")
SM86_OP(ULOP3, 0x092, SM86_K_UALU, SM86_F_U, "ULOP3")
SM86_OP(USHF, 0x099, SM86_K_UALU, SM86_F_U, "USHF")
SM86_OP(UPRMT, 0x096, SM86_K_UALU, SM86_F_U, "UPRMT")
SM86_OP(USEL, 0x087, SM86_K_UALU, SM86_F_U, "USEL")
SM86_OP(UISETP, 0x08c, SM86_K_UALU, SM86_F_U, "UISETP")
SM86_OP(UIMNMX, 0x085, SM86_K_UALU, SM86_F_U, "UIMNMX")
SM86_OP(USGXT, 0x09a, SM86_K_UALU, SM86_F_U, "USGXT")
SM86_OP(UBMSK, 0x09b, SM86_K_UALU, SM86_F_U, "UBMSK")
SM86_OP(UFLO, 0x0bd, SM86_K_UALU, SM86_F_U, "UFLO")
SM86_OP(UBREV, 0x0be, SM86_K_UALU, SM86_F_U, "UBREV")
SM86_OP(UPOPC, 0x0bf, SM86_K_UALU, SM86_F_U, "UPOPC")
SM86_OP(UIABS, 0x04d, SM86_K_UALU, SM86_F_U, "UIABS")
SM86_OP(UF2FP, 0x0ba, SM86_K_UALU, SM86_F_U, "UF2FP")
/* memory */
SM86_OP(LDG, 0x981, SM86_K_FIX, 0, "LDG")
SM86_OP(LDG_NOU, 0x381, SM86_K_FIX, 0, "LDG (no uniform)")
SM86_OP(LDL, 0x983, SM86_K_FIX, 0, "LDL")
SM86_OP(LDS, 0x984, SM86_K_FIX, 0, "LDS")
SM86_OP(STG, 0x986, SM86_K_FIX, 0, "STG")
SM86_OP(STG_NOU, 0x386, SM86_K_FIX, 0, "STG (no uniform)")
SM86_OP(STL, 0x987, SM86_K_FIX, 0, "STL")
SM86_OP(STL_NOU, 0x387, SM86_K_FIX, 0, "STL (no uniform)")
SM86_OP(STS, 0x988, SM86_K_FIX, 0, "STS")
SM86_OP(STS_NOU, 0x388, SM86_K_FIX, 0, "STS (no uniform)")
SM86_OP(LDC, 0xb82, SM86_K_FIX, 0, "LDC")
SM86_OP(LDC_BINDLESS, 0x582, SM86_K_FIX, 0, "LDC (bindless)")
SM86_OP(ULDC, 0xab9, SM86_K_FIX, 0, "ULDC")
/* ULDC UR, c[bank][UR + offset]: the uniform register at 24, the offset signed (CuAssembler sm_86, cAURI) */
SM86_OP(ULDC_IDX, 0xabb, SM86_K_FIX, 0, "ULDC (indexed)")
SM86_OP(ULDCG, 0x8b8, SM86_K_FIX, 0, "ULDC (global)")
SM86_OP(RED, 0x98e, SM86_K_FIX, 0, "RED")
SM86_OP(ATOMG, 0x9a8, SM86_K_FIX, 0, "ATOMG")
SM86_OP(ATOMG_NOU, 0x3a8, SM86_K_FIX, 0, "ATOMG (no uniform)")
SM86_OP(ATOMG_CAS, 0x3a9, SM86_K_FIX, 0, "ATOMG.CAS")
SM86_OP(ATOMS, 0x98c, SM86_K_FIX, 0, "ATOMS")
SM86_OP(ATOMS_NOU, 0x38c, SM86_K_FIX, 0, "ATOMS (no uniform)")
SM86_OP(ATOMS_CAS, 0x38d, SM86_K_FIX, 0, "ATOMS.CAS")
SM86_OP(CCTL, 0x98f, SM86_K_FIX, 0, "CCTL")
SM86_OP(MEMBAR, 0x992, SM86_K_FIX, 0, "MEMBAR")
/* attributes and the stage's own memory */
SM86_OP(ALD, 0x321, SM86_K_FIX, 0, "ALD")
SM86_OP(AST, 0x322, SM86_K_FIX, 0, "AST")
SM86_OP(AL2P, 0x920, SM86_K_FIX, 0, "AL2P")
SM86_OP(IPA, 0x326, SM86_K_FIX, 0, "IPA")
SM86_OP(LDTRAM, 0x3ad, SM86_K_FIX, 0, "LDTRAM")
SM86_OP(ISBERD, 0x923, SM86_K_FIX, 0, "ISBERD")
SM86_OP(ISBEWR, 0x927, SM86_K_FIX, 0, "ISBEWR")
SM86_OP(PIXLD, 0x925, SM86_K_FIX, 0, "PIXLD")
SM86_OP(OUT, 0x124, SM86_K_ALU, SM86_F_B, "OUT")
/* textures and surfaces: the handle in a constant buffer, or bindless (.B, in a register) */
SM86_OP(TEX, 0xb60, SM86_K_FIX, 0, "TEX")
SM86_OP(TEX_B, 0x361, SM86_K_FIX, 0, "TEX.B")
SM86_OP(TLD, 0xb66, SM86_K_FIX, 0, "TLD")
SM86_OP(TLD_B, 0x367, SM86_K_FIX, 0, "TLD.B")
SM86_OP(TLD4, 0xb63, SM86_K_FIX, 0, "TLD4")
SM86_OP(TLD4_B, 0x364, SM86_K_FIX, 0, "TLD4.B")
SM86_OP(TMML, 0xb69, SM86_K_FIX, 0, "TMML")
SM86_OP(TMML_B, 0x36a, SM86_K_FIX, 0, "TMML.B")
SM86_OP(TXD, 0xb6c, SM86_K_FIX, 0, "TXD")
SM86_OP(TXD_B, 0x36d, SM86_K_FIX, 0, "TXD.B")
SM86_OP(TXQ, 0xb6f, SM86_K_FIX, 0, "TXQ")
SM86_OP(TXQ_B, 0x370, SM86_K_FIX, 0, "TXQ.B")
SM86_OP(SULD_P, 0xb97, SM86_K_FIX, 0, "SULD.P")
SM86_OP(SULD_P_B, 0x998, SM86_K_FIX, 0, "SULD.P.B")
SM86_OP(SULD_D, 0xb99, SM86_K_FIX, 0, "SULD.D")
SM86_OP(SULD_D_B, 0x99a, SM86_K_FIX, 0, "SULD.D.B")
SM86_OP(SUST_P, 0xb9b, SM86_K_FIX, 0, "SUST.P")
SM86_OP(SUST_D, 0xb9d, SM86_K_FIX, 0, "SUST.D")
SM86_OP(SUST_P_B, 0x99c, SM86_K_FIX, 0, "SUST.P.B")
SM86_OP(SUST_D_B, 0x99e, SM86_K_FIX, 0, "SUST.D.B")
SM86_OP(SURED_B, 0x3a0, SM86_K_FIX, 0, "SURED.B")
/* SURED with the handle in a constant buffer: no source names 0x59f. The bindless 0x3a0 plus 0x1ff, as 0x998 is to
   0xb97, and its fields (the handle at 40-58, the dimension, ADD, U32) agree in a game's program */
SM86_OP(SURED, 0x59f, SM86_K_FIX, 0, "SURED")
SM86_OP(SUATOM_B, 0x394, SM86_K_FIX, 0, "SUATOM.B")
SM86_OP(SUATOM_CAS_B, 0x396, SM86_K_FIX, 0, "SUATOM.CAS.B")
/* control flow: convergence barriers (BSSY, BSYNC, BREAK, BMOV) in place of Maxwell's CRS stack */
SM86_OP(BRA, 0x947, SM86_K_FIX, 0, "BRA")
/* CALL.REL (0x944), RET.REL (0x950) and BRX (0x949): CuAssembler's sm_86 encodings */
SM86_OP(CALL, 0x944, SM86_K_FIX, 0, "CALL")
SM86_OP(RET, 0x950, SM86_K_FIX, 0, "RET")
SM86_OP(BRX, 0x949, SM86_K_FIX, 0, "BRX")
SM86_OP(UBRA, 0x547, SM86_K_FIX, 0, "BRA.U")
SM86_OP(EXIT, 0x94d, SM86_K_FIX, 0, "EXIT")
SM86_OP(BSSY, 0x945, SM86_K_FIX, 0, "BSSY")
SM86_OP(BSYNC, 0x941, SM86_K_FIX, 0, "BSYNC")
SM86_OP(BREAK, 0x942, SM86_K_FIX, 0, "BREAK")
SM86_OP(BMOV_R, 0x355, SM86_K_FIX, 0, "BMOV (to register)")
SM86_OP(BMOV_B, 0x356, SM86_K_FIX, 0, "BMOV (to barrier)")
SM86_OP(WARPSYNC, 0x148, SM86_K_ALU, SM86_F_B, "WARPSYNC")
SM86_OP(KILL, 0x95b, SM86_K_FIX, 0, "KILL")
SM86_OP(BAR, 0xb1d, SM86_K_FIX, 0, "BAR")
SM86_OP(NOP, 0x918, SM86_K_FIX, 0, "NOP")
/* ERRBAR (0x9ab): CuAssembler sm_86 */
SM86_OP(ERRBAR, 0x9ab, SM86_K_FIX, 0, "ERRBAR")
SM86_OP(DEPBAR, 0x91a, SM86_K_FIX, 0, "DEPBAR")
SM86_OP(NANOSLEEP, 0x15d, SM86_K_ALU, SM86_F_B, "NANOSLEEP")
