/* The SM70+ (Volta to Ada, 128-bit) instruction encodings sm70_decode.c decodes, as an X-macro table:
     SM70_OP(NAME, code, kind, forms, "display name")
   kind SM70_K_ALU: an ALU instruction. code is its 9-bit opcode (bits 0-8), and bits 9-11 are the form, which places
     its sources (sm70.h). forms has a bit for each form the opcode takes.
   kind SM70_K_UALU: the same for the uniform datapath (bit 91 set, uniform registers).
   kind SM70_K_FIX: an instruction whose 12 bits 0-11 are the opcode, code. forms is 0.
   NAK's encoder gives every row but these, which the captured programs of a Switch 2 game use and NAK does not emit:
   FSEL (0x008), R2P (0x004), I2FP (0x045, SM86+), DEPBAR (0x91a) and the surface loads and stores that take their
   handle from a constant buffer (SULD.P 0xb97, SULD.D 0xb99, SUST.P 0xb9b, SUST.D 0xb9d: the bindless codes less one,
   as TEX's 0xb60 is to 0x361). CuAssembler's sm_86 encodings, which nvdisasm named, show all of them but SULD.P
   (github.com/cloudcores/CuAssembler, CuAsm/InsAsmRepos/DefaultInsAsmRepos.sm_86.txt), and I2FP only from sm_86 on.
   Keep the families together: the translator tests the names, not ranges. */
#define SM70_F_B   0x72u /* forms 1, 4, 5 and 6: the second source is b (register, immediate, cbuf, uniform) */
#define SM70_F_ALL 0xfeu /* forms 1 to 7: also a register b with c an immediate, cbuf or uniform register */
#define SM70_F_U   0x16u /* the uniform datapath's forms 1, 2 and 4 */

/* floating point */
SM70_OP(FADD, 0x021, SM70_K_ALU, SM70_F_ALL, "FADD")
SM70_OP(FMUL, 0x020, SM70_K_ALU, SM70_F_B, "FMUL")
SM70_OP(FFMA, 0x023, SM70_K_ALU, SM70_F_ALL, "FFMA")
SM70_OP(FMNMX, 0x009, SM70_K_ALU, SM70_F_B, "FMNMX")
SM70_OP(FSET, 0x00a, SM70_K_ALU, SM70_F_B, "FSET")
SM70_OP(FSETP, 0x00b, SM70_K_ALU, SM70_F_B, "FSETP")
SM70_OP(FSEL, 0x008, SM70_K_ALU, SM70_F_B, "FSEL")
SM70_OP(MUFU, 0x108, SM70_K_ALU, SM70_F_B, "MUFU")
SM70_OP(FSWZADD, 0x822, SM70_K_FIX, 0, "FSWZADD")
SM70_OP(DADD, 0x029, SM70_K_ALU, SM70_F_ALL, "DADD")
SM70_OP(DMUL, 0x028, SM70_K_ALU, SM70_F_B, "DMUL")
SM70_OP(DFMA, 0x02b, SM70_K_ALU, SM70_F_ALL, "DFMA")
SM70_OP(DSETP, 0x02a, SM70_K_ALU, SM70_F_B, "DSETP")
SM70_OP(HADD2, 0x030, SM70_K_ALU, SM70_F_ALL, "HADD2")
SM70_OP(HMUL2, 0x032, SM70_K_ALU, SM70_F_B, "HMUL2")
SM70_OP(HFMA2, 0x031, SM70_K_ALU, SM70_F_ALL, "HFMA2")
SM70_OP(HSET2, 0x033, SM70_K_ALU, SM70_F_B, "HSET2")
SM70_OP(HSETP2, 0x034, SM70_K_ALU, SM70_F_B, "HSETP2")
SM70_OP(HMNMX2, 0x040, SM70_K_ALU, SM70_F_B, "HMNMX2")
/* conversions */
SM70_OP(F2F, 0x104, SM70_K_ALU, SM70_F_B, "F2F")
SM70_OP(F2F64, 0x110, SM70_K_ALU, SM70_F_B, "F2F.F64")
SM70_OP(F2FP, 0x03e, SM70_K_ALU, SM70_F_ALL, "F2FP")
SM70_OP(F2I, 0x105, SM70_K_ALU, SM70_F_B, "F2I")
SM70_OP(F2I64, 0x111, SM70_K_ALU, SM70_F_B, "F2I.64")
SM70_OP(I2F, 0x106, SM70_K_ALU, SM70_F_B, "I2F")
SM70_OP(I2F64, 0x112, SM70_K_ALU, SM70_F_B, "I2F.64")
SM70_OP(I2FP, 0x045, SM70_K_ALU, SM70_F_B, "I2FP")
SM70_OP(FRND, 0x107, SM70_K_ALU, SM70_F_B, "FRND")
SM70_OP(FRND64, 0x113, SM70_K_ALU, SM70_F_B, "FRND.F64")
/* integer */
SM70_OP(IADD3, 0x010, SM70_K_ALU, SM70_F_ALL, "IADD3")
SM70_OP(IMAD, 0x024, SM70_K_ALU, SM70_F_ALL, "IMAD")
SM70_OP(IMAD_WIDE, 0x025, SM70_K_ALU, SM70_F_ALL, "IMAD.WIDE")
/* IMAD.HI (0x027): CuAssembler sm_86 (0x827 its immediate form) */
SM70_OP(IMAD_HI, 0x027, SM70_K_ALU, SM70_F_ALL, "IMAD.HI")
SM70_OP(IDP4, 0x026, SM70_K_ALU, SM70_F_ALL, "IDP4A")
SM70_OP(IMNMX, 0x017, SM70_K_ALU, SM70_F_B, "IMNMX")
SM70_OP(ISETP, 0x00c, SM70_K_ALU, SM70_F_B, "ISETP")
SM70_OP(IABS, 0x013, SM70_K_ALU, SM70_F_B, "IABS")
SM70_OP(LEA, 0x011, SM70_K_ALU, SM70_F_ALL, "LEA")
SM70_OP(LOP3, 0x012, SM70_K_ALU, SM70_F_ALL, "LOP3")
SM70_OP(SHF, 0x019, SM70_K_ALU, SM70_F_ALL, "SHF")
SM70_OP(PRMT, 0x016, SM70_K_ALU, SM70_F_ALL, "PRMT")
SM70_OP(SGXT, 0x01a, SM70_K_ALU, SM70_F_B, "SGXT")
SM70_OP(BMSK, 0x01b, SM70_K_ALU, SM70_F_B, "BMSK")
SM70_OP(BREV, 0x101, SM70_K_ALU, SM70_F_B, "BREV")
SM70_OP(FLO, 0x100, SM70_K_ALU, SM70_F_B, "FLO")
SM70_OP(POPC, 0x109, SM70_K_ALU, SM70_F_B, "POPC")
/* moves and predicates */
SM70_OP(MOV, 0x002, SM70_K_ALU, SM70_F_B, "MOV")
SM70_OP(SEL, 0x007, SM70_K_ALU, SM70_F_B, "SEL")
SM70_OP(R2P, 0x004, SM70_K_ALU, SM70_F_B, "R2P")
/* P2R (0x803) and its uniform UP2UR (0x883): CuAssembler's sm_86 and sm_80 encodings */
SM70_OP(P2R, 0x003, SM70_K_ALU, SM70_F_B, "P2R")
SM70_OP(UP2UR, 0x083, SM70_K_UALU, SM70_F_U, "UP2UR")
SM70_OP(PLOP3, 0x81c, SM70_K_FIX, 0, "PLOP3")
SM70_OP(UPLOP3, 0x89c, SM70_K_FIX, 0, "UPLOP3")
SM70_OP(CS2R, 0x805, SM70_K_FIX, 0, "CS2R")
SM70_OP(S2R, 0x919, SM70_K_FIX, 0, "S2R")
SM70_OP(S2UR, 0x9c3, SM70_K_FIX, 0, "S2UR")
SM70_OP(R2UR, 0x3c2, SM70_K_FIX, 0, "R2UR")
/* NAK encodes UMOV as a uniform ALU instruction: form 4 an immediate (0x882), form 6 a uniform register (0xc82) */
SM70_OP(UMOV, 0x082, SM70_K_UALU, 0x50u, "UMOV")
SM70_OP(REDUX, 0x3c4, SM70_K_FIX, 0, "REDUX")
SM70_OP(VOTE, 0x806, SM70_K_FIX, 0, "VOTE")
SM70_OP(UVOTE, 0x886, SM70_K_FIX, 0, "VOTEU")
SM70_OP(MATCH, 0x3a1, SM70_K_FIX, 0, "MATCH")
SM70_OP(SHFL_RR, 0x389, SM70_K_FIX, 0, "SHFL (reg, reg)")
SM70_OP(SHFL_RI, 0x589, SM70_K_FIX, 0, "SHFL (reg, imm)")
SM70_OP(SHFL_IR, 0x989, SM70_K_FIX, 0, "SHFL (imm, reg)")
SM70_OP(SHFL_II, 0xf89, SM70_K_FIX, 0, "SHFL (imm, imm)")
/* the uniform datapath */
SM70_OP(UIADD3, 0x090, SM70_K_UALU, SM70_F_U, "UIADD3")
SM70_OP(UIMAD, 0x0a4, SM70_K_UALU, SM70_F_U, "UIMAD")
SM70_OP(UIMAD_WIDE, 0x0a5, SM70_K_UALU, SM70_F_U, "UIMAD.WIDE")
SM70_OP(ULEA, 0x091, SM70_K_UALU, SM70_F_U, "ULEA")
SM70_OP(ULOP3, 0x092, SM70_K_UALU, SM70_F_U, "ULOP3")
SM70_OP(USHF, 0x099, SM70_K_UALU, SM70_F_U, "USHF")
SM70_OP(UPRMT, 0x096, SM70_K_UALU, SM70_F_U, "UPRMT")
SM70_OP(USEL, 0x087, SM70_K_UALU, SM70_F_U, "USEL")
SM70_OP(UISETP, 0x08c, SM70_K_UALU, SM70_F_U, "UISETP")
SM70_OP(UIMNMX, 0x085, SM70_K_UALU, SM70_F_U, "UIMNMX")
SM70_OP(USGXT, 0x09a, SM70_K_UALU, SM70_F_U, "USGXT")
SM70_OP(UBMSK, 0x09b, SM70_K_UALU, SM70_F_U, "UBMSK")
SM70_OP(UFLO, 0x0bd, SM70_K_UALU, SM70_F_U, "UFLO")
SM70_OP(UBREV, 0x0be, SM70_K_UALU, SM70_F_U, "UBREV")
SM70_OP(UPOPC, 0x0bf, SM70_K_UALU, SM70_F_U, "UPOPC")
SM70_OP(UIABS, 0x04d, SM70_K_UALU, SM70_F_U, "UIABS")
SM70_OP(UF2FP, 0x0ba, SM70_K_UALU, SM70_F_U, "UF2FP")
/* memory */
SM70_OP(LDG, 0x981, SM70_K_FIX, 0, "LDG")
SM70_OP(LDG_NOU, 0x381, SM70_K_FIX, 0, "LDG (no uniform)")
SM70_OP(LDL, 0x983, SM70_K_FIX, 0, "LDL")
SM70_OP(LDS, 0x984, SM70_K_FIX, 0, "LDS")
SM70_OP(STG, 0x986, SM70_K_FIX, 0, "STG")
SM70_OP(STG_NOU, 0x386, SM70_K_FIX, 0, "STG (no uniform)")
SM70_OP(STL, 0x987, SM70_K_FIX, 0, "STL")
SM70_OP(STL_NOU, 0x387, SM70_K_FIX, 0, "STL (no uniform)")
SM70_OP(STS, 0x988, SM70_K_FIX, 0, "STS")
SM70_OP(STS_NOU, 0x388, SM70_K_FIX, 0, "STS (no uniform)")
SM70_OP(LDC, 0xb82, SM70_K_FIX, 0, "LDC")
SM70_OP(LDC_BINDLESS, 0x582, SM70_K_FIX, 0, "LDC (bindless)")
SM70_OP(ULDC, 0xab9, SM70_K_FIX, 0, "ULDC")
/* ULDC UR, c[bank][UR + offset]: the uniform register at 24, the offset signed (CuAssembler sm_86, cAURI) */
SM70_OP(ULDC_IDX, 0xabb, SM70_K_FIX, 0, "ULDC (indexed)")
SM70_OP(ULDCG, 0x8b8, SM70_K_FIX, 0, "ULDC (global)")
SM70_OP(RED, 0x98e, SM70_K_FIX, 0, "RED")
SM70_OP(ATOMG, 0x9a8, SM70_K_FIX, 0, "ATOMG")
SM70_OP(ATOMG_NOU, 0x3a8, SM70_K_FIX, 0, "ATOMG (no uniform)")
SM70_OP(ATOMG_CAS, 0x3a9, SM70_K_FIX, 0, "ATOMG.CAS")
SM70_OP(ATOMS, 0x98c, SM70_K_FIX, 0, "ATOMS")
SM70_OP(ATOMS_NOU, 0x38c, SM70_K_FIX, 0, "ATOMS (no uniform)")
SM70_OP(ATOMS_CAS, 0x38d, SM70_K_FIX, 0, "ATOMS.CAS")
SM70_OP(CCTL, 0x98f, SM70_K_FIX, 0, "CCTL")
SM70_OP(MEMBAR, 0x992, SM70_K_FIX, 0, "MEMBAR")
/* attributes and the stage's own memory */
SM70_OP(ALD, 0x321, SM70_K_FIX, 0, "ALD")
SM70_OP(AST, 0x322, SM70_K_FIX, 0, "AST")
SM70_OP(AL2P, 0x920, SM70_K_FIX, 0, "AL2P")
SM70_OP(IPA, 0x326, SM70_K_FIX, 0, "IPA")
SM70_OP(LDTRAM, 0x3ad, SM70_K_FIX, 0, "LDTRAM")
SM70_OP(ISBERD, 0x923, SM70_K_FIX, 0, "ISBERD")
SM70_OP(ISBEWR, 0x927, SM70_K_FIX, 0, "ISBEWR")
SM70_OP(PIXLD, 0x925, SM70_K_FIX, 0, "PIXLD")
SM70_OP(OUT, 0x124, SM70_K_ALU, SM70_F_B, "OUT")
/* textures and surfaces: the handle in a constant buffer, or bindless (.B, in a register) */
SM70_OP(TEX, 0xb60, SM70_K_FIX, 0, "TEX")
SM70_OP(TEX_B, 0x361, SM70_K_FIX, 0, "TEX.B")
SM70_OP(TLD, 0xb66, SM70_K_FIX, 0, "TLD")
SM70_OP(TLD_B, 0x367, SM70_K_FIX, 0, "TLD.B")
SM70_OP(TLD4, 0xb63, SM70_K_FIX, 0, "TLD4")
SM70_OP(TLD4_B, 0x364, SM70_K_FIX, 0, "TLD4.B")
SM70_OP(TMML, 0xb69, SM70_K_FIX, 0, "TMML")
SM70_OP(TMML_B, 0x36a, SM70_K_FIX, 0, "TMML.B")
SM70_OP(TXD, 0xb6c, SM70_K_FIX, 0, "TXD")
SM70_OP(TXD_B, 0x36d, SM70_K_FIX, 0, "TXD.B")
SM70_OP(TXQ, 0xb6f, SM70_K_FIX, 0, "TXQ")
SM70_OP(TXQ_B, 0x370, SM70_K_FIX, 0, "TXQ.B")
SM70_OP(SULD_P, 0xb97, SM70_K_FIX, 0, "SULD.P")
SM70_OP(SULD_P_B, 0x998, SM70_K_FIX, 0, "SULD.P.B")
SM70_OP(SULD_D, 0xb99, SM70_K_FIX, 0, "SULD.D")
SM70_OP(SULD_D_B, 0x99a, SM70_K_FIX, 0, "SULD.D.B")
SM70_OP(SUST_P, 0xb9b, SM70_K_FIX, 0, "SUST.P")
SM70_OP(SUST_D, 0xb9d, SM70_K_FIX, 0, "SUST.D")
SM70_OP(SUST_P_B, 0x99c, SM70_K_FIX, 0, "SUST.P.B")
SM70_OP(SUST_D_B, 0x99e, SM70_K_FIX, 0, "SUST.D.B")
SM70_OP(SURED_B, 0x3a0, SM70_K_FIX, 0, "SURED.B")
SM70_OP(SUATOM_B, 0x394, SM70_K_FIX, 0, "SUATOM.B")
SM70_OP(SUATOM_CAS_B, 0x396, SM70_K_FIX, 0, "SUATOM.CAS.B")
/* control flow: convergence barriers (BSSY, BSYNC, BREAK, BMOV) in place of Maxwell's CRS stack */
SM70_OP(BRA, 0x947, SM70_K_FIX, 0, "BRA")
/* CALL.REL (0x944), RET.REL (0x950) and BRX (0x949): CuAssembler's sm_86 encodings */
SM70_OP(CALL, 0x944, SM70_K_FIX, 0, "CALL")
SM70_OP(RET, 0x950, SM70_K_FIX, 0, "RET")
SM70_OP(BRX, 0x949, SM70_K_FIX, 0, "BRX")
SM70_OP(UBRA, 0x547, SM70_K_FIX, 0, "BRA.U")
SM70_OP(EXIT, 0x94d, SM70_K_FIX, 0, "EXIT")
SM70_OP(BSSY, 0x945, SM70_K_FIX, 0, "BSSY")
SM70_OP(BSYNC, 0x941, SM70_K_FIX, 0, "BSYNC")
SM70_OP(BREAK, 0x942, SM70_K_FIX, 0, "BREAK")
SM70_OP(BMOV_R, 0x355, SM70_K_FIX, 0, "BMOV (to register)")
SM70_OP(BMOV_B, 0x356, SM70_K_FIX, 0, "BMOV (to barrier)")
SM70_OP(WARPSYNC, 0x148, SM70_K_ALU, SM70_F_B, "WARPSYNC")
SM70_OP(KILL, 0x95b, SM70_K_FIX, 0, "KILL")
SM70_OP(BAR, 0xb1d, SM70_K_FIX, 0, "BAR")
SM70_OP(NOP, 0x918, SM70_K_FIX, 0, "NOP")
/* ERRBAR (0x9ab): CuAssembler sm_86 */
SM70_OP(ERRBAR, 0x9ab, SM70_K_FIX, 0, "ERRBAR")
SM70_OP(DEPBAR, 0x91a, SM70_K_FIX, 0, "DEPBAR")
SM70_OP(NANOSLEEP, 0x15d, SM70_K_ALU, SM70_F_B, "NANOSLEEP")
