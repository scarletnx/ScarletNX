        0x42 => { let t0 = EOR(x, z); let t1 = EOR(y, z); let t2 = t0 & t1; t2 },
        0x43 => { let t0 = not_vec(x); let t1 = y & z; let t2 = t0 | t1; let t3 = EOR(y, t2); t3 },
        0x44 => { let t0 = y & z; let t1 = EOR(y, t0); t1 },
        0x45 => { let t0 = not_vec(x); let t1 = y | z; let t2 = t0 | t1; let t3 = EOR(z, t2); t3 },
        0x46 => { let t0 = x & z; let t1 = y | t0; let t2 = EOR(z, t1); t2 },
        0x47 => { let t0 = not_vec(x); let t1 = EOR(x, z); let t2 = y & t1; let t3 = EOR(t0, t2); t3 },
        0x48 => { let t0 = EOR(x, z); let t1 = y & t0; t1 },
        0x49 => { let t0 = not_vec(x); let t1 = x & z; let t2 = EOR(y, t0); let t3 = t1 | t2; let t4 = EOR(z, t3); t4 },
        0x4a => { let t0 = EOR(x, z); let t1 = y | z; let t2 = t0 & t1; t2 },
        0x4b => { let t0 = not_vec(y); let t1 = z | t0; let t2 = EOR(x, t1); t2 },
        0x4c => { let t0 = x & y; let t1 = z & t0; let t2 = EOR(y, t1); t2 },
