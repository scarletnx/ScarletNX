/* Generated by tools/lut3gen.py: do not edit. Every truth table of three inputs as the shortest straight-line
   program of AND, OR, XOR and NOT of the inputs (784 operations for the 256, fewest NOTs among the
   shortest): x is the 0xf0 input, y 0xcc and z 0xaa, and bit 4x + 2y + z of lut the result for those bits.
   gpu.sail's Lut3 (of a word's bits) and Lut3Bool (of bools), which LOP3 and PLOP3 take; tests/shader_sail_sm86.c
   checks every table whole */

function Lut3(lut : bits(8), x : bits(32), y : bits(32), z : bits(32)) -> bits(32) =
    match lut {
        0x00 => 0x00000000,
        0x01 => { let t0 = x | y; let t1 = z | t0; let t2 = not_vec(t1); t2 },
        0x02 => { let t0 = x | y; let t1 = z & t0; let t2 = EOR(z, t1); t2 },
        0x03 => { let t0 = x | y; let t1 = not_vec(t0); t1 },
        0x04 => { let t0 = x | z; let t1 = y & t0; let t2 = EOR(y, t1); t2 },
        0x05 => { let t0 = x | z; let t1 = not_vec(t0); t1 },
        0x06 => { let t0 = x | y; let t1 = x | z; let t2 = EOR(t0, t1); t2 },
        0x07 => { let t0 = y & z; let t1 = x | t0; let t2 = not_vec(t1); t2 },
        0x08 => { let t0 = x & y; let t1 = EOR(y, t0); let t2 = z & t1; t2 },
        0x09 => { let t0 = EOR(y, z); let t1 = x | t0; let t2 = not_vec(t1); t2 },
        0x0a => { let t0 = x & z; let t1 = EOR(z, t0); t1 },
        0x0b => { let t0 = not_vec(x); let t1 = EOR(y, t0); let t2 = z | t1; let t3 = t0 & t2; t3 },
        0x0c => { let t0 = x & y; let t1 = EOR(y, t0); t1 },
        0x0d => { let t0 = not_vec(x); let t1 = EOR(z, t0); let t2 = y | t1; let t3 = t0 & t2; t3 },
        0x0e => { let t0 = x | y; let t1 = z | t0; let t2 = EOR(x, t1); t2 },
        0x0f => not_vec(x),
        0x10 => { let t0 = y | z; let t1 = x & t0; let t2 = EOR(x, t1); t2 },
        0x11 => { let t0 = y | z; let t1 = not_vec(t0); t1 },
        0x12 => { let t0 = x | y; let t1 = y | z; let t2 = EOR(t0, t1); t2 },
        0x13 => { let t0 = x & z; let t1 = y | t0; let t2 = not_vec(t1); t2 },
        0x14 => { let t0 = EOR(x, y); let t1 = z & t0; let t2 = EOR(t0, t1); t2 },
        0x15 => { let t0 = x & y; let t1 = z | t0; let t2 = not_vec(t1); t2 },
        0x16 => { let t0 = x & y; let t1 = x | y; let t2 = z | t0; let t3 = EOR(t1, t2); t3 },
        0x17 => { let t0 = not_vec(x); let t1 = x | y; let t2 = EOR(y, t0); let t3 = z | t2; let t4 = EOR(t1, t3); t4 },
        0x18 => { let t0 = EOR(x, y); let t1 = EOR(x, z); let t2 = t0 & t1; t2 },
        0x19 => { let t0 = x & y; let t1 = EOR(y, z); let t2 = t0 | t1; let t3 = not_vec(t2); t3 },
        0x1a => { let t0 = x & y; let t1 = z | t0; let t2 = EOR(x, t1); t2 },
        0x1b => { let t0 = not_vec(x); let t1 = EOR(y, t0); let t2 = z | t1; let t3 = EOR(x, t2); t3 },
        0x1c => { let t0 = x & z; let t1 = y | t0; let t2 = EOR(x, t1); t2 },
        0x1d => { let t0 = not_vec(x); let t1 = EOR(z, t0); let t2 = y | t1; let t3 = EOR(x, t2); t3 },
        0x1e => { let t0 = y | z; let t1 = EOR(x, t0); t1 },
        0x1f => { let t0 = y | z; let t1 = x & t0; let t2 = not_vec(t1); t2 },
        0x20 => { let t0 = x & y; let t1 = EOR(x, t0); let t2 = z & t1; t2 },
        0x21 => { let t0 = EOR(x, z); let t1 = y | t0; let t2 = not_vec(t1); t2 },
