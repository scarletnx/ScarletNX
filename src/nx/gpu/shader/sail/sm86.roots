# The SM86 instructions sm86_translate.c emits from Sail (sailgen --gpu, sm86.sail): "op FN OPCODE..." runs
# execute_FN for each of the decoder's opcodes (sm86.h's SM86_OPS), "fuse FN OPCODE..." the fusion FN of those opcodes
# in a row where FN_ok holds. The back end's functions named static give values the translator knows
prefix sg86
static Field Uniform SrcNeg Dst IsZero SrcIsImm SrcImm FieldAt SrcNegAt IsZeroAt ReadsDstAt
static Form SrcAbs SrcAbsRaw SrcNegRaw SrcIsReg SrcReg OpName FmulOverW Float64 I2fNearest
static DstHasNext SrcIsCbuf InsnIndex Stage Passthrough IsRegZero AtomicOpcode AddressFromMemory GlobalAddress
static MEM_LOCAL HandleIndexed LegacyAddress GeometryOk ImapReads HasHandleSlot

op IADD3 SM86_IADD3 SM86_UIADD3
op IMAD SM86_IMAD SM86_UIMAD
op IMNMX SM86_IMNMX SM86_UIMNMX
op FLO SM86_FLO SM86_UFLO
op POPC SM86_POPC SM86_UPOPC
op BREV SM86_BREV SM86_UBREV
op IABS SM86_IABS
op MOV SM86_MOV
op SEL SM86_SEL SM86_USEL
op LEA SM86_LEA SM86_ULEA
op LOP3 SM86_LOP3 SM86_ULOP3
op SHF SM86_SHF SM86_USHF
op ISETP SM86_ISETP SM86_UISETP
op PLOP3 SM86_PLOP3
op UPLOP3 SM86_UPLOP3
op FADD SM86_FADD
op FMUL SM86_FMUL
op FFMA SM86_FFMA
op FSWZADD SM86_FSWZADD
op FMNMX SM86_FMNMX
op FSET SM86_FSET
op FSETP SM86_FSETP
op HSETP2 SM86_HSETP2
op FSEL SM86_FSEL
op MUFU SM86_MUFU
op F2F SM86_F2F
op F2I64 SM86_F2I64
op I2F64 SM86_I2F64
op F2I SM86_F2I
op F2IP SM86_F2IP
op I2F SM86_I2F SM86_I2FP
op FRND SM86_FRND
op F2FP SM86_F2FP
op IMAD_WIDE SM86_IMAD_WIDE SM86_UIMAD_WIDE
op IMAD_HI SM86_IMAD_HI
op SGXT SM86_SGXT SM86_USGXT
op PRMT SM86_PRMT SM86_UPRMT
op P2R SM86_P2R SM86_UP2UR
op R2P SM86_R2P
op PSETP SM86_PSETP
op CS2R SM86_CS2R
op S2R SM86_S2R
op R2UR SM86_R2UR
op S2UR SM86_S2UR
op UMOV SM86_UMOV
op SHFL_II SM86_SHFL_II
op SHFL_RI SM86_SHFL_RI
op SHFL_IR SM86_SHFL_IR
op SHFL_RR SM86_SHFL_RR
op VOTE SM86_VOTE
op UVOTE SM86_UVOTE
op MATCH SM86_MATCH
op REDUX SM86_REDUX
op NOP SM86_NOP SM86_DEPBAR SM86_BSSY SM86_BSYNC SM86_BREAK SM86_WARPSYNC SM86_ERRBAR
op MEMBAR SM86_MEMBAR
op LEPC SM86_LEPC
op STUB SM86_STUB_SET SM86_STUB_END
op OUT SM86_OUT
op BMOV_R SM86_BMOV_R
op BMOV_BI SM86_BMOV_BI
op BMOV_BL SM86_BMOV_BL
op ATOMG SM86_ATOMG
op ATOMG_NOU SM86_ATOMG_NOU
op RED SM86_RED
op ATOMS SM86_ATOMS SM86_ATOMS_NOU
op ATOMS_POPC_INC SM86_ATOMS_POPC_INC
op HFMA2_MMA SM86_HFMA2_MMA
op HFMA2 SM86_HFMA2
op HMUL2 SM86_HMUL2
op HMNMX2 SM86_HMNMX2
op HADD2 SM86_HADD2
op ULDC_IDX SM86_ULDC_IDX
op ULDC SM86_ULDC
op LDC SM86_LDC
op LDG SM86_LDG
op STG SM86_STG
op LDG_NOU SM86_LDG_NOU
op STG_NOU SM86_STG_NOU
op LDS SM86_LDS
op STS SM86_STS SM86_STS_NOU
op LDL SM86_LDL
op STL SM86_STL SM86_STL_NOU
op ALD SM86_ALD
op AST SM86_AST
op IPA SM86_IPA
op IPA_U SM86_IPA_U
op TEX_U SM86_TEX_U SM86_TLD4_U
op TLD_U SM86_TLD_U
op TXQ_U SM86_TXQ_U
op TXD_U SM86_TXD_U
op TEX SM86_TEX SM86_TEX_B SM86_TLD4 SM86_TMML
op TXD SM86_TXD
op TLD SM86_TLD
op TXQ SM86_TXQ
op TXQ_B SM86_TXQ_B
op SURFACE SM86_SULD_P SM86_SUST_P SM86_SURED SM86_SUATOM
op HMMA SM86_HMMA
op LDSM SM86_LDSM
op LDSM_HMMA SM86_LDSM_HMMA
op MOVM SM86_MOVM
op KILL SM86_KILL
op ISBE SM86_ISBERD SM86_ISBEWR
op BAR SM86_BAR

# IADD3 then IADD3.X: one 64-bit add of 32-bit words
fuse IADD3_WIDE SM86_IADD3 SM86_IADD3
