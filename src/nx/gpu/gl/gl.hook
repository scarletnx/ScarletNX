family object
hook _glGenBuffers(i32 n, addr buffers) = gl_gen_buffers
hook _glCreateBuffers(i32 n, addr buffers) = gl_gen_buffers
hook _glDeleteBuffers(i32 n, addr buffers) = gl_delete_buffers
hook _glIsBuffer(u32 buffer) -> u8 = gl_is_buffer
hook _glBindBuffer(u32 target, u32 buffer) = gl_bind_buffer
hook _glBindBufferBase(u32 target, u32 index, u32 buffer) = gl_bind_buffer_base
hook _glBindBufferRange(u32 target, u32 index, u32 buffer, i64 offset, i64 size) = gl_bind_buffer_range
hook _glBufferData(u32 target, i64 size, addr data, u32 usage) = gl_buffer_data
hook _glNamedBufferData(u32 buffer, i64 size, addr data, u32 usage) = gl_named_buffer_data
hook _glBufferStorage(u32 target, i64 size, addr data, u32 flags) = gl_buffer_storage
hook _glNamedBufferStorage(u32 buffer, i64 size, addr data, u32 flags) = gl_named_buffer_storage
