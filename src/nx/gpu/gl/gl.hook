hook _glUniform4i(i32 location, i32 v0, i32 v1, i32 v2, i32 v3) = gl_uniform4i
hook _glUniform4iv(i32 location, i32 count, addr value) = gl_uniform4iv
hook _glProgramUniform4i(u32 program, i32 location, i32 v0, i32 v1, i32 v2, i32 v3) = gl_program_uniform4i
hook _glProgramUniform4iv(u32 program, i32 location, i32 count, addr value) = gl_program_uniform4iv
hook _glUniform4ui(i32 location, u32 v0, u32 v1, u32 v2, u32 v3) = gl_uniform4ui
hook _glUniform4uiv(i32 location, i32 count, addr value) = gl_uniform4uiv
hook _glProgramUniform4ui(u32 program, i32 location, u32 v0, u32 v1, u32 v2, u32 v3) = gl_program_uniform4ui
hook _glProgramUniform4uiv(u32 program, i32 location, i32 count, addr value) = gl_program_uniform4uiv
hook _glUniformMatrix2fv(i32 location, i32 count, u8 transpose, addr value) = gl_uniform_matrix2
hook _glProgramUniformMatrix2fv(u32 program, i32 location, i32 count, u8 transpose, addr value) = gl_program_uniform_matrix2
hook _glUniformMatrix3fv(i32 location, i32 count, u8 transpose, addr value) = gl_uniform_matrix3
hook _glProgramUniformMatrix3fv(u32 program, i32 location, i32 count, u8 transpose, addr value) = gl_program_uniform_matrix3
hook _glUniformMatrix4fv(i32 location, i32 count, u8 transpose, addr value) = gl_uniform_matrix4
hook _glProgramUniformMatrix4fv(u32 program, i32 location, i32 count, u8 transpose, addr value) = gl_program_uniform_matrix4
hook _glUniformMatrix2x3fv(i32 location, i32 count, u8 transpose, addr value) = gl_uniform_matrix2x3
