#
# The EGL and OpenGL functions the GL layer implements for a game that draws through its own GL driver
# (gpu/gl/gl_loader.c, with gl_layer=1), for tools/hookgen with --prefix gl: hooks.hook's grammar, each function by the
# symbol the driver exports it as (eglInitialize, _glClearColor; eglGetProcAddress answers glClearColor with that
# export's address). Every other egl and _gl export of the driver takes the handler that stops the game, naming
# it. The handlers: gpu/gl/gl_egl.c (EGL), gpu/gl/gl_calls.c (GL, over common/gpu/gl/gl_state.h),
# gpu/gl/gl_program_calls.c (shaders and programs, over common/gpu/gl/gl_program.h).

# EGL functions no hook implements yet, which a game's main calls directly: through their slots, to that handler
route eglBindTexImage
route eglCopyBuffers
route eglCreatePbufferFromClientBuffer
route eglCreatePixmapSurface
route eglReleaseTexImage

family egl
hook eglGetError() -> i32 = gl_egl_get_error
hook eglGetDisplay(addr native) -> addr = gl_egl_get_display
hook eglInitialize(addr dpy, addr major, addr minor) -> u32 = gl_egl_initialize
hook eglTerminate(addr dpy) -> u32 = gl_egl_terminate
hook eglQueryString(addr dpy, i32 name) -> addr = gl_egl_query_string
hook eglBindAPI(u32 api) -> u32 = gl_egl_bind_api
hook eglQueryAPI() -> u32 = gl_egl_query_api
hook eglGetConfigs(addr dpy, addr configs, i32 size, addr count) -> u32 = gl_egl_get_configs
hook eglChooseConfig(addr dpy, addr attribs, addr configs, i32 size, addr count) -> u32 = gl_egl_choose_config
hook eglGetConfigAttrib(addr dpy, addr config, i32 attribute, addr value) -> u32 = gl_egl_get_config_attrib
hook eglCreateContext(addr dpy, addr config, addr share, addr attribs) -> addr = gl_egl_create_context
hook eglDestroyContext(addr dpy, addr context) -> u32 = gl_egl_destroy_context
hook eglQueryContext(addr dpy, addr context, i32 attribute, addr value) -> u32 = gl_egl_query_context
hook eglCreateWindowSurface(addr dpy, addr config, addr window, addr attribs) -> addr = gl_egl_create_window_surface
hook eglCreatePbufferSurface(addr dpy, addr config, addr attribs) -> addr = gl_egl_create_pbuffer_surface
hook eglDestroySurface(addr dpy, addr surface) -> u32 = gl_egl_destroy_surface
hook eglQuerySurface(addr dpy, addr surface, i32 attribute, addr value) -> u32 = gl_egl_query_surface
hook eglSurfaceAttrib(addr dpy, addr surface, i32 attribute, i32 value) -> u32 = gl_egl_surface_attrib
hook eglMakeCurrent(addr dpy, addr draw, addr read, addr context) -> u32 = gl_egl_make_current
hook eglGetCurrentContext() -> addr = gl_egl_get_current_context
hook eglGetCurrentDisplay() -> addr = gl_egl_get_current_display
hook eglGetCurrentSurface(i32 which) -> addr = gl_egl_get_current_surface
hook eglSwapBuffers(addr dpy, addr surface) -> u32 = gl_egl_swap_buffers
hook eglSwapInterval(addr dpy, i32 interval) -> u32 = gl_egl_swap_interval
hook eglWaitClient() -> u32 = gl_egl_wait_client
hook eglWaitGL() -> u32 = gl_egl_wait_gl
hook eglWaitNative(i32 engine) -> u32 = gl_egl_wait_native
hook eglReleaseThread() -> u32 = gl_egl_release_thread
hook eglGetProcAddress(addr name) -> addr = gl_egl_get_proc_address

family state
hook _glGetError() -> u32 = gl_get_error
hook _glEnable(u32 cap) = gl_enable
hook _glDisable(u32 cap) = gl_disable
hook _glIsEnabled(u32 cap) -> u8 = gl_is_enabled
hook _glBlendFunc(u32 src, u32 dst) = gl_blend_func
hook _glBlendFuncSeparate(u32 src_rgb, u32 dst_rgb, u32 src_alpha, u32 dst_alpha) = gl_blend_func_separate
hook _glBlendEquation(u32 mode) = gl_blend_equation
hook _glBlendEquationSeparate(u32 rgb, u32 alpha) = gl_blend_equation_separate
hook _glBlendColor(f32 r, f32 g, f32 b, f32 a) = gl_blend_color
hook _glColorMask(u8 r, u8 g, u8 b, u8 a) = gl_color_mask
hook _glDepthMask(u8 flag) = gl_depth_mask
hook _glDepthFunc(u32 func) = gl_depth_func
hook _glDepthRangef(f32 n, f32 f) = gl_depth_rangef
hook _glDepthRange(f64 n, f64 f) = gl_depth_range
hook _glCullFace(u32 mode) = gl_cull_face
hook _glFrontFace(u32 mode) = gl_front_face
hook _glStencilFunc(u32 func, i32 ref, u32 mask) = gl_stencil_func
hook _glStencilFuncSeparate(u32 face, u32 func, i32 ref, u32 mask) = gl_stencil_func_separate
hook _glStencilOp(u32 fail, u32 zfail, u32 zpass) = gl_stencil_op
hook _glStencilOpSeparate(u32 face, u32 fail, u32 zfail, u32 zpass) = gl_stencil_op_separate
hook _glStencilMask(u32 mask) = gl_stencil_mask
hook _glStencilMaskSeparate(u32 face, u32 mask) = gl_stencil_mask_separate
hook _glClearColor(f32 r, f32 g, f32 b, f32 a) = gl_clear_color
hook _glClearDepthf(f32 depth) = gl_clear_depthf
hook _glClearDepth(f64 depth) = gl_clear_depth
hook _glClearStencil(i32 s) = gl_clear_stencil
hook _glViewport(i32 x, i32 y, i32 width, i32 height) = gl_viewport
hook _glScissor(i32 x, i32 y, i32 width, i32 height) = gl_scissor
hook _glLineWidth(f32 width) = gl_line_width
hook _glPolygonOffset(f32 factor, f32 units) = gl_polygon_offset
hook _glSampleCoverage(f32 value, u8 invert) = gl_sample_coverage
hook _glHint(u32 target, u32 mode) = gl_hint
hook _glPixelStorei(u32 pname, i32 value) = gl_pixel_storei
hook _glGetIntegerv(u32 pname, addr data) = gl_get_integerv
hook _glGetInteger64v(u32 pname, addr data) = gl_get_integer64v
hook _glGetFloatv(u32 pname, addr data) = gl_get_floatv
hook _glGetBooleanv(u32 pname, addr data) = gl_get_booleanv
hook _glGetString(u32 name) -> addr = gl_get_string
hook _glGetStringi(u32 name, u32 index) -> addr = gl_get_stringi
hook _glFlush() = gl_flush
hook _glFinish() = gl_finish

family draw
hook _glClear(u32 mask) = gl_clear

family program
hook _glCreateShader(u32 type) -> u32 = gl_create_shader
hook _glDeleteShader(u32 shader) = gl_delete_shader
hook _glIsShader(u32 shader) -> u8 = gl_is_shader
hook _glShaderSource(u32 shader, i32 count, addr strings, addr lengths) = gl_shader_source
hook _glCompileShader(u32 shader) = gl_compile_shader
hook _glGetShaderiv(u32 shader, u32 pname, addr params) = gl_get_shaderiv
hook _glGetShaderInfoLog(u32 shader, i32 size, addr length, addr log) = gl_get_shader_info_log
hook _glGetShaderSource(u32 shader, i32 size, addr length, addr source) = gl_get_shader_source
hook _glGetShaderPrecisionFormat(u32 type, u32 precision, addr range, addr bits) = gl_get_shader_precision_format
hook _glShaderBinary(i32 count, addr shaders, u32 format, addr binary, i32 length) = gl_shader_binary
hook _glReleaseShaderCompiler() = gl_release_shader_compiler
hook _glMaxShaderCompilerThreadsARB(u32 count) = gl_max_shader_compiler_threads
hook _glMaxShaderCompilerThreadsKHR(u32 count) = gl_max_shader_compiler_threads
hook _glCreateProgram() -> u32 = gl_create_program
hook _glDeleteProgram(u32 program) = gl_delete_program
hook _glIsProgram(u32 program) -> u8 = gl_is_program
hook _glAttachShader(u32 program, u32 shader) = gl_attach_shader
hook _glDetachShader(u32 program, u32 shader) = gl_detach_shader
hook _glGetAttachedShaders(u32 program, i32 max, addr count, addr shaders) = gl_get_attached_shaders
hook _glBindAttribLocation(u32 program, u32 index, addr name) = gl_bind_attrib_location
hook _glLinkProgram(u32 program) = gl_link_program
hook _glUseProgram(u32 program) = gl_use_program
hook _glValidateProgram(u32 program) = gl_validate_program
hook _glProgramParameteri(u32 program, u32 pname, i32 value) = gl_program_parameteri
hook _glGetProgramiv(u32 program, u32 pname, addr params) = gl_get_programiv
hook _glGetProgramInfoLog(u32 program, i32 size, addr length, addr log) = gl_get_program_info_log
hook _glGetActiveUniform(u32 program, u32 index, i32 size, addr length, addr count, addr type, addr name) = gl_get_active_uniform
hook _glGetActiveAttrib(u32 program, u32 index, i32 size, addr length, addr count, addr type, addr name) = gl_get_active_attrib
hook _glGetAttribLocation(u32 program, addr name) -> i32 = gl_get_attrib_location
hook _glGetFragDataLocation(u32 program, addr name) -> i32 = gl_get_frag_data_location
hook _glGetUniformLocation(u32 program, addr name) -> i32 = gl_get_uniform_location
hook _glGetUniformfv(u32 program, i32 location, addr params) = gl_get_uniformfv
hook _glGetUniformiv(u32 program, i32 location, addr params) = gl_get_uniformiv
hook _glGetUniformuiv(u32 program, i32 location, addr params) = gl_get_uniformiv
hook _glGetnUniformfv(u32 program, i32 location, i32 size, addr params) = gl_get_nuniformfv
hook _glGetnUniformiv(u32 program, i32 location, i32 size, addr params) = gl_get_nuniformiv
hook _glGetnUniformuiv(u32 program, i32 location, i32 size, addr params) = gl_get_nuniformiv
hook _glGetUniformBlockIndex(u32 program, addr name) -> u32 = gl_get_uniform_block_index
hook _glUniformBlockBinding(u32 program, u32 index, u32 binding) = gl_uniform_block_binding
hook _glGetActiveUniformBlockiv(u32 program, u32 index, u32 pname, addr params) = gl_get_active_uniform_blockiv
hook _glGetActiveUniformBlockName(u32 program, u32 index, i32 size, addr length, addr name) = gl_get_active_uniform_block_name
hook _glGetUniformIndices(u32 program, i32 count, addr names, addr indices) = gl_get_uniform_indices
hook _glGetActiveUniformsiv(u32 program, i32 count, addr indices, u32 pname, addr params) = gl_get_active_uniformsiv
hook _glGetProgramInterfaceiv(u32 program, u32 interface, u32 pname, addr params) = gl_get_program_interfaceiv
hook _glGetProgramResourceIndex(u32 program, u32 interface, addr name) -> u32 = gl_get_program_resource_index
hook _glGetProgramResourceName(u32 program, u32 interface, u32 index, i32 size, addr length, addr name) = gl_get_program_resource_name
hook _glGetProgramResourceiv(u32 program, u32 interface, u32 index, i32 count, addr props, i32 size, addr length, addr params) = gl_get_program_resourceiv
hook _glGetProgramResourceLocation(u32 program, u32 interface, addr name) -> i32 = gl_get_program_resource_location
hook _glProgramBinary(u32 program, u32 format, addr binary, i32 length) = gl_program_binary
hook _glGetProgramBinary(u32 program, i32 size, addr length, addr format, addr binary) = gl_get_program_binary
hook _glGenProgramPipelines(i32 n, addr pipelines) = gl_gen_program_pipelines
hook _glDeleteProgramPipelines(i32 n, addr pipelines) = gl_delete_program_pipelines
hook _glIsProgramPipeline(u32 pipeline) -> u8 = gl_is_program_pipeline
hook _glBindProgramPipeline(u32 pipeline) = gl_bind_program_pipeline
hook _glUseProgramStages(u32 pipeline, u32 stages, u32 program) = gl_use_program_stages
hook _glActiveShaderProgram(u32 pipeline, u32 program) = gl_active_shader_program
hook _glValidateProgramPipeline(u32 pipeline) = gl_validate_program_pipeline
hook _glGetProgramPipelineiv(u32 pipeline, u32 pname, addr params) = gl_get_program_pipelineiv
hook _glGetProgramPipelineInfoLog(u32 pipeline, i32 size, addr length, addr log) = gl_get_program_pipeline_info_log
hook _glCreateShaderProgramv(u32 type, i32 count, addr strings) -> u32 = gl_create_shader_programv
hook _glUniform1f(i32 location, f32 v0) = gl_uniform1f
hook _glUniform1fv(i32 location, i32 count, addr value) = gl_uniform1fv
hook _glProgramUniform1f(u32 program, i32 location, f32 v0) = gl_program_uniform1f
hook _glProgramUniform1fv(u32 program, i32 location, i32 count, addr value) = gl_program_uniform1fv
hook _glUniform1i(i32 location, i32 v0) = gl_uniform1i
hook _glUniform1iv(i32 location, i32 count, addr value) = gl_uniform1iv
hook _glProgramUniform1i(u32 program, i32 location, i32 v0) = gl_program_uniform1i
hook _glProgramUniform1iv(u32 program, i32 location, i32 count, addr value) = gl_program_uniform1iv
hook _glUniform1ui(i32 location, u32 v0) = gl_uniform1ui
hook _glUniform1uiv(i32 location, i32 count, addr value) = gl_uniform1uiv
hook _glProgramUniform1ui(u32 program, i32 location, u32 v0) = gl_program_uniform1ui
hook _glProgramUniform1uiv(u32 program, i32 location, i32 count, addr value) = gl_program_uniform1uiv
hook _glUniform2f(i32 location, f32 v0, f32 v1) = gl_uniform2f
hook _glUniform2fv(i32 location, i32 count, addr value) = gl_uniform2fv
hook _glProgramUniform2f(u32 program, i32 location, f32 v0, f32 v1) = gl_program_uniform2f
