hook _glUniform2i(i32 location, i32 v0, i32 v1) = gl_uniform2i
hook _glUniform2iv(i32 location, i32 count, addr value) = gl_uniform2iv
hook _glProgramUniform2i(u32 program, i32 location, i32 v0, i32 v1) = gl_program_uniform2i
