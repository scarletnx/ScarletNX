hook _glUniform2ui(i32 location, u32 v0, u32 v1) = gl_uniform2ui
hook _glUniform2uiv(i32 location, i32 count, addr value) = gl_uniform2uiv
hook _glProgramUniform2ui(u32 program, i32 location, u32 v0, u32 v1) = gl_program_uniform2ui
hook _glProgramUniform2uiv(u32 program, i32 location, i32 count, addr value) = gl_program_uniform2uiv
hook _glUniform3f(i32 location, f32 v0, f32 v1, f32 v2) = gl_uniform3f
hook _glUniform3fv(i32 location, i32 count, addr value) = gl_uniform3fv
hook _glProgramUniform3f(u32 program, i32 location, f32 v0, f32 v1, f32 v2) = gl_program_uniform3f
hook _glProgramUniform3fv(u32 program, i32 location, i32 count, addr value) = gl_program_uniform3fv
hook _glUniform3i(i32 location, i32 v0, i32 v1, i32 v2) = gl_uniform3i
hook _glUniform3iv(i32 location, i32 count, addr value) = gl_uniform3iv
hook _glProgramUniform3i(u32 program, i32 location, i32 v0, i32 v1, i32 v2) = gl_program_uniform3i
hook _glProgramUniform3iv(u32 program, i32 location, i32 count, addr value) = gl_program_uniform3iv
hook _glUniform3ui(i32 location, u32 v0, u32 v1, u32 v2) = gl_uniform3ui
hook _glUniform3uiv(i32 location, i32 count, addr value) = gl_uniform3uiv
hook _glProgramUniform3ui(u32 program, i32 location, u32 v0, u32 v1, u32 v2) = gl_program_uniform3ui
hook _glProgramUniform3uiv(u32 program, i32 location, i32 count, addr value) = gl_program_uniform3uiv
hook _glUniform4f(i32 location, f32 v0, f32 v1, f32 v2, f32 v3) = gl_uniform4f
hook _glUniform4fv(i32 location, i32 count, addr value) = gl_uniform4fv
hook _glProgramUniform4f(u32 program, i32 location, f32 v0, f32 v1, f32 v2, f32 v3) = gl_program_uniform4f
