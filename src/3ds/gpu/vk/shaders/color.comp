// A color render target loaded from, or stored to, the tiled framebuffer the guest has in memory: one invocation per
// pixel, at the offsets gpu/raster.c (the CPU reference) gives a pixel. The image's row r is the rasterizer's y = r;
// memory holds the rows from the top (y = height - 1) down, unless the framebuffer's flip bit says from y = 0 up.
// A render scale above 1 makes the image width * height times bigger; a load repeats the guest's pixels and a store
// averages each image block back to the guest's one.
#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, set = 0, binding = 0) buffer Memory { uint8_t MEM[]; };
layout(set = 0, binding = 1, rgba8) uniform image2D image;
layout(push_constant) uniform Target {
    uint offset, width, height, format, flip, store, scale;
};
#define SRC MEM
#define DST MEM
#include "pixel.glsl"
void main() {
    uint x = gl_GlobalInvocationID.x, r = gl_GlobalInvocationID.y;
    uint s = max(scale, 1u);
    if (store != 0u) {
        if (x >= width || r >= height) return;
        uint y = flip != 0u ? r : height - 1u - r, bpp = pixel_bytes(format);
        uint at = offset + morton(x, y, bpp) + (y & ~7u) * width * bpp;
        vec4 sum = vec4(0.0);
        for (uint sy = 0u; sy < s; ++sy)
            for (uint sx = 0u; sx < s; ++sx) sum += imageLoad(image, ivec2(int(x * s + sx), int(r * s + sy)));
        encode(format, uvec4(round(sum / float(s * s) * 255.0)), at);
    } else {
        uint image_width = width * s, image_height = height * s;
        if (x >= image_width || r >= image_height) return;
        uint nx = x / s, nr = r / s;
        uint y = flip != 0u ? nr : height - 1u - nr, bpp = pixel_bytes(format);
        uint at = offset + morton(nx, y, bpp) + (y & ~7u) * width * bpp;
        imageStore(image, ivec2(int(x), int(r)), vec4(decode(format, at)) / 255.0);
    }
}
