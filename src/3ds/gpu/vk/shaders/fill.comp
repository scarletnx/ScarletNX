// A memory fill (GX command 2), one invocation per byte, as transfer.c's snx_ctr_fill: 24-bit fills write R, G, B
// to the end (the last value cut short), 32- and 16-bit fills whole values, little-endian.
#version 450
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Out { uint8_t DST[]; };
layout(push_constant) uniform Fill {
    uint offset, size, value, width; // width: 3 or 4 bytes, else 2
};
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint whole = width == 3u ? size : size & ~(width - 1u);
    if (i >= whole) return;
    uint k = width == 3u ? i % 3u : i & (width - 1u); // i % width, without a division by a variable
    DST[offset + i] = uint8_t(value >> (k * 8u));
}
