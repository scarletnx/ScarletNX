// A PICA texture level decoded where the guest has it into an image: one invocation per texel, as gpu/texture.c (the
// CPU reference, ported from Azahar's texture_decode.cpp and etc1.cpp, GPL-2.0-or-later) looks texels up. The
// image's row t is the texture's coordinate t: the texture's rows are stored from its top (t = height - 1) down. ETC1
// blocks are read as two 32-bit halves, so the shader needs no 64-bit integers.
#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, set = 0, binding = 0) readonly buffer In { uint8_t SRC[]; };
layout(set = 0, binding = 1, rgba8) uniform writeonly image2DArray image;
layout(push_constant) uniform Texture {
    uint offset, width, height, format, layer;
};
#define NO_ENCODE
#include "pixel.glsl"
#define TEX_RGBA8  0u
#define TEX_RGB8   1u
#define TEX_RGB5A1 2u
#define TEX_RGB565 3u
#define TEX_RGBA4  4u
#define TEX_IA8    5u
#define TEX_RG8    6u
#define TEX_I8     7u
#define TEX_A8     8u
#define TEX_IA4    9u
#define TEX_I4     10u
#define TEX_A4     11u
#define TEX_ETC1   12u
#define TEX_ETC1A4 13u
uint tile_bytes(uint f) {
    const uint tiles[14] = uint[](256u, 192u, 128u, 128u, 128u, 128u, 128u, 64u, 64u, 64u, 32u, 32u, 32u, 64u);
    return tiles[f];
}
uint word(uint at) {
    return uint(SRC[at]) | (uint(SRC[at + 1u]) << 8) | (uint(SRC[at + 2u]) << 16) | (uint(SRC[at + 3u]) << 24);
}
// the ETC1 block (lo, hi: bits 0-31 and 32-63) at texel (x, y) of its 4x4
uvec3 etc1(uint lo, uint hi, uint x, uint y) {
    const uint modifiers[16] = uint[](2u, 8u, 5u, 17u, 9u, 29u, 13u, 42u, 18u, 60u, 24u, 80u, 33u, 106u, 47u, 183u);
    uint texel = 4u * x + y;
    if ((hi & 1u) != 0u) { uint t = x; x = y; y = t; }
    ivec3 c;
    if ((hi & 2u) != 0u) { // differential: 5-bit bases, the second half adds a signed 3-bit delta
        for (int i = 0; i < 3; ++i) {
            uint at = 27u - uint(i) * 8u;
            int base = int((hi >> at) & 31u);
            if (x >= 2u) {
                int delta = int((hi >> (at - 3u)) & 7u);
                base += delta >= 4 ? delta - 8 : delta;
            }
            c[i] = int(c5to8(uint(base) & 0xffu) & 0xffu); // Azahar's Convert5To8 takes and gives a u8
        }
    } else { // individual: 4-bit colours per half
        for (int i = 0; i < 3; ++i) c[i] = int(c4to8((hi >> (28u - uint(i) * 8u - (x < 2u ? 0u : 4u))) & 15u));
    }
    uint table = x < 2u ? (hi >> 5) & 7u : (hi >> 2) & 7u;
    int modifier = int(modifiers[table * 2u + ((lo >> texel) & 1u)]);
    if (((lo >> (16u + texel)) & 1u) != 0u) modifier = -modifier;
    return uvec3(clamp(c + modifier, 0, 255));
}
void main() {
    uint x = gl_GlobalInvocationID.x, t = gl_GlobalInvocationID.y;
    if (x >= width || t >= height) return;
    uint y = height - 1u - t;
    uint tile = tile_bytes(format);
    uint base = offset + ((y / 8u) * (width / 8u) + x / 8u) * tile;
    uint fx = x % 8u, fy = y % 8u;
    uvec4 c = uvec4(0u);
    if (format == TEX_ETC1 || format == TEX_ETC1A4) {
        bool alpha = format == TEX_ETC1A4;
        uint size = alpha ? 16u : 8u, sub = fx / 4u + 2u * (fy / 4u);
        uint at = base + sub * size;
        fx %= 4u, fy %= 4u;
        c.a = 255u;
        if (alpha) {
            uint shift = 4u * (fx * 4u + fy), half_word = shift < 32u ? word(at) : word(at + 4u);
            c.a = c4to8((half_word >> (shift % 32u)) & 15u);
            at += 8u;
        }
        c.rgb = etc1(word(at), word(at + 4u), fx, fy);
    } else {
        const uint sizes[12] = uint[](4u, 3u, 2u, 2u, 2u, 2u, 2u, 1u, 1u, 1u, 0u, 0u);
        uint index = tile_index(fx, fy), n = sizes[format];
        uint at = base + (n != 0u ? index * n : index / 2u);
        uint b0 = uint(SRC[at]);
        switch (format) {
        case TEX_RGBA8: c = decode(PIX_RGBA8, at); break;
        case TEX_RGB8: c = decode(PIX_RGB8, at); break;
        case TEX_RGB5A1: c = decode(PIX_RGB5A1, at); break;
        case TEX_RGB565: c = decode(PIX_RGB565, at); break;
        case TEX_RGBA4: c = decode(PIX_RGBA4, at); break;
        case TEX_IA8: c = uvec4(uvec3(uint(SRC[at + 1u])), b0); break;
        case TEX_RG8: c = uvec4(uint(SRC[at + 1u]), b0, 0u, 255u); break;
        case TEX_I8: c = uvec4(uvec3(b0), 255u); break;
        case TEX_A8: c = uvec4(0u, 0u, 0u, b0); break;
        case TEX_IA4: c = uvec4(uvec3(c4to8(b0 >> 4)), c4to8(b0 & 15u)); break;
        case TEX_I4: c = uvec4(uvec3(c4to8((index % 2u) != 0u ? b0 >> 4 : b0 & 15u)), 255u); break;
        default: c = uvec4(0u, 0u, 0u, c4to8((index % 2u) != 0u ? b0 >> 4 : b0 & 15u)); break; // A4
        }
    }
    imageStore(image, ivec3(int(x), int(t), int(layer)), vec4(c) / 255.0);
}
