// A PICA texture that a render target at a render scale above 1 covers as its whole image, in the target's format: one
// invocation per texel of that image. A texel is the target's colour at the same place, quantised through the format as
// the console stores it (pixel.glsl's pack16 and unpack16), so the texture keeps the render scale. Texture row t reads
// image row t, or height * scale - 1 - t when the target is flipped: the rows that texture.comp reads at scale 1.
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D from;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2DArray image;
layout(push_constant) uniform Scaled {
    uint width, height, format, flip, scale;
};
#define NO_ENCODE
#define NO_DECODE
#include "pixel.glsl"
void main() {
    uint x = gl_GlobalInvocationID.x, t = gl_GlobalInvocationID.y;
    uint image_width = width * scale, image_height = height * scale;
    if (x >= image_width || t >= image_height) return;
    uint row = flip != 0u ? image_height - 1u - t : t;
    vec4 color = imageLoad(from, ivec2(int(x), int(row)));
    uvec4 c = quantise(format, uvec4(round(color * 255.0)));
    imageStore(image, ivec3(int(x), int(t), 0), vec4(c) / 255.0);
}
