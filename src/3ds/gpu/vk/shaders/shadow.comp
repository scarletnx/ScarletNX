// The PICA's shadow map, read from and written to the tiled framebuffer the guest has in memory. A shadow map is an
// RGBA8 framebuffer whose four bytes are one 32-bit word: the depth in the top 24 bits, the shadow strength in the
// bottom 8 (Azahar's EncodeShadow). The fragment shader writes it through a storage image (fsgen.c's UpdateShadow), so
// the image is R32_UINT and this copies its texels as they are, in the same tiled order as color.comp's RGBA8. The
// image's row r is the rasterizer's y; memory holds the rows from the top down, unless the framebuffer's flip bit says
// from y = 0 up.
#version 450
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, set = 0, binding = 0) buffer Memory { uint8_t MEM[]; };
layout(set = 0, binding = 1, r32ui) uniform uimage2D image;
layout(push_constant) uniform Target {
    uint offset, width, height, format, flip, store, scale;
};
uint morton(uint x, uint y, uint bpp) {
    uint i = (x & 1u) | ((y & 1u) << 1) | ((x & 2u) << 1) | ((y & 2u) << 2) | ((x & 4u) << 2) | ((y & 4u) << 3);
    return (i + (x & ~7u) * 8u) * bpp;
}
void main() {
    uint x = gl_GlobalInvocationID.x, r = gl_GlobalInvocationID.y;
    if (x >= width || r >= height) return;
    uint y = flip != 0u ? r : height - 1u - r;
    uint at = offset + morton(x, y, 4u) + (y & ~7u) * width * 4u;
    if (store != 0u) {
        uint v = imageLoad(image, ivec2(int(x), int(r))).x;
        MEM[at] = uint8_t(v);
        MEM[at + 1u] = uint8_t(v >> 8);
        MEM[at + 2u] = uint8_t(v >> 16);
        MEM[at + 3u] = uint8_t(v >> 24);
    } else {
        uint v = uint(MEM[at]) | (uint(MEM[at + 1u]) << 8) | (uint(MEM[at + 2u]) << 16) | (uint(MEM[at + 3u]) << 24);
        imageStore(image, ivec2(int(x), int(r)), uvec4(v));
    }
}
