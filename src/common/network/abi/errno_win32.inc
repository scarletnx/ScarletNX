/* SNX_NET_WSAERR(host, NAME): Winsock's errors as the stack's errno (SNX_E##NAME). Ported from the Windows half of
   Eden's TranslateNativeError (src/core/internal_network/network.cpp). WSAEWOULDBLOCK from connect() means the
   connection is in progress: net.c turns it into SNX_EINPROGRESS there, and WSAECONNABORTED from send() into
   SNX_EPIPE, which is what POSIX hosts and the console report. */
SNX_NET_WSAERR(WSAEINTR, INTR)
SNX_NET_WSAERR(WSAEBADF, BADF)
SNX_NET_WSAERR(WSAEACCES, ACCES)
SNX_NET_WSAERR(WSAEFAULT, FAULT)
SNX_NET_WSAERR(WSAEINVAL, INVAL)
SNX_NET_WSAERR(WSAEMFILE, MFILE)
SNX_NET_WSAERR(WSAEWOULDBLOCK, AGAIN)
SNX_NET_WSAERR(WSAEINPROGRESS, INPROGRESS)
SNX_NET_WSAERR(WSAEALREADY, ALREADY)
SNX_NET_WSAERR(WSAENOTSOCK, NOTSOCK)
SNX_NET_WSAERR(WSAEDESTADDRREQ, DESTADDRREQ)
SNX_NET_WSAERR(WSAEMSGSIZE, MSGSIZE)
SNX_NET_WSAERR(WSAEPROTOTYPE, PROTOTYPE)
SNX_NET_WSAERR(WSAENOPROTOOPT, NOPROTOOPT)
SNX_NET_WSAERR(WSAEPROTONOSUPPORT, PROTONOSUPPORT)
SNX_NET_WSAERR(WSAESOCKTNOSUPPORT, SOCKTNOSUPPORT)
SNX_NET_WSAERR(WSAEOPNOTSUPP, OPNOTSUPP)
SNX_NET_WSAERR(WSAEPFNOSUPPORT, PFNOSUPPORT)
SNX_NET_WSAERR(WSAEAFNOSUPPORT, AFNOSUPPORT)
SNX_NET_WSAERR(WSAEADDRINUSE, ADDRINUSE)
SNX_NET_WSAERR(WSAEADDRNOTAVAIL, ADDRNOTAVAIL)
SNX_NET_WSAERR(WSAENETDOWN, NETDOWN)
SNX_NET_WSAERR(WSAENETUNREACH, NETUNREACH)
SNX_NET_WSAERR(WSAENETRESET, NETRESET)
SNX_NET_WSAERR(WSAECONNABORTED, CONNABORTED)
SNX_NET_WSAERR(WSAECONNRESET, CONNRESET)
SNX_NET_WSAERR(WSAENOBUFS, NOBUFS)
SNX_NET_WSAERR(WSAEISCONN, ISCONN)
SNX_NET_WSAERR(WSAENOTCONN, NOTCONN)
SNX_NET_WSAERR(WSAESHUTDOWN, SHUTDOWN)
SNX_NET_WSAERR(WSAETOOMANYREFS, TOOMANYREFS)
SNX_NET_WSAERR(WSAETIMEDOUT, TIMEDOUT)
SNX_NET_WSAERR(WSAECONNREFUSED, CONNREFUSED)
SNX_NET_WSAERR(WSAELOOP, LOOP)
SNX_NET_WSAERR(WSAENAMETOOLONG, NAMETOOLONG)
SNX_NET_WSAERR(WSAEHOSTDOWN, HOSTDOWN)
SNX_NET_WSAERR(WSAEHOSTUNREACH, HOSTUNREACH)
SNX_NET_WSAERR(WSAEDQUOT, DQUOT)
SNX_NET_WSAERR(WSAESTALE, STALE)
SNX_NET_WSAERR(WSAECANCELLED, CANCELED)
SNX_NET_WSAERR(WSA_NOT_ENOUGH_MEMORY, NOMEM)
/* a call before WSAStartup, or after its WSACleanup: the stack is down, as net.c's start reports its own failure */
SNX_NET_WSAERR(WSANOTINITIALISED, NETDOWN)
#undef SNX_NET_WSAERR
