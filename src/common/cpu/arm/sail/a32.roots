# The roots of a32.sail (sailgen --extract, tools/sailgen/README.md): the decode functions of the AArch32 subsets sailgen
# generates, the dispatcher that tries each instruction set's clauses, and the names the generator maps or lowers
# itself and arm.sail's fixups, which are neither followed nor copied.

# Thumb's 16-bit instructions: every __DecodeT16 clause, tried in their order, but HLT's
# and UDF's: with no clause their halfwords stay UNDEFINED, UDF's whatever an IT block's condition, as the Thumb decoder
# has them (it gives them no instruction, and the code discovery that reads it ends there)
decoder sg_decode_t16 __DecodeT16
root decode_aarch32_instrs_ADC_r_T1enc_A_txt
root decode_aarch32_instrs_ADD_i_T1enc_A_txt
root decode_aarch32_instrs_ADD_i_T2enc_A_txt
root decode_aarch32_instrs_ADD_r_T1enc_A_txt
root decode_aarch32_instrs_ADD_r_T2enc_A_txt
root decode_aarch32_instrs_ADD_SP_i_T1enc_A_txt
root decode_aarch32_instrs_ADD_SP_i_T2enc_A_txt
root decode_aarch32_instrs_ADD_SP_r_T1enc_A_txt
root decode_aarch32_instrs_ADD_SP_r_T2enc_A_txt
root decode_aarch32_instrs_ADR_T1enc_A_txt
root decode_aarch32_instrs_AND_r_T1enc_A_txt
root decode_aarch32_instrs_ASR_i_T1enc_A_txt
root decode_aarch32_instrs_ASR_r_T1enc_A_txt
root decode_aarch32_instrs_B_T1enc_A_txt
root decode_aarch32_instrs_B_T2enc_A_txt
root decode_aarch32_instrs_BIC_r_T1enc_A_txt
root decode_aarch32_instrs_BKPT_T1enc_A_txt
root decode_aarch32_instrs_BLX_r_T1enc_A_txt
root decode_aarch32_instrs_BX_T1enc_A_txt
root decode_aarch32_instrs_CBNZ_T1enc_A_txt
root decode_aarch32_instrs_CMN_r_T1enc_A_txt
root decode_aarch32_instrs_CMP_i_T1enc_A_txt
root decode_aarch32_instrs_CMP_r_T1enc_A_txt
root decode_aarch32_instrs_CMP_r_T2enc_A_txt
root decode_aarch32_instrs_EOR_r_T1enc_A_txt
root decode_aarch32_instrs_IT_T1enc_A_txt
root decode_aarch32_instrs_LDM_T1enc_A_txt
root decode_aarch32_instrs_LDRB_i_T1enc_A_txt
root decode_aarch32_instrs_LDRB_r_T1enc_A_txt
root decode_aarch32_instrs_LDRH_i_T1enc_A_txt
root decode_aarch32_instrs_LDRH_r_T1enc_A_txt
root decode_aarch32_instrs_LDR_i_T1enc_A_txt
root decode_aarch32_instrs_LDR_i_T2enc_A_txt
root decode_aarch32_instrs_LDR_l_T1enc_A_txt
root decode_aarch32_instrs_LDR_r_T1enc_A_txt
root decode_aarch32_instrs_LDRSB_r_T1enc_A_txt
root decode_aarch32_instrs_LDRSH_r_T1enc_A_txt
root decode_aarch32_instrs_LSL_i_T1enc_A_txt
root decode_aarch32_instrs_LSL_r_T1enc_A_txt
root decode_aarch32_instrs_LSR_i_T1enc_A_txt
root decode_aarch32_instrs_LSR_r_T1enc_A_txt
root decode_aarch32_instrs_MOV_i_T1enc_A_txt
root decode_aarch32_instrs_MOV_r_T1enc_A_txt
root decode_aarch32_instrs_MOV_r_T2enc_A_txt
root decode_aarch32_instrs_MOV_rr_T1enc_A_txt
root decode_aarch32_instrs_MUL_T1enc_A_txt
root decode_aarch32_instrs_MVN_r_T1enc_A_txt
root decode_aarch32_instrs_NOP_T1enc_A_txt
root decode_aarch32_instrs_ORR_r_T1enc_A_txt
root decode_aarch32_instrs_POP_T1enc_A_txt
root decode_aarch32_instrs_PUSH_T1enc_A_txt
root decode_aarch32_instrs_REV16_T1enc_A_txt
root decode_aarch32_instrs_REV_T1enc_A_txt
root decode_aarch32_instrs_REVSH_T1enc_A_txt
root decode_aarch32_instrs_ROR_r_T1enc_A_txt
root decode_aarch32_instrs_RSB_i_T1enc_A_txt
root decode_aarch32_instrs_SBC_r_T1enc_A_txt
root decode_aarch32_instrs_SETEND_T1enc_A_txt
root decode_aarch32_instrs_SEV_T1enc_A_txt
root decode_aarch32_instrs_STM_T1enc_A_txt
root decode_aarch32_instrs_STRB_i_T1enc_A_txt
root decode_aarch32_instrs_STRB_r_T1enc_A_txt
root decode_aarch32_instrs_STRH_i_T1enc_A_txt
root decode_aarch32_instrs_STRH_r_T1enc_A_txt
root decode_aarch32_instrs_STR_i_T1enc_A_txt
root decode_aarch32_instrs_STR_i_T2enc_A_txt
root decode_aarch32_instrs_STR_r_T1enc_A_txt
root decode_aarch32_instrs_SUB_i_T1enc_A_txt
root decode_aarch32_instrs_SUB_i_T2enc_A_txt
root decode_aarch32_instrs_SUB_r_T1enc_A_txt
root decode_aarch32_instrs_SUB_SP_i_T1enc_A_txt
root decode_aarch32_instrs_SVC_T1enc_A_txt
root decode_aarch32_instrs_SXTB_T1enc_A_txt
root decode_aarch32_instrs_SXTH_T1enc_A_txt
root decode_aarch32_instrs_TST_r_T1enc_A_txt
root decode_aarch32_instrs_UXTB_T1enc_A_txt
root decode_aarch32_instrs_UXTH_T1enc_A_txt
root decode_aarch32_instrs_WFE_T1enc_A_txt
root decode_aarch32_instrs_WFI_T1enc_A_txt
root decode_aarch32_instrs_YIELD_T1enc_A_txt
root decode_aarch32_instrs_CPS_T1enc_AS_txt
root decode_aarch32_instrs_SEVL_T1enc_A_txt
root decode_aarch32_instrs_SETPAN_T1enc_A_txt
# and the BL halves of the Thumb before Thumb-2, which arm.sail defines (sail-arm's are Thumb-2's 32-bit BL)
fixup decode_aarch32_legacy_BL_prefix
fixup decode_aarch32_legacy_BL_suffix
fixup decode_aarch32_legacy_BLX_suffix
# and the ARM7TDMI's BX with its should-be-zero bits set
fixup decode_aarch32_legacy_BX
# and Thumb-2's unallocated hints, NOPs (sail-arm's fetch, not its decode, makes them so)
fixup decode_aarch32_unallocated_hint_T1

# A32's data processing and branches (B, BL, BX, BLX, MOVW, MOVT): these roots' clauses of
# __DecodeA32_DataProMisc and __DecodeA32_BranchBlock; a word no clause of theirs takes stays the block compiler's
decoder sg_decode_a32 __DecodeA32_DataProMisc __DecodeA32_BranchBlock
root decode_aarch32_instrs_ADC_i_A1enc_A_txt
root decode_aarch32_instrs_ADC_r_A1enc_A_txt
root decode_aarch32_instrs_ADC_rr_A1enc_A_txt
root decode_aarch32_instrs_ADD_i_A1enc_A_txt
root decode_aarch32_instrs_ADD_r_A1enc_A_txt
root decode_aarch32_instrs_ADD_rr_A1enc_A_txt
root decode_aarch32_instrs_AND_i_A1enc_A_txt
root decode_aarch32_instrs_AND_r_A1enc_A_txt
root decode_aarch32_instrs_AND_rr_A1enc_A_txt
root decode_aarch32_instrs_BIC_i_A1enc_A_txt
root decode_aarch32_instrs_BIC_r_A1enc_A_txt
root decode_aarch32_instrs_BIC_rr_A1enc_A_txt
root decode_aarch32_instrs_CMN_i_A1enc_A_txt
root decode_aarch32_instrs_CMN_r_A1enc_A_txt
root decode_aarch32_instrs_CMN_rr_A1enc_A_txt
root decode_aarch32_instrs_CMP_i_A1enc_A_txt
root decode_aarch32_instrs_CMP_r_A1enc_A_txt
root decode_aarch32_instrs_CMP_rr_A1enc_A_txt
root decode_aarch32_instrs_EOR_i_A1enc_A_txt
root decode_aarch32_instrs_EOR_r_A1enc_A_txt
root decode_aarch32_instrs_EOR_rr_A1enc_A_txt
root decode_aarch32_instrs_MOV_i_A1enc_A_txt
root decode_aarch32_instrs_MOV_r_A1enc_A_txt
root decode_aarch32_instrs_MOV_rr_A1enc_A_txt
root decode_aarch32_instrs_MVN_i_A1enc_A_txt
root decode_aarch32_instrs_MVN_r_A1enc_A_txt
root decode_aarch32_instrs_MVN_rr_A1enc_A_txt
root decode_aarch32_instrs_ORR_i_A1enc_A_txt
root decode_aarch32_instrs_ORR_r_A1enc_A_txt
root decode_aarch32_instrs_ORR_rr_A1enc_A_txt
root decode_aarch32_instrs_RSB_i_A1enc_A_txt
root decode_aarch32_instrs_RSB_r_A1enc_A_txt
root decode_aarch32_instrs_RSB_rr_A1enc_A_txt
root decode_aarch32_instrs_RSC_i_A1enc_A_txt
root decode_aarch32_instrs_RSC_r_A1enc_A_txt
root decode_aarch32_instrs_RSC_rr_A1enc_A_txt
root decode_aarch32_instrs_SBC_i_A1enc_A_txt
root decode_aarch32_instrs_SBC_r_A1enc_A_txt
root decode_aarch32_instrs_SBC_rr_A1enc_A_txt
root decode_aarch32_instrs_SUB_i_A1enc_A_txt
root decode_aarch32_instrs_SUB_r_A1enc_A_txt
root decode_aarch32_instrs_SUB_rr_A1enc_A_txt
root decode_aarch32_instrs_TEQ_i_A1enc_A_txt
root decode_aarch32_instrs_TEQ_r_A1enc_A_txt
root decode_aarch32_instrs_TEQ_rr_A1enc_A_txt
root decode_aarch32_instrs_TST_i_A1enc_A_txt
root decode_aarch32_instrs_TST_r_A1enc_A_txt
root decode_aarch32_instrs_TST_rr_A1enc_A_txt
root decode_aarch32_instrs_ADD_SP_i_A1enc_A_txt
root decode_aarch32_instrs_ADD_SP_r_A1enc_A_txt
root decode_aarch32_instrs_SUB_SP_i_A1enc_A_txt
root decode_aarch32_instrs_SUB_SP_r_A1enc_A_txt
root decode_aarch32_instrs_ADR_A1enc_A_txt
root decode_aarch32_instrs_ADR_A2enc_A_txt
root decode_aarch32_instrs_MOV_i_A2enc_A_txt
root decode_aarch32_instrs_MOVT_A1enc_A_txt
root decode_aarch32_instrs_B_A1enc_A_txt
root decode_aarch32_instrs_BL_i_A1enc_A_txt
root decode_aarch32_instrs_BL_i_A2enc_A_txt
root decode_aarch32_instrs_BX_A1enc_A_txt
root decode_aarch32_instrs_BLX_r_A1enc_A_txt

# what the generator knows itself: the pc, the decoder's bookkeeping, the features, the flow
stop _PC
stop SEE
stop FeatureImpl
stop IsFeatureImplemented
stop BranchTo
stop BranchNotTaken
stop EndOfInstruction
# arm.sail's: the registers as ScarletNX's AArch32 CPU keeps them, user mode, the condition and the IT block as the block
# compilers decide them, guest memory, the hints and the exceptions
stop Rmode_read
stop Rmode_set
stop get_R
stop set_R
stop set_R_bits
stop CurrentInstrSet
stop SelectInstrSet
stop InITBlock
stop LastInITBlock
stop execute_aarch32_instrs_IT_Op_A_txt
stop ShouldAdvanceIT
stop MemA_read
stop MemA_set
stop MemU_read
stop MemU_set
stop MemS_read
stop MemS_set
stop execute_aarch32_instrs_LDRH_i_OpT_A_txt
stop execute_aarch32_instrs_LDRH_r_Op_A_txt
stop execute_aarch32_instrs_LDRSH_r_Op_A_txt
stop execute_aarch32_instrs_LDM_Op_A_txt
stop execute_aarch32_instrs_STM_Op_A_txt
stop execute_aarch32_instrs_PUSH_Op_A_txt
stop execute_aarch32_instrs_POP_Op_A_txt
stop LoadWritePC
stop ALUWritePC
stop execute_aarch32_instrs_MUL_Op_A_txt
stop BXWritePC
stop AArch32_SetLSInstructionSyndrome
stop AArch32_CallSupervisor
stop AArch32_CheckForSVCTrap
stop AArch32_SoftwareBreakpoint
stop AArch32_CheckForWFxTrap
stop AArch32_CheckSETENDEnabled
stop AArch32_WriteModeByInstr
stop WaitForEvent
stop WaitForInterrupt
stop ClearEventRegister
stop IsEventRegisterSet
stop InterruptPending
stop SendEvent
stop SendEventLocal
stop Hint_Yield
stop EL2Enabled
stop IsInHost
stop HaveEL
stop HavePANExt
stop ALUExceptionReturn
stop ConstrainUnpredictable
stop ConstrainUnpredictableBool
stop __UNKNOWN_bits
