# the state the generator maps to the backend's (gen.c)
stop _R
stop _PC
stop PSTATE
stop SP_EL0
stop SP_EL1
stop SP_EL2
stop SP_EL3
stop SEE
stop SPESampleInFlight
stop FeatureImpl

# what the generator lowers itself (tools/sailgen/README.md, "Builtins"): their Sail is not needed
stop IsFeatureImplemented

# NX's fixups (nx.sail) in their place
stop SPESampleAddOpOther
stop AddPACIA
stop AddPACIB
stop AddPACDA
stop AddPACDB
stop AuthIA
stop AuthIB
stop AuthDA
stop AuthDB
stop Strip
stop AddPACGA
