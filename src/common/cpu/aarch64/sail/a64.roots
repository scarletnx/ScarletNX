# A64 SIMD, across lanes: each element loop that folds the elements into one value from the first, and ADDV's Reduce,
# which adds what it gives for each half of its bits, the elements' sum (gen.c's halves). Reduce's floating-point
# minimum and maximum, which no instruction here reaches, are not followed
root decode_addv_advsimd_aarch64_instrs_vector_reduce_add_simd
root decode_saddlv_advsimd_aarch64_instrs_vector_reduce_add_long
root decode_uaddlv_advsimd_aarch64_instrs_vector_reduce_add_long
