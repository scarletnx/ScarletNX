lower UnsignedRecipEstimate
lower UnsignedRSqrtEstimate
# and FMLAL's, BFDOT's steps and SM4's table
lower FPMulAddH
lower BFDotAdd
lower Sbox
# the saturations, each once in the back end rather than in every clause that saturates
lower SatQ
lower SignedSatQ
lower UnsignedSatQ
# and AES's tables, which a guest's byte picks from
lower AESSubBytes
lower AESInvSubBytes
lower AESMixColumns
lower AESInvMixColumns

# NX's fixups for floating point (nx.sail) in their place: the SIMD&FP registers are _V's elements and FPCR is the
# register as the CPU keeps it, as FPSR is; FP is enabled at EL0; nothing merges without FEAT_AFP; FPAbs and FPNeg
# unpack an operand only under FEAT_AFP, which no guest has; the comparisons that answer a bool read FPCompare's flags;
# and a rounded shift keeps its sum short
stop V_read
stop V_set
stop FPCR_read
stop FPCR
