# A64 branch operands (ir_codegen.c's flow): the condition of B.cond, CBZ and TBZ, the target of BR, BLR and RET and
# their PAuth forms; the decode function's BranchTo gives them (gen.c), and BLR's link register is written as its Sail does
root decode_b_cond_aarch64_instrs_branch_conditional_cond
root decode_bc_cond_aarch64_instrs_branch_conditional_hinted
root decode_cbz_aarch64_instrs_branch_conditional_compare
root decode_cbnz_aarch64_instrs_branch_conditional_compare
root decode_tbz_aarch64_instrs_branch_conditional_test
root decode_tbnz_aarch64_instrs_branch_conditional_test
root decode_br_aarch64_instrs_branch_unconditional_register
root decode_blr_aarch64_instrs_branch_unconditional_register
root decode_ret_aarch64_instrs_branch_unconditional_register
root decode_bra_aarch64_instrs_branch_unconditional_register
root decode_blra_aarch64_instrs_branch_unconditional_register
root decode_reta_aarch64_instrs_branch_unconditional_register

# A64 hints, barriers and the exclusive monitor (ir_int.c's hint space, DSB, DMB, ISB, CLREX), with the PAuth hints
# and XPACLRI. A hint word goes to the first clause that matches it, as Sail's decode tries them, and on to the next
# when that one throws Error_See: AUTIA's and AUTIB's clauses come first, then BTI's and the hints of one word each,
# then HINT's, which takes the rest of the space (NOP, YIELD, WFE, WFI, SEV, SEVL, whose own clauses come after it and
# are never reached) and hands the PAuth hints and XPACLRI on to theirs
root decode_autia_aarch64_instrs_integer_pac_autia_hint
root decode_autib_aarch64_instrs_integer_pac_autib_hint
root decode_bti_aarch64_instrs_system_hints
root decode_chkfeat_aarch64_instrs_system_hints
root decode_clrbhb_aarch64_instrs_system_hints
root decode_csdb_aarch64_instrs_system_hints
root decode_dgh_aarch64_instrs_system_hints
root decode_esb_aarch64_instrs_system_hints
root decode_gcsb_aarch64_instrs_system_hints
root decode_hint_aarch64_instrs_system_hints
root decode_clrex_aarch64_instrs_system_monitors
root decode_dmb_aarch64_instrs_system_barriers_dmb
root decode_dsb_aarch64_instrs_system_barriers_dsb
root decode_isb_aarch64_instrs_system_barriers_isb
root decode_pacia_aarch64_instrs_integer_pac_pacia_hint
root decode_pacib_aarch64_instrs_integer_pac_pacib_hint
root decode_xpac_aarch64_instrs_integer_pac_strip_hint

# what the generator knows when it recompiles (gen.c: the pc, the decode's SEE) and the state no instruction here
# reaches: the banked stack pointers the original SP_read picks among (nx.sail's reads GPR's last element), SPE's
# sample (nx.sail's constant) and the features' table (IsFeatureImplemented is lowered)
stop _PC
stop SP_EL0
stop SP_EL1
stop SP_EL2
stop SP_EL3
stop SEE
stop SPESampleInFlight
stop FeatureImpl

# what the generator lowers itself (tools/sailgen/README.md, "Builtins"): their Sail is not needed
stop IsFeatureImplemented
stop BranchTo
stop BranchNotTaken
stop EndOfInstruction

# the machine's actions the back end lowers (llvm.h, sg_NAME): the hints, the barriers, the exclusive monitor
stop Hint_Yield
stop Hint_WFE
stop Hint_WFI
stop SendEvent
stop SendEventLocal
stop DataMemoryBarrier
stop DataSynchronizationBarrier
stop SpeculativeStoreBypassBarrierToVA
stop SpeculativeStoreBypassBarrierToPA
stop InstructionSynchronizationBarrier
stop ConsumptionOfSpeculativeDataBarrier
stop SynchronizeErrors
stop TakeUnmaskedSErrorInterrupts
stop Hint_DGH
stop Hint_CLRBHB
stop ProfilingSynchronizationBarrier
stop TraceSynchronizationBarrier
stop ClearExclusiveLocal
stop ProcessorID

# never reached: behind a feature no guest has (a64.profile names no FEAT_TME, FEAT_BRBE, FEAT_SPE, FEAT_BTI,
# FEAT_DGH, FEAT_CLRBHB or FEAT_TRF, so sailgen folds the ifs on them) or behind a fixup's false (EL2Enabled,
# HaveGCS); a generation that reaches one stops on its missing definition
stop TSTATE
stop FailTransaction
stop BRBEBranchOnISB
stop BRBEISB
stop SPEISB
stop AArch64_vESBOperation
stop HCRX_EL2
stop GCSEnabled
stop BTypeCompatible_PACIXSP

# NX's fixups (nx.sail) in their place: the register file is GPR's elements; nothing writes a part of a register; no
# Guarded Control Stack, so its records are never reached; no guarded page; no EL2; no SError
stop EL2Enabled
stop IsHCRXEL2Enabled
stop AArch64_ESBOperation
stop HaveGCS
stop GCSPCREnabled
stop AddGCSRecord
stop LoadCheckGCSRecord
stop GetCurrentGCSPointer
stop SetCurrentGCSPointer
stop InGuardedPage
stop get_R
stop set_R
stop set_R_bits
stop SPESampleAddOpOther
stop AddPACIA
stop AddPACIB
stop AddPACDA
stop AddPACDB
stop AuthIA
stop AuthIB
stop AuthDA
stop AuthDB
stop Strip
stop AddPACGA
