#version 450
#extension GL_GOOGLE_include_directive : require
/* SPDX-License-Identifier: GPL-3.0-or-later
   Copyright 2026 the ScarletNX contributors */
/* A swizzled or tiled SceGxm texture to linear rows on the GPU (render.c runs it before the copy into the texture's
   image): the guest's bytes are read where they are, imported, and the CPU copies nothing. The body is
   swizzle.glsl, which the tests also run on the CPU; this file declares what it reads and writes. */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

/* render.c's SwizzleParams, member for member */
layout(push_constant) uniform Params {
    uint words;    /* the linear rows' words */
    uint elements; /* the texture's elements */
    uint src_base; /* the texture's first word in the bound source */
    uint src_at;   /* the texture's first byte in src_base's word */
    uint es;       /* log2 bytes an element, or 5 for 3-byte U8U8U8 */
    uint width;    /* elements a row */
    uint wl;       /* swizzled: log2 width */
    uint k;        /* swizzled: log2 of the smaller side */
    uint tiled;    /* nonzero: 32x32 tiles */
    uint tiles_x;  /* tiled: tiles a row */
    uint reverse;  /* nonzero: the linear rows (src) into the texture (dst), elements of four bytes or more */
    uint dst_base; /* reversed: the texture's first word in the bound destination */
};

layout(std430, binding = 0) readonly restrict buffer Src {
    uint src[];
};
layout(std430, binding = 1) writeonly restrict buffer Dst {
    uint dst[];
};

#include "swizzle.glsl"
