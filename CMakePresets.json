{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "default",
      "displayName": "Clang, for this machine",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "SNX_TRACY": "OFF",
        "SNX_DEPLOY": "ON"
      }
    },
    {
      "name": "tracy",
      "displayName": "Clang with the Tracy profiler client, for this machine",
      "inherits": "default",
      "cacheVariables": {
        "SNX_TRACY": "ON",
        "SNX_DEPLOY": "OFF"
      }
    },
    {
      "name": "windows-cross",
      "displayName": "Windows, cross-built with llvm-mingw",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-clang++",
        "CMAKE_RC_COMPILER": "x86_64-w64-mingw32-windres"
      }
    },
    {
      "name": "linux-cross-base",
      "hidden": true,
      "inherits": "base",
      "description": "A Linux cross build (PowerPC64, RISC-V, LoongArch, MIPS64, s390x): SNX_SYSROOT names the target's system root (scripts/ppc64-sysroot.sh, an Arch root of the architecture, or a gnu-cross buildroot's), whose pkg-config files the libraries are found by",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_AR": "llvm-ar",
        "CMAKE_RANLIB": "llvm-ranlib",
        "CMAKE_NM": "llvm-nm",
        "CMAKE_SYSROOT": "$env{SNX_SYSROOT}",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "ONLY",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=lld",
        "SNX_LLVM_CONFIG": "${sourceDir}/scripts/cross-llvm-config.sh",
        "SNX_DEPLOY": "OFF"
      }
    },
    {
      "name": "linux-ppc64le-cross",
      "displayName": "Linux ppc64le (ELFv2), cross-built with Clang",
      "inherits": "linux-cross-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/powerpc64le-linux-gnu/pkgconfig:$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "ppc64le",
        "CMAKE_C_COMPILER_TARGET": "powerpc64le-linux-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "powerpc64le-linux-gnu",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-ppc64le;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "linux-ppc64-cross",
      "displayName": "Linux ppc64 big-endian with glibc (ELFv1, Debian ports), cross-built with Clang, linked with GNU ld (binutils-powerpc64-linux-gnu: LLD takes no ELFv1)",
      "inherits": "linux-cross-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/powerpc64-linux-gnu/pkgconfig:$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "ppc64",
        "CMAKE_C_COMPILER_TARGET": "powerpc64-linux-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "powerpc64-linux-gnu",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-ppc64;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "linux-ppc64-elfv2-cross",
      "displayName": "Linux ppc64 big-endian with glibc (ELFv2, Arch POWER), cross-built with Clang (the 3DS runtime builds, but needs a little-endian host to run)",
      "inherits": "linux-cross-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "ppc64",
        "CMAKE_C_COMPILER_TARGET": "powerpc64-unknown-linux-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "powerpc64-unknown-linux-gnu",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-ppc64;-L;$env{SNX_SYSROOT}",
        "SNX_PPC64_ELFV2": "ON",
        "SNX_BUILD_GUI": "OFF"
      }
    },
    {
      "name": "linux-ppc64-g5-cross",
      "displayName": "Linux ppc64 big-endian with glibc (ELFv2), for the PowerPC 970 (PowerMac G5) and POWER4 on, cross-built with Clang",
      "inherits": "linux-ppc64-elfv2-cross",
      "cacheVariables": {
        "SNX_PPC64_CPU": "970"
      }
    },
    {
      "name": "linux-ppc64-musl-cross",
      "displayName": "Linux ppc64 big-endian with musl (ELFv2), cross-built with Clang",
      "inherits": "linux-cross-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "ppc64",
        "CMAKE_C_COMPILER_TARGET": "powerpc64-linux-musl",
        "CMAKE_CXX_COMPILER_TARGET": "powerpc64-linux-musl",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-ppc64;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "linux-riscv64-cross",
      "displayName": "Linux riscv64 (rv64gc), cross-built with Clang",
      "inherits": "linux-cross-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/riscv64-linux-gnu/pkgconfig:$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "riscv64",
        "CMAKE_C_COMPILER_TARGET": "riscv64-linux-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "riscv64-linux-gnu",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-riscv64;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "linux-loongarch64-cross",
      "displayName": "Linux loongarch64 (LA64), cross-built with Clang",
      "inherits": "linux-cross-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/loongarch64-linux-gnu/pkgconfig:$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "loongarch64",
        "CMAKE_C_COMPILER_TARGET": "loongarch64-linux-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "loongarch64-linux-gnu",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-loongarch64;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "linux-mips64-cross",
      "displayName": "Linux mips64 big-endian (MIPS64r2, n64), cross-built with Clang, linked with GNU ld; SNX_GCC_TOOLCHAIN names a GCC toolchain outside the sysroot (docs/MIPS64.md)",
      "inherits": "linux-cross-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib64/pkgconfig:$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "mips64",
        "CMAKE_C_COMPILER_TARGET": "mips64-unknown-linux-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "mips64-unknown-linux-gnu",
        "CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN": "$env{SNX_GCC_TOOLCHAIN}",
        "CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN": "$env{SNX_GCC_TOOLCHAIN}",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-mips64;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "linux-mips64el-cross",
      "displayName": "Linux mips64el (MIPS64r2, n64), cross-built with Clang, linked with GNU ld; SNX_GCC_TOOLCHAIN names a GCC toolchain outside the sysroot (docs/MIPS64.md)",
      "inherits": "linux-cross-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/mips64el-linux-gnuabi64/pkgconfig:$env{SNX_SYSROOT}/usr/lib64/pkgconfig:$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "mips64el",
        "CMAKE_C_COMPILER_TARGET": "mips64el-unknown-linux-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "mips64el-unknown-linux-gnu",
        "CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN": "$env{SNX_GCC_TOOLCHAIN}",
        "CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN": "$env{SNX_GCC_TOOLCHAIN}",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-mips64el;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "linux-s390x-cross",
      "displayName": "Linux s390x (z13), cross-built with Clang; SNX_GCC_TOOLCHAIN names a GCC toolchain outside the sysroot (docs/S390X.md)",
      "inherits": "linux-cross-base",
      "environment": {
        "PKG_CONFIG_LIBDIR": "$env{SNX_SYSROOT}/usr/lib/s390x-linux-gnu/pkgconfig:$env{SNX_SYSROOT}/usr/lib64/pkgconfig:$env{SNX_SYSROOT}/usr/lib/pkgconfig:$env{SNX_SYSROOT}/usr/share/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": "$env{SNX_SYSROOT}",
        "QEMU_LD_PREFIX": "$env{SNX_SYSROOT}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "s390x",
        "CMAKE_C_COMPILER_TARGET": "s390x-ibm-linux-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "s390x-ibm-linux-gnu",
        "CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN": "$env{SNX_GCC_TOOLCHAIN}",
        "CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN": "$env{SNX_GCC_TOOLCHAIN}",
        "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-s390x;-L;$env{SNX_SYSROOT}"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS on Apple silicon, Xcode's Clang (docs/APPLE.md)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_Swift_COMPILER_TARGET": "arm64-apple-macos13.0",
        "SNX_BUILD_GNUABI": "OFF"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS, cross-built on a Mac with Xcode (docs/APPLE.md); LLVM_DIR names scripts/apple-llvm.sh's",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_SYSTEM_PROCESSOR": "arm64",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_Swift_COMPILER_TARGET": "arm64-apple-ios16.0",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_DISABLE_FIND_PACKAGE_SDL3": "ON",
        "SNX_DEPLOY": "OFF",
        "SNX_BUILD_GNUABI": "OFF",
        "SNX_BUILD_3DS": "OFF",
        "SNX_BUILD_VITA": "OFF",
        "SNX_BUILD_AGB": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "The iOS simulator on Apple silicon, built like the ios preset; LLVM_DIR names scripts/apple-llvm.sh iossim's",
      "inherits": "ios",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_Swift_COMPILER_TARGET": "arm64-apple-ios16.0-simulator"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "tracy",
      "configurePreset": "tracy"
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross"
    },
    {
      "name": "linux-ppc64le-cross",
      "configurePreset": "linux-ppc64le-cross"
    },
    {
      "name": "linux-ppc64-cross",
      "configurePreset": "linux-ppc64-cross"
    },
    {
      "name": "linux-ppc64-elfv2-cross",
      "configurePreset": "linux-ppc64-elfv2-cross"
    },
    {
      "name": "linux-ppc64-g5-cross",
      "configurePreset": "linux-ppc64-g5-cross"
    },
    {
      "name": "linux-ppc64-musl-cross",
      "configurePreset": "linux-ppc64-musl-cross"
    },
    {
      "name": "linux-riscv64-cross",
      "configurePreset": "linux-riscv64-cross"
    },
    {
      "name": "linux-loongarch64-cross",
      "configurePreset": "linux-loongarch64-cross"
    },
    {
      "name": "linux-mips64-cross",
      "configurePreset": "linux-mips64-cross"
    },
    {
      "name": "linux-mips64el-cross",
      "configurePreset": "linux-mips64el-cross"
    },
    {
      "name": "linux-s390x-cross",
      "configurePreset": "linux-s390x-cross"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "ios",
      "configurePreset": "ios"
    },
    {
      "name": "ios-simulator",
      "configurePreset": "ios-simulator"
    }
  ],
  "testPresets": [
    {
      "name": "linux-ppc64le-cross",
      "configurePreset": "linux-ppc64le-cross",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 900
      }
    },
    {
      "name": "linux-ppc64-cross",
      "configurePreset": "linux-ppc64-cross",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 900
      }
    },
    {
      "name": "linux-ppc64-elfv2-cross",
      "configurePreset": "linux-ppc64-elfv2-cross",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 900
      }
    },
    {
      "name": "linux-ppc64-g5-cross",
      "configurePreset": "linux-ppc64-g5-cross",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 900
      }
    },
    {
