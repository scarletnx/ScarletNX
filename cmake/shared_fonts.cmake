# The shared fonts' stand-ins compiled into the runtime (hle/services/pl.c, which uses them when a game folder has no
# fonts/ of its own): one Noto Sans subset per script the six slots name, U+E000..U+E1FF blanked by pl_font.c, and
# yuzu's controller button glyphs for FontNintendoExtended, as Eden carries them. cmake/dependencies.cmake fetches the
# Noto subsets (their generation and licenses are described in docs/platforms/nx/filesystem.md and docs/CREDITS.md) and the
# button glyphs, from Eden's source.
#
# The console's shared memory is 0x1100000 bytes and the SDK maps that much, so the five text fonts and the button
# glyphs must fit in it: the four subsets total about 11 MB.
include_guard(GLOBAL)
file(GLOB snx_oss_ext "${YuzuOSSExtension_SOURCE_DIR}/*.cpp")
if(NOT snx_oss_ext)
    message(FATAL_ERROR "The shared fonts' stand-ins are missing (${YuzuOSSExtension_SOURCE_DIR})")
endif()
foreach(script IN ITEMS JP SC TC KR)
    set(snx_font_${script} "${NotoSans${script}Subset_SOURCE_DIR}/NotoSans${script}-Subset.ttf")
    if(NOT EXISTS "${snx_font_${script}}")
        message(FATAL_ERROR "The shared fonts' stand-in ${snx_font_${script}} is missing")
    endif()
endforeach()

# one font's bytes as a C array in the generated file named by out, which must be opened by the caller
function(snx_font_array out name path)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" size)
    math(EXPR size "${size} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " bytes "${bytes}")
    file(APPEND "${out}" "const unsigned char ${name}[] = {\n${bytes}\n};\nconst size_t ${name}_size = ${size};\n")
endfunction()

set(snx_fonts_c "${PROJECT_BINARY_DIR}/generated/shared_fonts.c")
file(WRITE "${snx_fonts_c}"
"/* Generated by cmake/shared_fonts.cmake from Noto Sans JP, SC, TC and KR (the SIL Open Font License 1.1, subset to
   each script's standard character set) and yuzu's YuzuOSSExtension (GPL-2.0-or-later). Do not edit. */
#include <stddef.h>
extern const unsigned char snx_font_japanese[], snx_font_chinese_simplified[], snx_font_chinese_traditional[],
    snx_font_korean[], snx_font_extended[];
extern const size_t snx_font_japanese_size, snx_font_chinese_simplified_size, snx_font_chinese_traditional_size,
    snx_font_korean_size, snx_font_extended_size;
")
snx_font_array("${snx_fonts_c}" snx_font_japanese "${snx_font_JP}")
snx_font_array("${snx_fonts_c}" snx_font_chinese_simplified "${snx_font_SC}")
snx_font_array("${snx_fonts_c}" snx_font_chinese_traditional "${snx_font_TC}")
snx_font_array("${snx_fonts_c}" snx_font_korean "${snx_font_KR}")

file(READ "${snx_oss_ext}" snx_font_src)
string(FIND "${snx_font_src}" "{{" snx_font_at)
string(SUBSTRING "${snx_font_src}" ${snx_font_at} -1 snx_font_src)
string(REGEX MATCHALL "0x[0-9a-fA-F][0-9a-fA-F]" snx_font_list "${snx_font_src}")
list(LENGTH snx_font_list snx_font_extended_size)
if(snx_font_extended_size LESS 12)
    message(FATAL_ERROR "${snx_oss_ext} holds no font")
endif()
list(JOIN snx_font_list "," snx_font_extended_bytes)
string(REGEX REPLACE "((0x[0-9a-fA-F][0-9a-fA-F],){20})" "\\1\n    " snx_font_extended_bytes "${snx_font_extended_bytes}")
file(APPEND "${snx_fonts_c}" "const unsigned char snx_font_extended[] = {\n${snx_font_extended_bytes}\n};\nconst size_t snx_font_extended_size = ${snx_font_extended_size};\n")
