# snx_controls_skins: the on-screen controls' skins that ship (dist/controls/skins/<name>/, made by
# scripts/build-skins.py), each skin's .cfg and PNGs compiled into the runtime, which controls_skin=<name> reads
# (runtime/platform/vpad_skin.c): the same files on every system, an AppImage's and Android's included. A .cfg is
# taken byte for byte: its reader takes CR LF line ends as LF ones
include_guard(GLOBAL)
file(GLOB snx_skin_files CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/dist/controls/skins/*/*.cfg"
     "${PROJECT_SOURCE_DIR}/dist/controls/skins/*/*.png")
list(SORT snx_skin_files)
set(snx_skin_arrays "")
set(snx_skin_rows "")
set(snx_skin_count 0)
foreach(path IN LISTS snx_skin_files)
    get_filename_component(skin_dir "${path}" DIRECTORY)
    get_filename_component(skin "${skin_dir}" NAME)
    get_filename_component(name "${path}" NAME)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" size)
    math(EXPR size "${size} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " bytes "${bytes}")
    string(APPEND snx_skin_arrays "static const unsigned char file${snx_skin_count}[] = {\n    ${bytes}\n};\n")
    string(APPEND snx_skin_rows "    {\"${skin}\", \"${name}\", file${snx_skin_count}, ${size}},\n")
    set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    math(EXPR snx_skin_count "${snx_skin_count} + 1")
endforeach()
if(snx_skin_count EQUAL 0)
    message(FATAL_ERROR "dist/controls/skins holds no skin: scripts/build-skins.py makes them")
endif()
# file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/controls_skins.c" @ONLY CONTENT
"/* Generated by cmake/controls_skins.cmake from dist/controls/skins. Do not edit. */
#include \"nx/runtime/platform/controls_skins.h\"
@snx_skin_arrays@
const SnxSkinFile snx_controls_skins[] = {
@snx_skin_rows@};
const size_t snx_controls_skins_count = @snx_skin_count@;
")
