# The version of the code the native back ends make, which the JIT cache's key names (jit/jit_cache_key*.c): a hash of
# every file that decides it (src/common/cpu/recompiler/CMakeLists.txt lists them: the back ends' and the object
# writers' sources, sailgen's headers and what it generated for this build). It changes only when one of them does, so
# a cache stays across builds that leave the native code as it was and is refused after one that may change it.
#
# cmake -DLIST=<file, one path a line> -DSOURCE=<the source tree> -DBINARY=<the build tree> -DOUT=<C file> -P this
# Each file is named by its path under SOURCE or BINARY, so two trees of the same files hash alike. OUT is written only
# where its text changes, so what compiles it does not again. A file of the list that is missing stops, named.
foreach(variable LIST SOURCE BINARY OUT)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "native_code_hash.cmake: -D${variable}= is missing")
    endif()
endforeach()
file(STRINGS "${LIST}" files)
set(lines "")
foreach(path IN LISTS files)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "native_code_hash.cmake: ${path}, of ${LIST}, is missing")
    endif()
    file(SHA256 "${path}" hash)
    cmake_path(IS_PREFIX BINARY "${path}" NORMALIZE in_binary)
    if(in_binary)
        file(RELATIVE_PATH name "${BINARY}" "${path}")
        set(name "build/${name}")
    else()
        file(RELATIVE_PATH name "${SOURCE}" "${path}")
    endif()
    list(APPEND lines "${name} ${hash}")
endforeach()
list(SORT lines)
list(JOIN lines "\n" all)
string(SHA256 version "${all}")
string(SUBSTRING "${version}" 0 16 version)
list(LENGTH lines count)
set(text "/* Generated by cmake/native_code_hash.cmake from ${count} files. Do not edit. */
#include \"common/cpu/recompiler/mach/native.h\"
const char* snx_native_code(void) { return \"${version}\"; }
")
set(was "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" was)
endif()
if(NOT was STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
