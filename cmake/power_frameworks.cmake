# plat_posix.c's macOS power watcher calls CoreFoundation's run loop itself (CFRunLoopAddSource, CFRunLoopGetCurrent,
# CFRunLoopRun and kCFRunLoopDefaultMode) beside IOKit's power source notification. CoreFoundation's symbols arrive
# only from a library the link names, and "-framework IOKit" names IOKit alone: a static SDL3 brings Cocoa, which
# carries them, and a shared SDL3 brings nothing of its own. So a build whose SDL3 is the system's (SNX_SYSTEM_SDL3=ON,
# the FreeBSD default and Homebrew's) fails to link a target that compiles the file with IOKit alone, with
# _CFRunLoopAddSource, _CFRunLoopGetCurrent, _CFRunLoopRun and _kCFRunLoopDefaultMode. The configure stops on one,
# before the build.
include_guard(GLOBAL)

# what a target's link line holds, its linked targets' interfaces included, as one string
function(snx_link_line target out)
    set(queue "${target}")
    set(seen "")
    set(named "")
    while(queue)
        list(POP_FRONT queue current)
        if(current IN_LIST seen)
            continue()
        endif()
        list(APPEND seen "${current}")
        if(NOT TARGET "${current}")
            list(APPEND named "${current}")
            continue()
        endif()
        get_target_property(type "${current}" TYPE)
        set(props INTERFACE_LINK_LIBRARIES)
        if(NOT type STREQUAL "INTERFACE_LIBRARY")
            list(APPEND props LINK_LIBRARIES)
        endif()
        foreach(prop IN LISTS props)
            get_target_property(value "${current}" ${prop})
            if(NOT value)
                continue()
            endif()
            list(APPEND named ${value})
            foreach(entry IN LISTS value)
                if(TARGET "${entry}")
                    list(APPEND queue "${entry}")
                endif()
            endforeach()
        endforeach()
    endwhile()
    string(REPLACE ";" " " named "${named}")
    set(${out} "${named}" PARENT_SCOPE)
endfunction()

function(snx_check_power_frameworks_dir dir)
    get_directory_property(targets DIRECTORY "${dir}" BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(type STREQUAL "INTERFACE_LIBRARY")
            continue()
        endif()
        get_target_property(sources ${target} SOURCES)
        set(plat_posix OFF)
        foreach(source IN LISTS sources)
            if(source MATCHES "plat_posix\\.c$")
                set(plat_posix ON)
            endif()
        endforeach()
        if(NOT plat_posix)
            continue()
        endif()
        snx_link_line(${target} named)
        foreach(framework IN ITEMS IOKit CoreFoundation)
            if(NOT named MATCHES "-framework ${framework}")
                message(FATAL_ERROR "The target ${target} compiles src/nx/runtime/platform/plat_posix.c, whose macOS "
                                    "power watcher calls ${framework}: link it with \"-framework ${framework}\" "
                                    "(cmake/power_frameworks.cmake)")
            endif()
        endforeach()
    endforeach()
    get_directory_property(subdirs DIRECTORY "${dir}" SUBDIRECTORIES)
    foreach(subdir IN LISTS subdirs)
        cmake_path(IS_PREFIX PROJECT_SOURCE_DIR "${subdir}" NORMALIZE ours)
        cmake_path(IS_PREFIX PROJECT_BINARY_DIR "${subdir}" NORMALIZE generated)
        if(ours AND NOT generated AND NOT subdir MATCHES "/\\.cache/")
            snx_check_power_frameworks_dir("${subdir}")
        endif()
    endforeach()
endfunction()

# Called at the end of the top-level CMakeLists.txt, once every target is defined
function(snx_check_power_frameworks)
    if(APPLE AND NOT IOS)
        snx_check_power_frameworks_dir("${PROJECT_SOURCE_DIR}")
    endif()
endfunction()
