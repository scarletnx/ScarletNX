# snx_meson_machine_file(FILE ARGS ERROR TARGET): the machine file a meson project built from CMake (dav1d's,
# cmake/dav1d.cmake) is set up with, so that it compiles for the target with the flags FFmpeg's configure gets
# (cmake/ffmpeg.cmake): the target's triple, sysroot and CPU baseline (SNX_TARGET_FLAGS and SNX_TARGET_LDFLAGS,
# cmake/cross.cmake), the Apple SDK, architecture and oldest system version (SNX_APPLE_FLAGS, cmake/apple.cmake), or
# the NDK's triple and sysroot on Android. A cross build (the Linux and NetBSD cross presets, Android, iOS) gets a cross
# file, which also names the target machine, as meson takes it from that file alone; a native build with such flags (a
# Mac, a host whose CPU baseline cross.cmake sets) a native file; any other build none, meson finding the compiler from
# CC. FILE is written only when its text changes, so a configure step that depends on it runs again only then.
# ARGS gets meson setup's option for the file (--cross-file=FILE, --native-file=FILE, or empty), TARGET the machine
# built for ("linux ppc64, big-endian"). ERROR gets why no file can be made, with the value that stops it, and is
# empty otherwise: a cross build's system or processor meson has no name for, or a flag or path with a ' or a line
# break in it, which a meson machine file cannot hold.
include_guard(GLOBAL)

# meson's quoting of one value: its machine files read a backslash as itself and have no escape for a quote
function(snx_meson_machine_quote value out error)
    set(${out} "'${value}'" PARENT_SCOPE)
    set(${error} "" PARENT_SCOPE)
    if(value MATCHES "['\n\r]")
        set(${error} "a meson machine file cannot hold the ' or line break in '${value}'" PARENT_SCOPE)
    endif()
endfunction()

# a list as a meson array, ['a', 'b']
function(snx_meson_machine_array values out error)
    set(${error} "" PARENT_SCOPE)
    set(items "")
    foreach(value IN LISTS values)
        snx_meson_machine_quote("${value}" quoted why)
        if(why)
            set(${error} "${why}" PARENT_SCOPE)
            return()
        endif()
        list(APPEND items "${quoted}")
    endforeach()
    list(JOIN items ", " joined)
    set(${out} "[${joined}]" PARENT_SCOPE)
endfunction()

# the file's text and kind (cross, native, or empty for none), or the reason none can be made
function(snx_meson_machine_text out_text out_kind out_error out_target)
    set(${out_text} "" PARENT_SCOPE)
    set(${out_kind} "" PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)

    # the target's compile flags, as FFmpeg's configure gets them
    set(c_args ${SNX_APPLE_FLAGS} ${SNX_TARGET_FLAGS})
    if(ANDROID)
        list(APPEND c_args --target=${CMAKE_C_COMPILER_TARGET} --sysroot=${CMAKE_SYSROOT})
    endif()
    set(link_args ${c_args} ${SNX_TARGET_LDFLAGS})

    # meson's names for the machine: its system, CPU family, CPU and byte order
    set(processor "${CMAKE_SYSTEM_PROCESSOR}")
    if(APPLE AND CMAKE_OSX_ARCHITECTURES)
        # an Apple build names its architecture there, CMAKE_SYSTEM_PROCESSOR being optional on iOS
        set(processor "${CMAKE_OSX_ARCHITECTURES}")
    endif()
    string(TOLOWER "${processor}" cpu)
    set(cpu_family "")
    if(cpu MATCHES "^(x86_64|amd64)$")
        set(cpu x86_64)
        set(cpu_family x86_64)
    elseif(cpu MATCHES "^(aarch64|arm64)$")
        set(cpu aarch64)
        set(cpu_family aarch64)
    elseif(cpu MATCHES "^(ppc64|powerpc64)$")
        set(cpu ppc64)
        set(cpu_family ppc64)
    elseif(cpu MATCHES "^(ppc64le|powerpc64le)$")
        # dav1d's POWER code builds for the CPU named ppc64le alone
        set(cpu ppc64le)
        set(cpu_family ppc64)
    elseif(cpu MATCHES "^(riscv64|loongarch64|s390x)$")
        set(cpu_family ${cpu})
    elseif(cpu MATCHES "^mips64(el)?$")
        set(cpu_family mips64)
    endif()
    set(subsystem "")
    if(IOS)
        set(system darwin)
        set(subsystem ios)
        if(SNX_IOS_SIMULATOR)
            set(subsystem ios-simulator)
        endif()
    elseif(CMAKE_SYSTEM_NAME MATCHES "^(Linux|Android|NetBSD|FreeBSD|OpenBSD|Windows|Darwin)$")
        string(TOLOWER "${CMAKE_SYSTEM_NAME}" system)
    else()
        set(system "")
    endif()
    set(endian little)
    if(CMAKE_C_BYTE_ORDER STREQUAL "BIG_ENDIAN")
        set(endian big)
    endif()
    if(system AND cpu_family)
        set(${out_target} "${system} ${cpu}, ${endian}-endian" PARENT_SCOPE)
    else()
        set(${out_target} "${CMAKE_SYSTEM_NAME} ${processor}" PARENT_SCOPE)
    endif()

    if(CMAKE_CROSSCOMPILING)
        if(NOT system)
            set(${out_error} "meson has no system name for a cross build to ${CMAKE_SYSTEM_NAME}" PARENT_SCOPE)
            return()
        elseif(NOT cpu_family)
            set(${out_error} "meson has no CPU family for a cross build to ${processor}" PARENT_SCOPE)
            return()
        endif()
        set(kind cross)
    elseif(c_args)
        set(kind native)
    else()
        return()
    endif()

    set(binaries c "${CMAKE_C_COMPILER}")
    if(CMAKE_AR)
        list(APPEND binaries ar "${CMAKE_AR}")
    endif()
    if(SNX_NASM)
        list(APPEND binaries nasm "${SNX_NASM}")
    endif()
    set(text "[binaries]\n")
    while(binaries)
        list(POP_FRONT binaries name path)
        snx_meson_machine_array("${path}" value why)
        if(why)
            set(${out_error} "${why}" PARENT_SCOPE)
            return()
        endif()
        string(APPEND text "${name} = ${value}\n")
    endwhile()
    foreach(option IN ITEMS c_args link_args)
        snx_meson_machine_array("${${option}}" ${option} why)
        if(why)
            set(${out_error} "${why}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    string(APPEND text "\n[built-in options]\nc_args = ${c_args}\nc_link_args = ${link_args}\n")
    if(kind STREQUAL "cross")
        # no program of the target runs on the machine doing the build, even one of the same processor and system
        # (an iOS program on a Mac)
        string(APPEND text "\n[properties]\nneeds_exe_wrapper = true\n")
        string(APPEND text "\n[host_machine]\nsystem = '${system}'\n")
        if(subsystem)
            string(APPEND text "subsystem = '${subsystem}'\n")
        endif()
        string(APPEND text "cpu_family = '${cpu_family}'\ncpu = '${cpu}'\nendian = '${endian}'\n")
    endif()
    set(${out_text} "${text}" PARENT_SCOPE)
    set(${out_kind} ${kind} PARENT_SCOPE)
endfunction()

function(snx_meson_machine_file file out_args out_error out_target)
    snx_meson_machine_text(text kind error target)
    set(${out_error} "${error}" PARENT_SCOPE)
    set(${out_target} "${target}" PARENT_SCOPE)
    if(NOT kind OR error)
        # one an earlier configure made would be read as this build's
        file(REMOVE "${file}")
        set(${out_args} "" PARENT_SCOPE)
        return()
    endif()
    file(WRITE "${file}.new" "${text}")
    file(COPY_FILE "${file}.new" "${file}" ONLY_IF_DIFFERENT)
    file(REMOVE "${file}.new")
    set(${out_args} "--${kind}-file=${file}" PARENT_SCOPE)
endfunction()
