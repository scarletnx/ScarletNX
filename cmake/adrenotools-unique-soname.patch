+namespace {
+/**
+ * @brief A custom driver package staged under unique sonames
+ * @note Needed when a library with the driver's soname (vulkan.adreno.so) is already loaded in the process, usually
+ *       the system driver: bionic dedups by soname in the cloned namespace and would hand back the system copy
+ */
+struct UniquePackage {
+    std::string dir; //!< The staging dir, with a trailing slash
+    std::vector<std::pair<std::string, std::string>> names; //!< Original basename -> staged basename
+
+    const char *Map(const char *name) const {
+        for (const auto &entry : names)
+            if (entry.first == name)
+                return entry.second.c_str();
+        return name;
+    }
+};
+
+/**
+ * @brief The rename rule: flip the case of the last ASCII letter before ".so"
+ * @example vulkan.adreno.so -> vulkan.adrenO.so, libgsl.so -> libgsL.so, mapper@4.0.so -> mappeR@4.0.so
+ * @note The length never changes, so the name can be rewritten in place inside .dynstr
+ */
+bool UniqueName(const std::string &name, std::string &out) {
+    if (name.size() <= 3 || name.compare(name.size() - 3, 3, ".so") != 0)
+        return false;
+
+    out = name;
+    for (size_t i{name.size() - 3}; i-- > 0;) {
+        char c{out[i]};
+        if (c >= 'a' && c <= 'z') {
+            out[i] = static_cast<char>(c - 'a' + 'A');
+            return true;
+        } else if (c >= 'A' && c <= 'Z') {
+            out[i] = static_cast<char>(c - 'A' + 'a');
+            return true;
+        }
+    }
+    return false;
+}
+
+bool VaddrToOffset(const std::vector<uint8_t> &buf, const ElfW(Phdr) *phdrs, size_t phnum, ElfW(Addr) vaddr, size_t &out) {
+    for (size_t i{}; i < phnum; i++) {
+        const auto &ph{phdrs[i]};
+        if (ph.p_type == PT_LOAD && vaddr >= ph.p_vaddr && vaddr - ph.p_vaddr < ph.p_filesz) {
+            out = ph.p_offset + (vaddr - ph.p_vaddr);
+            return out < buf.size();
+        }
+    }
+    return false;
+}
+
+/**
+ * @brief Rewrites DT_SONAME, DT_NEEDED and verneed file names that name a package file to their staged names
+ * @note Same-length in-place edits of .dynstr, every other byte of the ELF is untouched
+ */
+bool RewriteDynamicNames(std::vector<uint8_t> &buf, const UniquePackage &package, const char *path) {
+    if (buf.size() < sizeof(ElfW(Ehdr)) || memcmp(buf.data(), ELFMAG, SELFMAG) != 0) {
+        LOGE("hook_android_dlopen_ext: staging: %s is not an ELF file", path);
+        return false;
+    }
+
+    auto ehdr{reinterpret_cast<const ElfW(Ehdr) *>(buf.data())};
+    if (ehdr->e_ident[EI_CLASS] != (sizeof(void *) == 8 ? ELFCLASS64 : ELFCLASS32) ||
+        ehdr->e_phentsize != sizeof(ElfW(Phdr)) || ehdr->e_phoff > buf.size() ||
+        (buf.size() - ehdr->e_phoff) / sizeof(ElfW(Phdr)) < ehdr->e_phnum) {
+        LOGE("hook_android_dlopen_ext: staging: %s has an unexpected ELF header", path);
+        return false;
+    }
+
+    auto phdrs{reinterpret_cast<const ElfW(Phdr) *>(buf.data() + ehdr->e_phoff)};
+    const ElfW(Dyn) *dyn{};
+    size_t dynCount{};
+    for (size_t i{}; i < ehdr->e_phnum; i++) {
+        if (phdrs[i].p_type == PT_DYNAMIC && phdrs[i].p_offset <= buf.size() && buf.size() - phdrs[i].p_offset >= phdrs[i].p_filesz) {
+            dyn = reinterpret_cast<const ElfW(Dyn) *>(buf.data() + phdrs[i].p_offset);
+            dynCount = phdrs[i].p_filesz / sizeof(ElfW(Dyn));
+        }
+    }
+
+    ElfW(Addr) strtabAddr{}, verneedAddr{};
+    size_t strsz{}, verneedNum{};
+    for (size_t i{}; dyn && i < dynCount && dyn[i].d_tag != DT_NULL; i++) {
+        switch (dyn[i].d_tag) {
+            case DT_STRTAB: strtabAddr = dyn[i].d_un.d_ptr; break;
+            case DT_STRSZ: strsz = dyn[i].d_un.d_val; break;
+            case DT_VERNEED: verneedAddr = dyn[i].d_un.d_ptr; break;
+            case DT_VERNEEDNUM: verneedNum = dyn[i].d_un.d_val; break;
+            default: break;
+        }
+    }
+
+    size_t strtab{};
+    if (!dyn || !strsz || !VaddrToOffset(buf, phdrs, ehdr->e_phnum, strtabAddr, strtab) || buf.size() - strtab < strsz) {
+        LOGE("hook_android_dlopen_ext: staging: %s has no usable dynamic string table", path);
+        return false;
+    }
+
+    auto rename{[&](size_t nameOffset) {
+        if (nameOffset >= strsz)
+            return false;
+        auto name{reinterpret_cast<char *>(buf.data() + strtab + nameOffset)};
+        size_t maxLength{strsz - nameOffset};
+        if (!memchr(name, '\0', maxLength))
+            return false;
+        for (const auto &entry : package.names) {
+            // Offsets can be shared (verneed usually points at the DT_NEEDED string), a second visit is a no-op
+            if (entry.first == name) {
+                memcpy(name, entry.second.data(), entry.second.size());
+                break;
+            }
+        }
+        return true;
+    }};
+
+    for (size_t i{}; i < dynCount && dyn[i].d_tag != DT_NULL; i++) {
+        if ((dyn[i].d_tag == DT_NEEDED || dyn[i].d_tag == DT_SONAME) && !rename(dyn[i].d_un.d_val)) {
+            LOGE("hook_android_dlopen_ext: staging: %s has a bad dynamic string offset", path);
+            return false;
+        }
+    }
+
+    // bionic matches verneed vn_file against the soname of each DT_NEEDED child, so these must follow the rename
+    size_t verneed{};
+    if (verneedNum && VaddrToOffset(buf, phdrs, ehdr->e_phnum, verneedAddr, verneed)) {
+        for (size_t i{}; i < verneedNum; i++) {
+            if (buf.size() - verneed < sizeof(ElfW(Verneed))) {
+                LOGE("hook_android_dlopen_ext: staging: %s has a truncated verneed table", path);
+                return false;
+            }
+            auto entry{reinterpret_cast<const ElfW(Verneed) *>(buf.data() + verneed)};
+            if (!rename(entry->vn_file)) {
+                LOGE("hook_android_dlopen_ext: staging: %s has a bad verneed file offset", path);
+                return false;
+            }
+            if (!entry->vn_next)
+                break;
+            verneed += entry->vn_next;
+            if (verneed >= buf.size())
+                return false;
+        }
+    }
+
+    return true;
+}
+
+bool ReadFile(const std::string &path, std::vector<uint8_t> &out) {
+    int fd{open(path.c_str(), O_RDONLY | O_CLOEXEC)};
+    if (fd < 0)
+        return false;
+
+    struct stat st{};
+    if (fstat(fd, &st) != 0) {
+        close(fd);
+        return false;
+    }
+
+    out.resize(static_cast<size_t>(st.st_size));
+    size_t done{};
+    while (done < out.size()) {
+        ssize_t n{read(fd, out.data() + done, out.size() - done)};
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0) {
+            int saved{errno};
+            close(fd);
+            errno = n == 0 ? EIO : saved;
+            return false;
+        }
+        done += static_cast<size_t>(n);
+    }
+    close(fd);
+    return true;
+}
+
+/**
+ * @brief Writes a staged copy through a temporary name so a failure never leaves a partial library behind
+ * @note The copy takes the source mtime so the next start can skip it when the source is unchanged
+ */
+bool WriteFileAtomically(const std::string &path, const std::string &tmpPath, const std::vector<uint8_t> &data, const struct stat &source) {
+    int fd{open(tmpPath.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600)};
+    if (fd < 0)
+        return false;
+
+    size_t done{};
+    while (done < data.size()) {
+        ssize_t n{write(fd, data.data() + done, data.size() - done)};
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0) {
+            int saved{errno};
+            close(fd);
+            unlink(tmpPath.c_str());
+            errno = n == 0 ? EIO : saved;
+            return false;
+        }
+        done += static_cast<size_t>(n);
+    }
+
+    const struct timespec times[2]{source.st_atim, source.st_mtim};
+    if (futimens(fd, times) != 0 || fsync(fd) != 0 || close(fd) != 0) {
+        int saved{errno};
+        unlink(tmpPath.c_str());
+        errno = saved;
+        return false;
+    }
+
+    if (rename(tmpPath.c_str(), path.c_str()) != 0) {
+        int saved{errno};
+        unlink(tmpPath.c_str());
+        errno = saved;
+        return false;
+    }
+    return true;
+}
+
+/**
+ * @brief Copies every *.so of the custom driver dir into <dir>/unique/ under its staged name with patched sonames
+ */
+bool StageUniquePackage(std::string driverDir, UniquePackage &package) {
+    if (driverDir.empty())
+        return false;
+    if (driverDir.back() != '/')
+        driverDir += '/';
+    package.dir = driverDir + "unique/";
+
+    DIR *dir{opendir(driverDir.c_str())};
+    if (!dir) {
+        LOGE("hook_android_dlopen_ext: staging: cannot open %s: %s", driverDir.c_str(), strerror(errno));
+        return false;
+    }
+
+    while (auto entry{readdir(dir)}) {
+        std::string name{entry->d_name}, staged;
+        struct stat st{};
+        if (name[0] == '.' || !UniqueName(name, staged) || stat((driverDir + name).c_str(), &st) != 0 || !S_ISREG(st.st_mode))
+            continue;
+        package.names.emplace_back(std::move(name), std::move(staged));
+    }
+    closedir(dir);
+
+    // Two package files that differ only in the case of that letter would stage onto each other
+    for (const auto &a : package.names) {
+        for (const auto &b : package.names) {
+            if (a.second == b.first) {
+                LOGE("hook_android_dlopen_ext: staging: %s and %s collide after renaming", a.first.c_str(), b.first.c_str());
+                return false;
+            }
+        }
+    }
+
+    if (mkdir(package.dir.c_str(), 0700) != 0 && errno != EEXIST) {
+        LOGE("hook_android_dlopen_ext: staging: cannot create %s: %s", package.dir.c_str(), strerror(errno));
+        return false;
+    }
+
+    for (const auto &[name, staged] : package.names) {
+        std::string source{driverDir + name}, target{package.dir + staged};
+        struct stat sourceStat{}, targetStat{};
+        if (stat(source.c_str(), &sourceStat) != 0) {
+            LOGE("hook_android_dlopen_ext: staging: cannot stat %s: %s", source.c_str(), strerror(errno));
+            return false;
+        }
+
+        if (stat(target.c_str(), &targetStat) == 0 && targetStat.st_size == sourceStat.st_size &&
+            targetStat.st_mtim.tv_sec == sourceStat.st_mtim.tv_sec && targetStat.st_mtim.tv_nsec == sourceStat.st_mtim.tv_nsec)
+            continue;
+
+        std::vector<uint8_t> data;
+        if (!ReadFile(source, data)) {
+            LOGE("hook_android_dlopen_ext: staging: cannot read %s: %s", source.c_str(), strerror(errno));
+            return false;
+        }
+
+        if (!RewriteDynamicNames(data, package, source.c_str()))
+            return false;
+
+        if (!WriteFileAtomically(target, package.dir + "." + staged + ".tmp", data, sourceStat)) {
+            LOGE("hook_android_dlopen_ext: staging: cannot write %s: %s", target.c_str(), strerror(errno));
+            return false;
+        }
+    }
+
+    return true;
+}
