# snx_window_icon: the program's icon on the windows it opens, from the 128 PNG of dist/icons compiled in, which SDL
# decodes and hands the window system. Windows takes the executable's own instead (runtime.rc), with every size
include_guard(GLOBAL)
set(snx_window_icon_png "${PROJECT_SOURCE_DIR}/dist/icons/hicolor/128x128/apps/wimsy.png")
# December's, the Christmas Wimsy (scripts/make-icons.py draws it from dist/splash/wimsy-xmas.svg)
set(snx_window_icon_xmas_png "${PROJECT_SOURCE_DIR}/dist/icons/hicolor/128x128/apps/wimsy-xmas.png")
set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${snx_window_icon_png}"
    "${snx_window_icon_xmas_png}")
# one PNG as a C array named name, with name_size its length
function(snx_window_icon_array png name out)
    file(READ "${png}" hex HEX)
    string(LENGTH "${hex}" size)
    math(EXPR size "${size} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " bytes "${bytes}")
    set(${out} "extern const unsigned char ${name}[];
extern const size_t ${name}_size;
const unsigned char ${name}[] = {
    ${bytes}
};
const size_t ${name}_size = ${size};
" PARENT_SCOPE)
endfunction()
snx_window_icon_array("${snx_window_icon_png}" snx_window_icon_png snx_window_icon_main)
snx_window_icon_array("${snx_window_icon_xmas_png}" snx_window_icon_xmas_png snx_window_icon_xmas)
# file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/window_icon_png.c" @ONLY CONTENT
"/* Generated by cmake/window_icon.cmake from dist/icons/hicolor/128x128/apps/wimsy.png and wimsy-xmas.png. Do not
   edit. */
#include <stddef.h>
@snx_window_icon_main@@snx_window_icon_xmas@")
add_library(snx_window_icon STATIC "${PROJECT_SOURCE_DIR}/src/common/utilities/window_icon.c"
    "${PROJECT_BINARY_DIR}/generated/window_icon_png.c")
target_link_libraries(snx_window_icon PUBLIC SDL3::SDL3)
target_compile_options(snx_window_icon PRIVATE -Wall -Wextra -Werror=missing-prototypes)
include("${PROJECT_SOURCE_DIR}/tests/cmake/window_icon.cmake") # its tests
