# The 3DS system archives' open stand-ins compiled into the runtime (src/3ds/services/fs.c serves them through the NCCH
# archive in place of the system titles no console here has): the RomFS images B3n30/citra_system_archives makes
# (GPL-2.0-or-later; Weiyi Wang's Mii data, country list and RomFS builder, a shared font of Montserrat (SIL OFL 1.1)
# and GNU Unifont 10.0.05 (GPL-2.0-or-later with the font exception)), as Azahar carries them in
# externals/open_source_archives. cmake/dependencies.cmake fetches those headers; each is one C byte array, whose
# initializer is taken as it is, once it is checked to hold only bytes, and its length
include_guard(GLOBAL)
set(snx_archives_c "/* Generated by cmake/ctr_system_archives.cmake from Azahar's externals/open_source_archives, made by
   B3n30/citra_system_archives. Do not edit. */
#include \"3ds/services/archives.h\"
")
foreach(snx_archive MiiData:snx_ctr_mii_data CountryList:snx_ctr_country_list SharedFont:snx_ctr_shared_font
                    BadWordList:snx_ctr_bad_word_list)
    string(REPLACE ":" ";" snx_archive "${snx_archive}")
    list(GET snx_archive 0 snx_package)
    list(GET snx_archive 1 snx_symbol)
    file(GLOB snx_header "${Azahar${snx_package}_SOURCE_DIR}/*.h")
    if(NOT snx_header)
        message(FATAL_ERROR "The system archive stand-in ${snx_package} is missing (${Azahar${snx_package}_SOURCE_DIR})")
    endif()
    file(READ "${snx_header}" snx_src)
    string(FIND "${snx_src}" "{" snx_open)
    string(FIND "${snx_src}" "};" snx_close REVERSE)
    if(snx_open LESS 0 OR snx_close LESS snx_open OR NOT snx_src MATCHES "_len = ([0-9]+);")
        message(FATAL_ERROR "${snx_header} is not a byte array and its length")
    endif()
    set(snx_size "${CMAKE_MATCH_1}")
    math(EXPR snx_open "${snx_open} + 1")
    math(EXPR snx_length "${snx_close} - ${snx_open}")
    string(SUBSTRING "${snx_src}" ${snx_open} ${snx_length} snx_body)
    if(NOT snx_body MATCHES "^[0-9a-fx, \r\n]*$")
        message(FATAL_ERROR "${snx_header} holds more than bytes")
    endif()
    string(APPEND snx_archives_c "const unsigned char ${snx_symbol}[] = {${snx_body}};
const size_t ${snx_symbol}_size = ${snx_size};
")
endforeach()
# file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/ctr_system_archives.c" CONTENT "${snx_archives_c}")
