# The drivers known to break a Vulkan extension or feature, src/common/gpu/vk/extension_bans.txt, compiled in as its text
# (generated/vk_extension_bans_text.c: snx_vk_extension_bans_text) for the device to read at start
# (src/common/gpu/vk/extension_bans.c) and tests/vk_extension_bans.c to check. Each directory that compiles it names the
# file by its path: the guard skips a second include, and with it any variable set here
include_guard(GLOBAL)
set(snx_vk_extension_bans_txt "${PROJECT_SOURCE_DIR}/src/common/gpu/vk/extension_bans.txt")
set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${snx_vk_extension_bans_txt}")
file(READ "${snx_vk_extension_bans_txt}" snx_vk_extension_bans_hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," snx_vk_extension_bans_bytes "${snx_vk_extension_bans_hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " snx_vk_extension_bans_bytes
       "${snx_vk_extension_bans_bytes}")
# file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/vk_extension_bans_text.c" @ONLY CONTENT
"/* Generated by cmake/vk_extension_bans.cmake from src/common/gpu/vk/extension_bans.txt. Do not edit. */
extern const char snx_vk_extension_bans_text[];
const char snx_vk_extension_bans_text[] = {
    @snx_vk_extension_bans_bytes@0x00
};
")
