# snx_cacert: Mozilla's root certificates, curl's dated extract of them (cmake/dependencies.cmake), compiled in as one
# PEM text (src/common/network/cacert.h) for the launcher's HTTPS to trust (src/common/network/https.c)
include_guard(GLOBAL)
set(snx_cacert_pem "${cacert_SOURCE_DIR}/cacert-${snx_cacert_date}.pem")
set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${snx_cacert_pem}")
file(READ "${snx_cacert_pem}" snx_cacert_hex HEX)
string(LENGTH "${snx_cacert_hex}" snx_cacert_size)
math(EXPR snx_cacert_size "${snx_cacert_size} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," snx_cacert_bytes "${snx_cacert_hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " snx_cacert_bytes "${snx_cacert_bytes}")
# file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/cacert_pem.c" @ONLY CONTENT
"/* Generated by cmake/cacert.cmake from curl's cacert-@snx_cacert_date@.pem. Do not edit. */
#include \"common/network/cacert.h\"
const unsigned char snx_cacert_pem[] = {
    @snx_cacert_bytes@0x00
};
const size_t snx_cacert_pem_size = @snx_cacert_size@;
const char snx_cacert_date[] = \"@snx_cacert_date@\";
")
add_library(snx_cacert STATIC "${PROJECT_BINARY_DIR}/generated/cacert_pem.c")
target_include_directories(snx_cacert PRIVATE "${PROJECT_SOURCE_DIR}/src")
