# The menus' icons (src/gui/icons.h): Lucide's SVGs, src/gui/lucide/<name>.svg for each GUI_ICON_<NAME> (gamepad-2 for
# GUI_ICON_GAMEPAD_2), compiled into snx_splash as SVG text, gui_icon_svgs, which lunasvg draws (gui/splash.h). An icon
# without its file, a file that is not one <svg> on Lucide's viewBox 0 0 24 24 or that no icon names, and a folder
# without Lucide's LICENSE stop the configure, naming the file and the icon.
# cmake -DICONS_H=icons.h -DICONS_DIR=folder [-DOUT=gui_icons.c] -P cmake/gui_icons.cmake checks a folder the same way
# (tests/gui_icons.cmake)
include_guard(GLOBAL)

# out: the C source of folder's SVGs, the icons named in header's enum; FATAL_ERROR with the icon for any it refuses
function(snx_gui_icons header folder out)
    file(READ "${header}" text)
    string(REGEX MATCH "GUI_ICON_[A-Z0-9_]+ = 0xE000,[^}]*GUI_ICON_END" block "${text}")
    if(NOT block)
        message(FATAL_ERROR "${header}: no enum from a GUI_ICON_ = 0xE000 to GUI_ICON_END")
    endif()
    string(REGEX MATCHALL "GUI_ICON_[A-Z0-9_]+" names "${block}")
    list(REMOVE_ITEM names GUI_ICON_END)
    if(NOT EXISTS "${folder}/LICENSE")
        message(FATAL_ERROR "${folder}: no LICENSE, Lucide's, which goes with its icons")
    endif()
    set(arrays "")
    set(list "")
    set(files "")
    set(i 0)
    foreach(name IN LISTS names)
        string(REGEX REPLACE "^GUI_ICON_" "" file "${name}")
        string(TOLOWER "${file}" file)
        string(REPLACE "_" "-" file "${file}")
        set(svg "${folder}/${file}.svg")
        list(APPEND files "${file}.svg")
        if(NOT EXISTS "${svg}")
            message(FATAL_ERROR "${svg}: no such file, ${name}'s drawing")
        endif()
        file(READ "${svg}" text)
        string(REGEX REPLACE "[ \t\r\n]+" " " text "${text}")
        string(REPLACE "> <" "><" text "${text}")
        string(STRIP "${text}" text)
        if(NOT text MATCHES "^<svg [^>]*>.*</svg>$" OR text MATCHES "</svg>.")
            message(FATAL_ERROR "${svg}: not one <svg>, ${name}'s drawing")
        endif()
        string(REGEX MATCH "^<svg [^>]*>" head "${text}")
        if(NOT head MATCHES " viewBox=\"0 0 24 24\"")
            string(REGEX MATCH "viewBox=\"[^\"]*\"" box "${head}")
            if(NOT box)
                set(box "no viewBox")
            endif()
            message(FATAL_ERROR "${svg}: ${box}, where Lucide draws ${name} on viewBox=\"0 0 24 24\"")
        endif()
        string(HEX "${text}" hex)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " bytes "${bytes}")
        string(APPEND arrays "static const char svg${i}[] = { /* ${name} */\n    ${bytes}\n};\n")
        string(APPEND list "    {\"${file}\", svg${i}, sizeof svg${i}},\n")
        math(EXPR i "${i} + 1")
    endforeach()
    file(GLOB present RELATIVE "${folder}" "${folder}/*")
    list(REMOVE_ITEM present LICENSE ${files})
    if(present)
        list(GET present 0 stray)
        message(FATAL_ERROR "${folder}/${stray}: no icon of ${header} is drawn from it")
    endif()
    # file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
    file(CONFIGURE OUTPUT "${out}" @ONLY CONTENT
"/* Generated by cmake/gui_icons.cmake from src/gui/lucide. Do not edit. */
#include \"gui/icons.h\"
${arrays}
const SnxSplashSvg gui_icon_svgs[] = {
${list}};
")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    if(NOT OUT)
        set(OUT "${CMAKE_CURRENT_BINARY_DIR}/gui_icons_check.c")
    endif()
    snx_gui_icons("${ICONS_H}" "${ICONS_DIR}" "${OUT}")
    return()
endif()

set(snx_gui_icons_h "${PROJECT_SOURCE_DIR}/src/gui/icons.h")
set(snx_gui_icons_dir "${PROJECT_SOURCE_DIR}/src/gui/lucide")
file(GLOB snx_gui_icons_files CONFIGURE_DEPENDS "${snx_gui_icons_dir}/*")
set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${snx_gui_icons_h}"
             ${snx_gui_icons_files})
set(snx_gui_icons_c "${PROJECT_BINARY_DIR}/generated/gui_icons.c")
snx_gui_icons("${snx_gui_icons_h}" "${snx_gui_icons_dir}" "${snx_gui_icons_c}")
