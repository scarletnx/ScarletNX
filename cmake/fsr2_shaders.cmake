# cmake -DGLSLANG= -DSPIRV_OPT= -DSPIRV_VAL= -DSHADERS= -DWORK= -DOUT= -P fsr2_shaders.cmake: AMD FidelityFX Super
# Resolution 2.2.1's compute passes (SHADERS: its src/ffx-fsr2-api/shaders, MIT, Copyright (c) 2022-2023 Advanced Micro
# Devices, Inc.) compiled to SPIR-V and written into the C file OUT, for src/nx/gpu/vk/fsr2/fsr2_blobs.c. AMD's own
# build makes these with FidelityFX_SC.exe, which only Windows runs; this is the same set of defines through glslang.
#
# A pass is built once for each of the 16 values of the options a context's flags choose (bit 0 HDR color input, bit 1
# low resolution motion vectors, bit 2 jittered motion vectors, bit 3 inverted depth), and the accumulate pass once more
# with sharpening. Modules that come out the same are kept once. The names of the variables stay in the modules (no
# -g0, no strip): fsr2_blobs.c reads the bindings by name from them. No 16-bit float and no wave64 builds, and the
# history is reprojected with the reference Lanczos kernel (REPROJECT_USE_LANCZOS_TYPE=0), which AMD's backend picks on
# every GPU whose subgroups are not 64 wide: with the lookup table (1) forced here the history blurred and darkened a
# little more each frame (tests/vk_fsr2.c caught it), on lavapipe and RADV alike
set(passes depth_clip reconstruct_previous_depth lock accumulate accumulate rcas compute_luminance_pyramid
    autogen_reactive tcr_autogen) # in the order of FfxFsr2Pass; the second accumulate is ACCUMULATE_SHARPEN
set(base -DFFX_GLSL=1 -DFFX_GPU=1 -DFFX_HALF=0 -DFFX_FSR2_OPTION_UPSAMPLE_SAMPLERS_USE_DATA_HALF=0
    -DFFX_FSR2_OPTION_ACCUMULATE_SAMPLERS_USE_DATA_HALF=0 -DFFX_FSR2_OPTION_REPROJECT_SAMPLERS_USE_DATA_HALF=1
    -DFFX_FSR2_OPTION_POSTPROCESSLOCKSTATUS_SAMPLERS_USE_DATA_HALF=0 -DFFX_FSR2_OPTION_UPSAMPLE_USE_LANCZOS_TYPE=2
    -DFFX_FSR2_OPTION_REPROJECT_USE_LANCZOS_TYPE=0)
file(MAKE_DIRECTORY "${WORK}")
set(arrays "")
set(table "")
set(index 0)
foreach(pass IN LISTS passes)
    set(sharpen 0)
    if(index EQUAL 4)
        set(sharpen 1)
    endif()
    string(APPEND table "    {")
    set(seen "")
    set(seen_names "")
    foreach(k RANGE 15)
        math(EXPR hdr "${k} & 1")
        math(EXPR low "(${k} >> 1) & 1")
        math(EXPR jit "(${k} >> 2) & 1")
        math(EXPR inv "(${k} >> 3) & 1")
        set(name "fsr2_${index}_${k}")
        set(spv "${WORK}/${name}.spv")
        execute_process(COMMAND "${GLSLANG}" -V --target-env vulkan1.1 -S comp -e main ${base}
                                -DFFX_FSR2_OPTION_HDR_COLOR_INPUT=${hdr}
                                -DFFX_FSR2_OPTION_LOW_RESOLUTION_MOTION_VECTORS=${low}
                                -DFFX_FSR2_OPTION_JITTERED_MOTION_VECTORS=${jit} -DFFX_FSR2_OPTION_INVERTED_DEPTH=${inv}
                                -DFFX_FSR2_OPTION_APPLY_SHARPENING=${sharpen} "-I${SHADERS}" -o "${spv}"
                                "${SHADERS}/ffx_fsr2_${pass}_pass.glsl"
                        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "glslang failed on ffx_fsr2_${pass}_pass.glsl (${name}):\n${output}")
        endif()
        file(SHA256 "${spv}" hash)
        list(FIND seen "${hash}" at)
        if(at GREATER -1)
            list(GET seen_names ${at} name)
        else()
            execute_process(COMMAND "${SPIRV_OPT}" -O --target-env=vulkan1.1 "${spv}" -o "${spv}.opt"
                            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "spirv-opt failed on ${name}:\n${output}")
            endif()
            execute_process(COMMAND "${SPIRV_VAL}" --target-env vulkan1.1 "${spv}.opt"
                            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "spirv-val failed on ${name}:\n${output}")
            endif()
            file(READ "${spv}.opt" hex HEX)
            string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u, " text "${hex}")
            string(REGEX REPLACE "((0x........u, ){8})" "\\1\n" text "${text}")
            string(APPEND arrays "static const uint32_t ${name}[] = {\n${text}};\n")
            list(APPEND seen "${hash}")
            list(APPEND seen_names "${name}")
        endif()
        string(APPEND table "{${name}, sizeof ${name}}, ")
    endforeach()
    string(APPEND table "},\n")
    math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${OUT}.part" "/* Generated by cmake/fsr2_shaders.cmake from AMD FidelityFX Super Resolution 2.2.1's GLSL passes
   (MIT, Copyright (c) 2022-2023 Advanced Micro Devices, Inc.) with glslang and spirv-opt. Do not edit. */
#include \"nx/gpu/vk/fsr2/fsr2_spv.h\"
// clang-format off
${arrays}
const SnxFsr2Spv snx_fsr2_spv[9][16] = {
${table}};
// clang-format on
")
file(RENAME "${OUT}.part" "${OUT}")
