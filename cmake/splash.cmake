# snx_splash: the boot splash's drawings, Wimsy (dist/wimsy.svg) and the ones in dist/splash, and the menus' icons
# (cmake/gui_icons.cmake), compiled in as SVG text, and lunasvg on plutovg (cmake/dependencies.cmake) to draw one at the
# size it is shown (src/gui/splash.h)
include_guard(GLOBAL)

# The text of an SVG without what drawing it does not need: the XML declaration, the comments, the metadata (the
# credits stay in the files) and the space between tags
function(snx_splash_text svg out)
    file(READ "${svg}" text)
    # .* runs to the last </metadata>: with two, the drawing between them would go too
    string(REGEX MATCHALL "<metadata" blocks "${text}")
    list(LENGTH blocks count)
    if(count GREATER 1)
        message(FATAL_ERROR "${count} <metadata> blocks in ${svg}, and cmake/splash.cmake takes out one")
    endif()
    string(REGEX REPLACE "<\\?xml[^>]*\\?>" "" text "${text}")
    string(REGEX REPLACE "<!--[^>]*-->" "" text "${text}")
    string(REGEX REPLACE "<metadata[^>]*>.*</metadata>" "" text "${text}")
    string(REGEX REPLACE "[ \t\r\n]+" " " text "${text}")
    string(REPLACE "> <" "><" text "${text}")
    string(STRIP "${text}" text)
    if(text MATCHES "<!--|<metadata" OR NOT text MATCHES "^<svg .*</svg>$")
        message(FATAL_ERROR "${svg}: cmake/splash.cmake cannot take its comments out (one with a >), or it is not one "
                            "<svg>")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE) # cmake -DSVG=file -P cmake/splash.cmake prints what is compiled in of one
    snx_splash_text("${SVG}" text)
    message("${text}")
    return()
endif()

file(GLOB snx_splash_svgs CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/dist/splash/*.svg")
list(SORT snx_splash_svgs)
list(PREPEND snx_splash_svgs "${PROJECT_SOURCE_DIR}/dist/wimsy.svg")
set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${snx_splash_svgs})
set(snx_splash_arrays "")
set(snx_splash_list "")
set(snx_splash_bytes 0)
list(LENGTH snx_splash_svgs snx_splash_count)
set(i 0)
foreach(svg IN LISTS snx_splash_svgs)
    snx_splash_text("${svg}" text)
    get_filename_component(name "${svg}" NAME_WE)
    string(HEX "${text}" hex)
    string(LENGTH "${text}" size)
    math(EXPR snx_splash_bytes "${snx_splash_bytes} + ${size}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " bytes "${bytes}")
    string(APPEND snx_splash_arrays "static const char svg${i}[] = {\n    ${bytes}\n};\n")
    string(APPEND snx_splash_list "    {\"${name}\", svg${i}, sizeof svg${i}},\n")
    math(EXPR i "${i} + 1")
endforeach()
message(STATUS "Splash: ${snx_splash_count} drawings, ${snx_splash_bytes} bytes of SVG")
# file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/splash_svgs.c" @ONLY CONTENT
"/* Generated by cmake/splash.cmake from dist/wimsy.svg and the SVGs of dist/splash. Do not edit. */
#include \"gui/splash.h\"
@snx_splash_arrays@
const SnxSplashSvg snx_splash_svgs[] = {
@snx_splash_list@};
const int snx_splash_svg_count = @snx_splash_count@;
")

# the menus' icons, Lucide's SVGs (src/gui/icons.h), drawn the same way
include("${PROJECT_SOURCE_DIR}/cmake/gui_icons.cmake")
set(plutovg_sources blend canvas font ft-math ft-raster ft-stroker matrix paint path rasterize surface)
list(TRANSFORM plutovg_sources REPLACE "(.+)" "${plutovg_SOURCE_DIR}/source/plutovg-\\1.c")
file(GLOB lunasvg_sources "${lunasvg_SOURCE_DIR}/source/*.cpp")
add_library(snx_splash STATIC "${PROJECT_SOURCE_DIR}/src/gui/splash.cpp" "${PROJECT_BINARY_DIR}/generated/splash_svgs.c"
            "${snx_gui_icons_c}" ${plutovg_sources} ${lunasvg_sources})
target_include_directories(snx_splash PUBLIC "${PROJECT_SOURCE_DIR}/src")
target_include_directories(snx_splash SYSTEM PRIVATE "${plutovg_SOURCE_DIR}/include" "${plutovg_SOURCE_DIR}/source"
                           "${lunasvg_SOURCE_DIR}/include" "${lunasvg_SOURCE_DIR}/source")
# static, built here; no font of the system is looked for, as the drawings have no text
target_compile_definitions(snx_splash PRIVATE PLUTOVG_BUILD PLUTOVG_BUILD_STATIC LUNASVG_BUILD LUNASVG_BUILD_STATIC
                           PLUTOVG_DISABLE_FONT_FACE_CACHE_LOAD LUNASVG_DISABLE_LOAD_SYSTEM_FONTS)
set_target_properties(snx_splash PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED ON C_STANDARD 11
                      POSITION_INDEPENDENT_CODE ON)
# drawn once a boot: built for size. The libraries' own warnings stay out of the output, ours (splash.cpp) do not
target_compile_options(snx_splash PRIVATE -Os)
set_source_files_properties(${plutovg_sources} ${lunasvg_sources} PROPERTIES COMPILE_OPTIONS -w)
# the stb_image_write plutovg-surface.c holds shifts its JPEG bit buffer, an int, into the sign bit: UBSan's shift-base
# off for that file of theirs alone (SNX_TEST_SANITIZERS)
if(SNX_TEST_SANITIZERS)
    set_source_files_properties("${plutovg_SOURCE_DIR}/source/plutovg-surface.c" PROPERTIES COMPILE_OPTIONS
                                "-w;-fno-sanitize=shift-base")
endif()
set_source_files_properties("${PROJECT_SOURCE_DIR}/src/gui/splash.cpp" PROPERTIES COMPILE_OPTIONS "-Wall;-Wextra")
if(NOT MSVC AND NOT WIN32)
    target_link_libraries(snx_splash PRIVATE m)
endif()
include(GNUInstallDirs) # its folders, before the first install of a fresh configure
install(FILES "${lunasvg_SOURCE_DIR}/LICENSE" DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/scarletnx/lunasvg)
install(FILES "${plutovg_SOURCE_DIR}/LICENSE" "${plutovg_SOURCE_DIR}/source/FTL.TXT"
        DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/scarletnx/plutovg)
install(FILES "${snx_gui_icons_dir}/LICENSE" DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/scarletnx/lucide)
