         "<svg viewBox=\"0 0 8 8\"><metadata>a</metadata><rect width=\"8\" height=\"8\"/><metadata>b</metadata></svg>\n")
    add_test(NAME splash_two_metadata COMMAND "${CMAKE_COMMAND}" "-DSVG=${PROJECT_BINARY_DIR}/splash-two-metadata.svg" -P
