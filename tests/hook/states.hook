# hooks for tests/hook_states.c: a clock's, which save states leave be, and a recursive mutex's and a condition
# variable's, whose family (cond_var) keeps them from being taken
family sync
hook now() -> i64 = test_now
family cond_var
hook lock(addr m) = test_lock
hook wait(addr cv) = test_wait
