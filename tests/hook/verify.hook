# Hooks for tests/hook_verify.c: pure hooks with buffers of each kind of length, and one that isn't pure
family pure
hook copy(u8* dst out[n], const u8* src in[n], u64 n) -> u8* = t_copy pure
hook fill(addr dst out[n * 4], u32 value, u64 n) = t_fill pure
hook sum(u64 n, const u16* p in[n * 2 + 2]) -> u16 = t_sum pure
hook half(f64 x) -> f64 = t_half pure
hook wrong(addr dst out[n], addr src in[n], u64 n) -> addr = t_copy_wrong pure
family other
hook tick() -> u64 = t_tick
