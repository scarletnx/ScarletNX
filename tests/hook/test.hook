# hooks of every type, for tests/hook_adapters.c: integers and floats interleaved take x and v registers apart
family types
hook _ZN4test5mixedEifjd(void* self, i32 a, f32 b, u32 c2, f64 d) -> i64 = test_mixed
hook narrow_i8(i8 a) -> i8 = test_narrow_i8
hook narrow_u16(u16 a) -> u16 = test_narrow_u16
hook flag(bool on) -> bool = test_flag
hook half(f64 x) -> f64 = test_half
hook single(f32 x) -> f32 = test_single
family other
hook nothing() = test_nothing
hook eight(u64 a, u64 b, u64 c3, u64 d, u64 e, u64 f, u64 g, u64 h) -> u64 = test_eight
hook eight_again(u64 a, u64 b, u64 c3, u64 d, u64 e, u64 f, u64 g, u64 h) -> u64 = test_eight
