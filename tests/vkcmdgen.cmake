# tools/vkcmdgen on a registry of its own, whose table is checked whole: an alias followed to its definition, a
# physical device's command and a non-dispatchable handle's left out, a device child's handle (a VkWidgetNV) kept, a
# depends kept as the registry writes it, Vulkan SC's blocks, definitions and extensions left out, as are instance and
# disabled extensions, an extension with no command kept with none, and the extensions sorted. Then each registry it
# refuses, said with its line: a command defined nowhere, an extension named twice, an alias loop, a name a C string
# would need escaped, no device extension, no <commands>, no VK_HEADER_VERSION. Then the registry the build has: the
# lines of the commands the renderer met missing, and a second run leaving the file as it was.
#
# usage: cmake -DVKCMDGEN=<vkcmdgen> -DREGISTRY=<vk.xml> -DWORK=<folder> -P vkcmdgen.cmake
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

set(handles [=[
    <types>
        <type category="handle"><type>VK_DEFINE_HANDLE</type>(<name>VkInstance</name>)</type>
        <type category="handle" parent="VkInstance"><type>VK_DEFINE_HANDLE</type>(<name>VkPhysicalDevice</name>)</type>
        <type category="handle" parent="VkPhysicalDevice"><type>VK_DEFINE_HANDLE</type>(<name>VkDevice</name>)</type>
        <type category="handle" parent="VkDevice"><type>VK_DEFINE_HANDLE</type>(<name>VkCommandBuffer</name>)</type>
        <type category="handle" parent="VkDevice"><type>VK_DEFINE_HANDLE</type>(<name>VkWidgetNV</name>)</type>
        <type category="handle" parent="VkDevice"><type>VK_DEFINE_NON_DISPATCHABLE_HANDLE</type>(<name>VkBuffer</name>)</type>
        <type api="vulkan" category="define">// Version of this file
#define <name>VK_HEADER_VERSION</name> 42</type>
    </types>
]=])
set(commands [=[
    <commands comment="each kind">
        <command><proto><type>void</type> <name>vkCmdA</name></proto>
            <param><type>VkCommandBuffer</type> <name>cb</name></param></command>
        <command name="vkCmdAEXT" alias="vkCmdA" />
        <command><proto><type>void</type> <name>vkGetPhysicalDeviceB</name></proto>
            <param><type>VkPhysicalDevice</type> <name>p</name></param></command>
        <command api="vulkan"><proto><type>void</type> <name>vkWidgetC</name></proto>
            <param><type>VkWidgetNV</type> <name>w</name></param></command>
        <command api="vulkansc"><proto><type>void</type> <name>vkWidgetC</name></proto>
            <param><type>VkInstance</type> <name>i</name></param></command>
        <command><proto><type>void</type> <name>vkBufferD</name></proto>
            <param>const <type>VkBuffer</type>* <name>b</name></param></command>
        <command><proto><type>VkResult</type> <name>vkCreateE</name></proto>
            <param><type>VkDevice</type> <name>d</name></param></command>
    </commands>
]=])
file(WRITE "${WORK}/registry.xml" "<registry>
${handles}${commands}    <extensions>
        <extension name=\"VK_EXT_zeta\" number=\"2\" type=\"device\" supported=\"vulkan\">
            <require><command name=\"vkCmdAEXT\" /><command name=\"vkGetPhysicalDeviceB\" /></require>
            <require depends=\"VK_EXT_alpha,(VK_VERSION_1_1+VK_KHR_x)\"><command name=\"vkWidgetC\" /></require>
            <require api=\"vulkansc\"><command name=\"vkCreateE\" /></require>
            <require comment=\"nothing\" />
        </extension>
        <extension name=\"VK_EXT_alpha\" number=\"1\" type=\"device\" supported=\"vulkan,vulkansc\">
            <require><command name=\"vkCreateE\" /><command name=\"vkBufferD\" /></require>
        </extension>
        <extension name=\"VK_KHR_instance_only\" number=\"3\" type=\"instance\" supported=\"vulkan\">
            <require><command name=\"vkGetPhysicalDeviceB\" /></require>
        </extension>
        <extension name=\"VK_EXT_sc_only\" number=\"4\" type=\"device\" supported=\"vulkansc\">
            <require><command name=\"vkCreateE\" /></require>
        </extension>
        <extension name=\"VK_EXT_disabled\" number=\"5\" supported=\"disabled\">
            <require><command name=\"vkNowhere\" /></require>
        </extension>
        <extension name=\"VK_EXT_empty\" number=\"6\" type=\"device\" supported=\"vulkan\" />
    </extensions>
</registry>
")
execute_process(COMMAND "${VKCMDGEN}" "${WORK}/registry.xml" "${WORK}/table.c" RESULT_VARIABLE result
                ERROR_VARIABLE errors)
if(result)
    message(FATAL_ERROR "vkcmdgen refused the registry of each kind (${result}): ${errors}")
endif()
file(READ "${WORK}/table.c" got)
set(want [=[/* Generated by tools/vkcmdgen from the Khronos registry, vk.xml of VK_HEADER_VERSION 42. Do not edit. */
#include "common/gpu/vk/extension_commands.h"

const SnxVkExtensionCommand snx_vk_extension_commands[] = {
    {"vkCreateE", NULL},
    {"vkCmdAEXT", NULL},
    {"vkWidgetC", "VK_EXT_alpha,(VK_VERSION_1_1+VK_KHR_x)"},
};

const SnxVkExtensionEntry snx_vk_extension_table[] = {
    {"VK_EXT_alpha", 0, 1},
    {"VK_EXT_empty", 1, 0},
    {"VK_EXT_zeta", 1, 2},
};
const uint32_t snx_vk_extension_table_count = 3;
]=])
if(NOT got STREQUAL want)
    message(FATAL_ERROR "the table of the registry of each kind is not the one expected:\n${got}\nexpected:\n${want}")
endif()

# each registry it refuses: the file, then the words its error must have
function(refused name text words)
    file(WRITE "${WORK}/${name}.xml" "${text}")
    execute_process(COMMAND "${VKCMDGEN}" "${WORK}/${name}.xml" "${WORK}/${name}.c" RESULT_VARIABLE result
                    ERROR_VARIABLE errors)
    string(FIND "${errors}" "${words}" at)
    if(NOT result OR at EQUAL -1 OR EXISTS "${WORK}/${name}.c")
        message(FATAL_ERROR "vkcmdgen took ${name}.xml (${result}), wrote a table, or did not say \"${words}\":\n"
                            "${errors}")
    endif()
endfunction()
refused(undefined "<registry>
${handles}${commands}    <extensions>
        <extension name=\"VK_EXT_bad\" number=\"1\" type=\"device\" supported=\"vulkan\">
            <require><command name=\"vkNope\" /></require>
        </extension>
    </extensions>
</registry>
" "undefined.xml:29: VK_EXT_bad requires vkNope, which the registry defines nowhere")
refused(twice "<registry>
${handles}${commands}    <extensions>
        <extension name=\"VK_EXT_a\" number=\"1\" type=\"device\" supported=\"vulkan\" />
        <extension name=\"VK_EXT_a\" number=\"2\" type=\"device\" supported=\"vulkan\" />
    </extensions>
</registry>
" "VK_EXT_a is named twice")
refused(loop "<registry>
${handles}    <commands>
        <command name=\"vkLoopA\" alias=\"vkLoopB\" />
        <command name=\"vkLoopB\" alias=\"vkLoopA\" />
    </commands>
    <extensions>
        <extension name=\"VK_EXT_a\" number=\"1\" type=\"device\" supported=\"vulkan\">
            <require><command name=\"vkLoopA\" /></require>
        </extension>
    </extensions>
</registry>
" "is an alias of an alias past 8 deep")
refused(escaped "<registry>
${handles}${commands}    <extensions>
        <extension name=\"VK_EXT_a\" number=\"1\" type=\"device\" supported=\"vulkan\">
            <require depends=\"VK_EXT_b&quot;\"><command name=\"vkCmdAEXT\" /></require>
        </extension>
    </extensions>
</registry>
" "a depends \"VK_EXT_b&quot;\" has '&', which the table does not take")
refused(no_device "<registry>
${handles}${commands}    <extensions>
        <extension name=\"VK_KHR_instance_only\" number=\"3\" type=\"instance\" supported=\"vulkan\" />
    </extensions>
</registry>
" "has no device extension Vulkan supports")
refused(no_commands "<registry>
${handles}    <extensions />
</registry>
" "has no <commands>")
refused(no_version "<registry>
    <types><type category=\"handle\"><type>VK_DEFINE_HANDLE</type>(<name>VkDevice</name>)</type></types>
${commands}    <extensions>
        <extension name=\"VK_EXT_a\" number=\"1\" type=\"device\" supported=\"vulkan\" />
    </extensions>
</registry>
" "defines no VK_HEADER_VERSION")

# the registry the build has: what the renderer met missing, and a second run that leaves the file as it was
execute_process(COMMAND "${VKCMDGEN}" "${REGISTRY}" "${WORK}/vk.c" RESULT_VARIABLE result ERROR_VARIABLE errors)
if(result)
    message(FATAL_ERROR "vkcmdgen refused ${REGISTRY} (${result}): ${errors}")
endif()
file(READ "${WORK}/vk.c" table)
foreach(line [=[    {"vkCmdSetDepthClampRangeEXT", NULL},]=]
             [=[    {"vkCmdSetDepthClipEnableEXT", "VK_EXT_depth_clip_enable"},]=]
             [=[    {"vkAcquireNextImage2KHR", "VK_VERSION_1_1"},]=])
    string(FIND "${table}" "${line}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "the table of ${REGISTRY} lacks the line ${line}")
    endif()
endforeach()
if(NOT table MATCHES "\n    {\"VK_EXT_depth_clamp_control\", [0-9]+, 1},\n")
    message(FATAL_ERROR "the table of ${REGISTRY} does not give VK_EXT_depth_clamp_control its one command")
endif()
string(FIND "${table}" "vkGetPhysicalDeviceMultisamplePropertiesEXT" at)
if(NOT at EQUAL -1)
    message(FATAL_ERROR "the table of ${REGISTRY} lists a physical device's command")
endif()
file(TIMESTAMP "${WORK}/vk.c" before "%Y-%m-%dT%H:%M:%S.%f")
file(SHA256 "${WORK}/vk.c" first)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
execute_process(COMMAND "${VKCMDGEN}" "${REGISTRY}" "${WORK}/vk.c" RESULT_VARIABLE result ERROR_VARIABLE errors)
file(TIMESTAMP "${WORK}/vk.c" after "%Y-%m-%dT%H:%M:%S.%f")
file(SHA256 "${WORK}/vk.c" second)
if(result OR NOT before STREQUAL after OR NOT first STREQUAL second)
    message(FATAL_ERROR "a second run (${result}) rewrote the same table (${before}, ${after}) or another one")
endif()
message(STATUS "vkcmdgen passed")
