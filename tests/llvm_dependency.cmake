# Hermetic discovery tests: no installed LLVM or target executable is needed.
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED SNX_SOURCE_DIR OR NOT DEFINED SNX_TEST_DIR)
    message(FATAL_ERROR "Set SNX_SOURCE_DIR and SNX_TEST_DIR")
endif()

if(DEFINED CASE AND CASE MATCHES "^package_")
    # An LLVM named by its CMake package (LLVM_DIR): its static components, or the one shared library its own tools
    # link (pkgsrc's), which is built with every target
    set(dir "${SNX_TEST_DIR}/${CASE}")
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${dir}/LLVMConfig.cmake" "set(LLVM_PACKAGE_VERSION 21.1.8)\nset(LLVM_TARGETS_TO_BUILD X86 AArch64)\n"
         "function(llvm_map_components_to_libnames output)\n    set(\${output} LLVMCore LLVMSupport PARENT_SCOPE)\n"
         "endfunction()\n")
    if(CASE STREQUAL "package_dylib")
        file(APPEND "${dir}/LLVMConfig.cmake" "set(LLVM_LINK_LLVM_DYLIB ON)\n")
        set(expected "LLVM")
        set(expected_shared ON)
    else()
        set(expected "LLVMCore;LLVMSupport")
        set(expected_shared OFF)
    endif()
    set(LLVM_DIR "${dir}")
    include("${SNX_SOURCE_DIR}/cmake/llvm.cmake")
    if(NOT SNX_LLVM_LIBS STREQUAL expected OR NOT SNX_LLVM_SHARED STREQUAL expected_shared)
        message(FATAL_ERROR "${CASE}: LLVM libraries ${SNX_LLVM_LIBS} (shared ${SNX_LLVM_SHARED}), expected ${expected} "
                            "(shared ${expected_shared})")
    endif()
    # a folder of the sysroot without it (a cross build's run path), and any other one as it is
    set(CMAKE_SYSROOT "/x/sysroot")
    foreach(pair "/x/sysroot/usr/pkg/lib=/usr/pkg/lib" "/x/sysroot2/lib=/x/sysroot2/lib" "/usr/lib=/usr/lib")
        string(REPLACE "=" ";" pair "${pair}")
        list(GET pair 0 path)
        list(GET pair 1 want)
        snx_target_path(got "${path}")
        if(NOT got STREQUAL want)
            message(FATAL_ERROR "snx_target_path(${path}) with the sysroot ${CMAKE_SYSROOT}: ${got}, expected ${want}")
        endif()
    endforeach()
    return()
endif()
if(DEFINED CASE)
    # Substitute only discovery and llvm-config's responses, not the dependency policy.
    function(find_program output)
        if(CASE STREQUAL "missing_config")
            set(${output} "${output}-NOTFOUND" PARENT_SCOPE)
        else()
            set(${output} "${SNX_TEST_DIR}/llvm-config" PARENT_SCOPE)
        endif()
    endfunction()
    function(execute_process)
        cmake_parse_arguments(query "OUTPUT_STRIP_TRAILING_WHITESPACE"
            "OUTPUT_VARIABLE;RESULT_VARIABLE;ERROR_VARIABLE" "COMMAND" ${ARGN})
        list(GET query_COMMAND 1 option)
        string(REPLACE "--" "" name "${option}")
        if(CASE STREQUAL "fail_${name}")
            set(${query_RESULT_VARIABLE} 1 PARENT_SCOPE)
            set(${query_ERROR_VARIABLE} "fixture query failed" PARENT_SCOPE)
            return()
        endif()
        set(value "")
        if(name STREQUAL "version")
            set(value "23.1.0")
        elseif(name STREQUAL "includedir")
            set(value "${SNX_TEST_DIR}/include")
            if(CASE STREQUAL "missing_header")
                set(value "${SNX_TEST_DIR}/missing")
            endif()
        elseif(name STREQUAL "libdir")
            set(value "${SNX_TEST_DIR}/lib")
            if(CASE STREQUAL "missing_libdir")
                set(value "${SNX_TEST_DIR}/missing")
            endif()
        elseif(name STREQUAL "libs")
            set(value "-lLLVM-23 -lSupport")
            if(CASE STREQUAL "missing_library")
                set(value "-lMissingLLVM")
            elseif(CASE STREQUAL "static_only")
                set(value "-lStaticLLVM")
            endif()
        elseif(name STREQUAL "system-libs" AND NOT CASE STREQUAL "empty_system")
            set(value "-lz -lm")
        endif()
        if(CASE STREQUAL "empty_${name}")
            set(value "")
        endif()
        set(${query_OUTPUT_VARIABLE} "${value}" PARENT_SCOPE)
        set(${query_RESULT_VARIABLE} 0 PARENT_SCOPE)
    endfunction()
    include("${SNX_SOURCE_DIR}/cmake/llvm.cmake")
    set(expected "-lLLVM-23;-lSupport")
    if(WIN32)
        set(expected "${SNX_TEST_DIR}/lib/libLLVM-23.dll.a;${SNX_TEST_DIR}/lib/libSupport.a")
        if(CASE STREQUAL "static_only")
            set(expected "${SNX_TEST_DIR}/lib/libStaticLLVM.a")
        endif()
    endif()
    if(NOT SNX_LLVM_LIBS STREQUAL expected)
        message(FATAL_ERROR "Wrong LLVM libraries: ${SNX_LLVM_LIBS}, expected ${expected}")
    endif()
    if(NOT CASE STREQUAL "empty_system" AND NOT SNX_LLVM_SYSTEM_LIBS STREQUAL "-lz;-lm")
        message(FATAL_ERROR "LLVM system link arguments were not preserved")
    endif()
    return()
endif()

# Exercise SDK paths with spaces, and the mixed import/static libraries shipped
# by Windows toolchains. Discovery must preserve each full path as one list item.
set(SNX_TEST_DIR "${SNX_TEST_DIR}/LLVM SDK")
file(MAKE_DIRECTORY "${SNX_TEST_DIR}/include/llvm-c" "${SNX_TEST_DIR}/lib")
file(WRITE "${SNX_TEST_DIR}/include/llvm-c/Core.h" "/* discovery fixture */\n")
foreach(library libLLVM-23.dll.a libSupport.a libStaticLLVM.a)
    file(WRITE "${SNX_TEST_DIR}/lib/${library}" "discovery fixture\n")
endforeach()
foreach(windows OFF ON)
    foreach(cross OFF ON)
        set(cases valid empty_system missing_config missing_header missing_libdir empty_version empty_libs
                  fail_version fail_includedir fail_libdir fail_libs fail_system-libs)
        if(windows)
            list(APPEND cases missing_library static_only)
        endif()
        foreach(case IN LISTS cases)
            execute_process(COMMAND "${CMAKE_COMMAND}" "-DSNX_SOURCE_DIR=${SNX_SOURCE_DIR}"
                "-DSNX_TEST_DIR=${SNX_TEST_DIR}" "-DCASE=${case}" "-DWIN32=${windows}"
                "-DCMAKE_CROSSCOMPILING=${cross}" -P "${CMAKE_CURRENT_LIST_FILE}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
            if(case STREQUAL "valid" OR case STREQUAL "empty_system" OR case STREQUAL "static_only")
                if(NOT result EQUAL 0 OR NOT output MATCHES "LLVM backend: LLVM 23.1.0")
                    message(FATAL_ERROR "${case} (Windows=${windows}, cross=${cross}): ${output}${error}")
                endif()
            elseif(result EQUAL 0 OR NOT error MATCHES "LLVM.*required")
                message(FATAL_ERROR "${case} must fail for missing LLVM (Windows=${windows}, cross=${cross}): ${output}${error}")
            endif()
        endforeach()
    endforeach()
endforeach()
foreach(case package_dylib package_static)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSNX_SOURCE_DIR=${SNX_SOURCE_DIR}" "-DSNX_TEST_DIR=${SNX_TEST_DIR}"
        "-DCASE=${case}" -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output MATCHES "LLVM backend: LLVM 21.1.8")
        message(FATAL_ERROR "${case}: ${output}${error}")
    endif()
endforeach()
message(STATUS "LLVM dependency discovery: native, Windows, cross-build and package policies passed")
