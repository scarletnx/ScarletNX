if(CMAKE_CROSSCOMPILING OR NOT TARGET snx_ctr_cpu)
    message(FATAL_ERROR "SNX_TEST_ARM_AOT requires a native build with SNX_BUILD_3DS=ON")
endif()
if(NOT SNX_BUILD_NX AND NOT SNX_BUILD_GNUABI)
    include("${PROJECT_SOURCE_DIR}/cmake/llvm.cmake")
    add_subdirectory("${PROJECT_SOURCE_DIR}/src/common/cpu/arm" arm-aot-backend)
endif()
# the host's native back end's blocks linked into a program, with all the host registers and with few of them, so that
# values spill (three, four of x86-64's on Windows)
add_executable(snx-test-arm-checked-emit arm_checked_emit.c)
snx_test_target(snx-test-arm-checked-emit gnu23)
target_include_directories(snx-test-arm-checked-emit PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
target_link_libraries(snx-test-arm-checked-emit PRIVATE snx_llvm)
foreach(variant all spill)
    set(pool 0)
    if(variant STREQUAL "spill")
        set(pool 3)
        if(WIN32)
            set(pool 4)
        endif()
    endif()
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/arm-checked-${variant}")
    set(object "${generated}/blocks${CMAKE_C_OUTPUT_EXTENSION}")
    file(MAKE_DIRECTORY "${generated}")
    add_custom_command(OUTPUT "${object}" "${generated}/arm-checked-counts.inc"
        COMMAND snx-test-arm-checked-emit "${object}" "${generated}/arm-checked-counts.inc" ${pool}
        DEPENDS snx-test-arm-checked-emit arm_checked_cases.h VERBATIM)
    set_source_files_properties("${object}" PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
    add_executable(snx-test-arm-checked-${variant} arm_checked.c "${object}" "${generated}/arm-checked-counts.inc")
    snx_test_target(snx-test-arm-checked-${variant} gnu23)
    target_compile_options(snx-test-arm-checked-${variant} PRIVATE -UNDEBUG)
    target_include_directories(snx-test-arm-checked-${variant} PRIVATE "${generated}")
    target_link_libraries(snx-test-arm-checked-${variant} PRIVATE snx_ctr_cpu snx_arm_rt)
    add_test(NAME arm_checked_static_${variant} COMMAND snx-test-arm-checked-${variant})
endforeach()
# Exercise the unchanged A57 entry points without configuring the NX runtime.
if(NOT SNX_BUILD_NX AND NOT SNX_BUILD_GNUABI)
    add_executable(snx-test-arm-decode arm_decode.c)
    snx_test_target(snx-test-arm-decode gnu23)
    target_link_libraries(snx-test-arm-decode PRIVATE snx_arm_llvm)
    add_test(NAME arm_decode COMMAND snx-test-arm-decode)
    include(arm_blocks.cmake)
endif()
