# sailgen_halves: generates halves.sail's roots with a machine back end's files (SAILGEN, FILES split by |, DIR, OUT) and
# says what each call of a function that calls itself on each half of its bits became: sum, whose halves' results +
# joins, the back end's sum of the elements (reduce); op, whose EOR joins them, the elements joined pair by pair in a
# loop (joined); anything else (other)
get_filename_component(out_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${out_dir}")
string(REPLACE "|" ";" files "${FILES}")
set(args "")
foreach(file IN LISTS files)
    list(APPEND args --backend "${file}")
endforeach()
execute_process(COMMAND "${SAILGEN}" --generate "${DIR}/halves.roots" ${args} -o "${OUT}" "${DIR}/halves.sail"
                RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "sailgen_halves: snx-sailgen exited ${rc} on halves.sail")
endif()
file(READ "${OUT}" text)
function(decode_body name out)
    string(FIND "${text}" "static int sg_decode_${name}_aarch64_instrs_test(SgCtx* g) {" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "sailgen_halves: ${OUT} has no decode function for ${name}")
    endif()
    string(SUBSTRING "${text}" ${at} -1 body)
    string(FIND "${body}" "\n}\n" end)
    string(SUBSTRING "${body}" 0 ${end} body)
    set(${out} "${body}" PARENT_SCOPE)
endfunction()
decode_body(sum sum)
decode_body(op op)
set(said "sum=other op=other")
if(sum MATCHES "sg_d_reduce_add\\(" AND NOT sum MATCHES "joined by halves")
    string(REPLACE "sum=other" "sum=reduce" said "${said}")
endif()
if(op MATCHES "the elements joined by halves" AND NOT op MATCHES "sg_d_reduce_add\\(")
    string(REPLACE "op=other" "op=joined" said "${said}")
endif()
message("sailgen_halves: ${said}")
