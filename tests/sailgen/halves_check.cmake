# sailgen_halves: generates halves.sail's root (SAILGEN, CORE and BACKEND, DIR, OUT) and says what its call of the
# function that calls itself on each half of its bits became: one reduction of the lanes (reduce), or anything else
# (other)
get_filename_component(out_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${out_dir}")
execute_process(COMMAND "${SAILGEN}" --generate "${DIR}/halves.roots" --backend "${CORE}" --backend "${BACKEND}"
                -o "${OUT}" "${DIR}/halves.sail" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "sailgen_halves: snx-sailgen exited ${rc} on halves.sail")
endif()
file(READ "${OUT}" text)
string(FIND "${text}" "static int sg_decode_sum_aarch64_instrs_test(SgCtx* g) {" at)
if(at EQUAL -1)
    message(FATAL_ERROR "sailgen_halves: ${OUT} has no decode function for sum")
endif()
string(SUBSTRING "${text}" ${at} -1 body)
string(FIND "${body}" "\n}\n" end)
string(SUBSTRING "${body}" 0 ${end} body)
string(REGEX MATCHALL "sg_l_[a-z_]+\\(" lanes "${body}")
string(REGEX MATCHALL "sg_d_(add|slice)\\(" scalar "${body}")
if(lanes STREQUAL "sg_l_reduce_add(;sg_l_elem(" AND scalar STREQUAL "")
    message("sailgen_halves: sum=reduce")
else()
    message("sailgen_halves: sum=other (${lanes}) (${scalar})")
endif()
