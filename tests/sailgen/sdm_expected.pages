# FROB—Frobnicate -- Intel SDM 325383-999US, Vol. 2A 3-1
@opcodes
F0 /r | FROB r/m8, r8 | MR | Valid | Valid |  | Frobnicate r/m8 with r8.
F1 /0 ib | FROB r/m8, imm8 | MI | Valid | Valid |  | Frobnicate r/m8 with imm8.
F1 /r | FROB r/m32, r32 | MR | Valid | Valid |  | Frobnicate r/m32 with r32.
REX.W + F1 /r | FROB r/m64, r64 | MR | Valid | N.E. |  | Frobnicate r/m64 with r64.
@encoding
MR | ModRM:r/m (r, w) | ModRM:reg (r) | N/A | N/A
MI | ModRM:r/m (r, w) | imm8 | N/A | N/A
@operation
DEST := DEST XOR SRC;
IF DEST = 0
    THEN ZF := 1;
FI;
@flags
The ZF flag is set according to the result.
# TWIDDLE—Twiddle Without Affecting Flags -- Intel SDM 325383-999US, Vol. 2B 4-9
@opcodes
VEX.LZ.0F38.W0 F9 /r | TWIDDLE r32a, r32b, r/m32 | RVM | Valid | Valid | BMI9 | Twiddle r32b into r/m32, store result in r32a.
VEX.LZ.0F38.W1 F9 /r | TWIDDLE r64a, r64b, r/m64 | RVM | Valid | N.E. | BMI9 | Twiddle r64b into r/m64, store result in r64a.
@encoding
RVM | ModRM:reg (w) | VEX.vvvv (r) | ModRM:r/m (r) | N/A
@operation
DEST := SRC2 + SRC1;
@flags
None.
