# sailgen_lanes: generates lanes.sail (SAILGEN, BITS, CORE and BACKEND, OUT) and says, for each of its decode functions,
# whether its element loop became one vector operation (lanes) or stayed a loop of elements (loop)
get_filename_component(out_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${out_dir}")
execute_process(COMMAND "${SAILGEN}" --generate "${DIR}/lanes.roots" --backend "${BITS}" --backend "${CORE}" --backend "${BACKEND}"
                -o "${OUT}" "${DIR}/lanes.sail" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "sailgen_lanes: snx-sailgen exited ${rc} on lanes.sail")
endif()
file(READ "${OUT}" text)
set(line "sailgen_lanes:")
foreach(fn IN ITEMS lanes carried last pairs fold start fixed free)
    string(FIND "${text}" "static int sg_decode_${fn}_aarch64_instrs_test(SgCtx* g) {" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "sailgen_lanes: ${OUT} has no decode function for ${fn}")
    endif()
    string(SUBSTRING "${text}" ${at} -1 body)
    string(FIND "${body}" "\n}\n" end)
    string(SUBSTRING "${body}" 0 ${end} body)
    string(FIND "${body}" "the lanes of e" lanes)
    string(FIND "${body}" "for (long long l" loop)
    if(NOT lanes EQUAL -1 AND loop EQUAL -1)
        string(APPEND line " ${fn}=lanes")
    elseif(lanes EQUAL -1 AND NOT loop EQUAL -1)
        string(APPEND line " ${fn}=loop")
    else()
        string(APPEND line " ${fn}=neither")
    endif()
endforeach()
message("${line}")
