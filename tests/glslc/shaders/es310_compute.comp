#version 310 es
#extension GL_OES_shader_image_atomic : require
// GLSL ES 3.10: a storage buffer with a runtime array, shared memory, barriers, atomics, images, the invocation ids
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer Particles {
    uint alive;
    float dt;
    vec4 positions[];
} particles;
layout(std430, binding = 1) readonly buffer Forces {
    vec4 forces[];
};
layout(binding = 2, rgba16f) uniform writeonly highp image2D heat;
layout(binding = 3, r32ui) uniform highp uimage2D counts;
layout(std140, binding = 4) uniform Params {
    ivec2 grid;
    float damping;
};
shared vec4 tile[gl_WorkGroupSize.x];
shared uint tile_alive;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint l = gl_LocalInvocationIndex;
    if (l == 0u) tile_alive = 0u;
    barrier();
    uint n = uint(particles.positions.length());
    vec4 p = i < n ? particles.positions[i] : vec4(0.0);
    vec4 f = forces[i % uint(forces.length())];
    p.xyz += f.xyz * particles.dt * damping;
    tile[l] = p;
    memoryBarrierShared();
    barrier();
    vec4 neighbour = tile[(l + 1u) % gl_WorkGroupSize.x];
    if (p.w > 0.0) {
        atomicAdd(tile_alive, 1u);
        ivec2 cell = ivec2(p.xy) % grid;
        imageStore(heat, cell, vec4(neighbour.w));
        imageAtomicAdd(counts, cell, 1u);
    }
    barrier();
    if (l == 0u) atomicAdd(particles.alive, tile_alive);
    if (i < n) particles.positions[i] = p;
    groupMemoryBarrier();
    memoryBarrier();
    ivec2 size = imageSize(counts) + ivec2(gl_WorkGroupID.xy) + ivec2(gl_NumWorkGroups.xy) + ivec2(gl_LocalInvocationID.xy);
    if (size.x < 0) particles.alive = 0u;
}
