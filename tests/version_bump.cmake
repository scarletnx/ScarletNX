# Raising any of the numbers cmake/version_parts.cmake names raises the version by one, and a part that is no longer
# one "#define <name> <number>" line fails cmake/version.cmake naming it: each in turn, on copies of their files in
# WORK.
#   cmake -DSRC=<source tree> -DWORK=<a folder of its own> -P tests/version_bump.cmake
include("${SRC}/cmake/version_parts.cmake")
# the version a tree's files make: 0 and its error when cmake/version.cmake failed
function(version_of tree out_version out_error)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSRC=${tree}" -P "${SRC}/cmake/version.cmake"
        OUTPUT_VARIABLE version ERROR_VARIABLE error RESULT_VARIABLE failed OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(failed)
        set(version 0)
    endif()
    string(REGEX REPLACE "[ \t\n]+" " " error "${error}") # CMake wraps a message's lines
    set(${out_version} "${version}" PARENT_SCOPE)
    set(${out_error} "${error}" PARENT_SCOPE)
endfunction()

version_of("${SRC}" base error)
if(NOT base MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "cmake/version.cmake on ${SRC} printed \"${base}\", not a version: ${error}")
endif()
file(REMOVE_RECURSE "${WORK}")
foreach(part IN LISTS SNX_VERSION_PARTS)
    string(REGEX MATCH "^(.+):([A-Za-z0-9_]+)$" _ "${part}")
    set(file "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")
    file(READ "${SRC}/${file}" text)
    file(WRITE "${WORK}/${file}" "${text}")
endforeach()
version_of("${WORK}" copied error)
if(NOT copied STREQUAL base)
    message(FATAL_ERROR "the copies in ${WORK} make version ${copied}, the tree ${base}: ${error}")
endif()
set(wrong "")
foreach(part IN LISTS SNX_VERSION_PARTS)
    string(REGEX MATCH "^(.+):([A-Za-z0-9_]+)$" _ "${part}")
    set(file "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")
    file(READ "${SRC}/${file}" text)
    string(REGEX MATCH "\n#define ${name}[ \t]+[0-9]+" line "${text}")
    string(REGEX MATCH "[0-9]+$" number "${line}")
    math(EXPR raised "${number} + 1")
    string(REGEX REPLACE "[0-9]+$" "${raised}" bumped "${line}")
    string(REPLACE "${line}" "${bumped}" changed "${text}")
    file(WRITE "${WORK}/${file}" "${changed}")
    math(EXPR want "${base} + 1")
    version_of("${WORK}" got error)
    if(NOT got STREQUAL want)
        string(APPEND wrong "\n  ${name} ${number} -> ${raised} (${file}): version ${got}, not ${want} ${error}")
    endif()
    # a number the version cannot read: an expression in its place, then the line twice
    string(REPLACE "${line}" "\n#define ${name} (${number})" changed "${text}")
    file(WRITE "${WORK}/${file}" "${changed}")
    version_of("${WORK}" got error)
    if(NOT got STREQUAL "0" OR NOT error MATCHES "${file}" OR NOT error MATCHES "${name}")
        string(APPEND wrong "\n  ${name} as (${number}): version ${got}, the error not naming ${file} and ${name}: "
                            "${error}")
    endif()
    file(WRITE "${WORK}/${file}" "${text}${line}\n")
    version_of("${WORK}" got error)
    if(NOT got STREQUAL "0" OR NOT error MATCHES "has 2 line")
        string(APPEND wrong "\n  ${name} defined twice: version ${got}, not refused: ${error}")
    endif()
    file(WRITE "${WORK}/${file}" "${text}")
endforeach()
if(wrong)
    message(FATAL_ERROR "from version ${base}:${wrong}")
endif()
list(LENGTH SNX_VERSION_PARTS parts)
message(STATUS "each of the ${parts} parts of version ${base} raises it by one, and one it cannot read is refused")
