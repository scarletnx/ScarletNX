# cmake/native_code_hash.cmake, the native code's version in the JIT cache's key: two trees of the same files, a source
# and a generated one, hash alike; a generator that made one byte otherwise, or another back end's source, hash apart;
# its C file is rewritten only when its text changes; and a file of the list that is missing stops, named.
# cmake -DSCRIPT=<cmake/native_code_hash.cmake> -DWORK=<a folder of the test's> -P this
foreach(variable SCRIPT WORK)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "native_code_hash_test.cmake: -D${variable}= is missing")
    endif()
endforeach()
set(failures 0)
macro(fail what)
    message(SEND_ERROR "native_code_hash: ${what}")
    math(EXPR failures "${failures} + 1")
endmacro()

# a tree under WORK/<name>: a back end's source and a generated emitter, emitter's text the generator's
function(make_tree name emitter)
    file(REMOVE_RECURSE "${WORK}/${name}")
    file(WRITE "${WORK}/${name}/src/x64/x64_codegen.c" "int x64_codegen;\n")
    file(WRITE "${WORK}/${name}/build/sailgen/a64_x64.inc" "${emitter}")
    file(WRITE "${WORK}/${name}/list.txt"
         "${WORK}/${name}/build/sailgen/a64_x64.inc\n${WORK}/${name}/src/x64/x64_codegen.c\n")
endfunction()
# the version the script gives the tree, into out; its exit status into status and what it said into said
function(hash_of name out status said)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DLIST=${WORK}/${name}/list.txt" "-DSOURCE=${WORK}/${name}/src"
                            "-DBINARY=${WORK}/${name}/build" "-DOUT=${WORK}/${name}/native_code.c" -P "${SCRIPT}"
                    RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE text)
    set(version "")
    if(EXISTS "${WORK}/${name}/native_code.c")
        file(READ "${WORK}/${name}/native_code.c" c)
        string(REGEX MATCH "return \"([0-9a-f]+)\"" match "${c}")
        set(version "${CMAKE_MATCH_1}")
    endif()
    set(${out} "${version}" PARENT_SCOPE)
    set(${status} "${rc}" PARENT_SCOPE)
    set(${said} "${text}" PARENT_SCOPE)
endfunction()

make_tree(one "emit(0x8b000020);\n")
make_tree(two "emit(0x8b000020);\n")
make_tree(other "emit(0x8b000021);\n")
hash_of(one first rc said)
if(NOT rc EQUAL 0)
    fail("the script failed on a tree of two files: ${said}")
endif()
string(LENGTH "${first}" length)
if(NOT length EQUAL 16)
    fail("the version is \"${first}\", not 16 hex digits")
endif()
hash_of(two second rc said)
if(NOT first STREQUAL second)
    fail("two trees of the same files hash ${first} and ${second}")
endif()
hash_of(other third rc said)
if(first STREQUAL third)
    fail("an emitter made otherwise hashes as the first tree: ${third}")
endif()
# another back end's source changed: the version changes too
file(APPEND "${WORK}/two/src/x64/x64_codegen.c" "int fixed;\n")
hash_of(two fourth rc said)
if(first STREQUAL fourth)
    fail("a back end's source changed and the version stayed ${fourth}")
endif()
# the same files again: the C file is not written (its time stays)
file(TIMESTAMP "${WORK}/one/native_code.c" before "%s" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
hash_of(one again rc said)
file(TIMESTAMP "${WORK}/one/native_code.c" after "%s" UTC)
if(NOT again STREQUAL first OR NOT before STREQUAL after)
    fail("the same files rewrote native_code.c (${before}, ${after}) or hashed ${again}")
endif()
# a file of the list that is missing: the script stops naming it
file(REMOVE "${WORK}/other/src/x64/x64_codegen.c")
hash_of(other missing rc said)
if(rc EQUAL 0)
    fail("a missing file of the list did not stop the script")
endif()
string(REGEX REPLACE "[ \t\r\n]+" " " said "${said}") # CMake wraps a message's lines
string(FIND "${said}" "x64_codegen.c, of ${WORK}/other/list.txt, is missing" at)
if(at EQUAL -1)
    fail("the script did not name the missing file: ${said}")
endif()
file(REMOVE_RECURSE "${WORK}/one" "${WORK}/two" "${WORK}/other")
if(failures)
    message(FATAL_ERROR "native_code_hash: ${failures} failures")
endif()
message(STATUS "native_code_hash: as it should be")
