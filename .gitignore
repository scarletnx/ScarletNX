# Game dumps, keys and anything extracted from them. These belong to their owners and never go in git.
*.xci
*.nsp
*.[dD][xX][cC][iI]
*.[dD][nN][sS][pP]
*.nsz
*.xcz
*.nca
*.nro
*.nso
*.npdm
*.zip
*.7z
*.rar
*.keys
*.tik
*.cert
*.cia
*.3ds
*.gba
*.gb
*.nds
*.vpk
*.apk
exefs/
romfs/
/work/
/keys/
/dumps/

# Made from the game's files: shader corpora (shader_corpus), SPIR-V dumps, screenshots, and the shader and JIT
# caches (in the user's cache folder, kept out wherever a copy lands)
*.snxs
*.spv
*.ppm
*.vkshaders
*.vkshipped
*.vkscan
*.jitcache
shader_cache/
vkshader_*.glsl

# Recompiled games: runtime, game module, generated C, data, saves, settings and logs (games/ an older version's)
/recompiled/
/games/
# The Linux runtime's default sysroot (scarletnx-gnuabi -L), and toolchains or sysroots dropped in to fill it
/linux/
/*.tar.xz
/*.tar.gz
/*.tar.zst

# Build output, and the AppImage scripts/make-appimage.sh makes
/build*/
# what ctest writes when it runs in the checkout
/Testing/
# Profiles of a running game: its memory and symbols
perf.data*
heaptrack.*
__pycache__/
*.o
*.so
*.exe
/AppDir/
/dist/*.AppImage
/dist/*.zsync
/dist/appinfo

# What patch or git apply --reject leaves behind when a hunk does not apply
*.rej

# Gradle's state and the SDK's path when dist/android is built in place (its output goes to the stage folder)
/dist/android/.gradle/
/dist/android/local.properties

# Third-party packages downloaded by CPM.cmake (cmake/dependencies.cmake), and the Windows toolchain from
# scripts/bootstrap.ps1
/.cache/
/deps/

# Claude Code state local to this checkout
.claude/audit-state.json
.claude/settings.local.json
.claude/worktrees/

edenprobe-run/

# the continuation watcher
docs/.continue.lock
docs/continue-work.log
docs/.work-stop
docs/.work-complete
